---
interface Props {
  label?: string;
  error?: string;
  helpText?: string;
  class?: string;
  type?: string;
  id?: string;
  value?: string;
  placeholder?: string;
  disabled?: boolean;
  required?: boolean;
}

const {
  label,
  error,
  helpText,
  type = 'text',
  value,
  placeholder,
  disabled = false,
  required = false,
  class: className = '',
} = Astro.props;

let { id } = Astro.props;
if (!id && label) {
  id = label.toLowerCase().replace(/\s+/g, '-');
}
---

<div class="flex flex-col gap-1.5">
  {label && <label for={id} class="text-sm font-medium text-gray-700">{label}</label>}
  <input
    id={id}
    type={type}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
    class={`w-full px-3 py-2 text-sm border rounded-md transition-colors
      bg-white placeholder:text-gray-400
      focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent
      ${error ? 'border-danger' : 'border-gray-300'}
      ${disabled ? 'bg-gray-50 text-gray-500' : ''}
      ${className}`}
  />
  {error && <p class="text-xs text-danger">{error}</p>}
  {helpText && !error && <p class="text-xs text-gray-500">{helpText}</p>}
</div>
