---
interface Props {
  label?: string;
  error?: string;
  class?: string;
  id?: string;
  value?: string;
  placeholder?: string;
  rows?: number;
}

const {
  label,
  error,
  value,
  placeholder,
  rows,
  class: className = '',
} = Astro.props;

let { id } = Astro.props;
if (!id && label) {
  id = label.toLowerCase().replace(/\s+/g, '-');
}
---

<div class="flex flex-col gap-1.5">
  {label && <label for={id} class="text-sm font-medium text-gray-700">{label}</label>}
  <textarea
    id={id}
    placeholder={placeholder}
    rows={rows || 3}
    class={`w-full px-3 py-2 text-sm border rounded-md resize-y min-h-[80px]
      focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent
      ${error ? 'border-danger' : 'border-gray-300'}
      ${className}`}
  >{value}</textarea>
  {error && <p class="text-xs text-danger">{error}</p>}
</div>
