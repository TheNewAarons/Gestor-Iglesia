---
interface Tab {
  key: string;
  label: string;
  count?: number;
  disabled?: boolean;
}

interface Props {
  tabs: Tab[];
  activeTab: string;
  id?: string;
  class?: string;
}

const { tabs, activeTab, class: className = '' } = Astro.props;
const containerId = Astro.props.id || 'tabs-container';
const uid = containerId + '-' + Math.random().toString(36).slice(2, 8);
---

<div id={uid} class={`border-b border-gray-200 ${className}`}>
  <nav class="flex gap-0 -mb-px overflow-x-auto">
    {tabs.map((tab) => (
      <button
        type="button"
        data-tab-key={tab.key}
        disabled={tab.disabled}
        class={`inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 transition-colors whitespace-nowrap
          ${activeTab === tab.key
            ? 'border-accent text-accent'
            : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}
          ${tab.disabled ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'}`}
      >
        {tab.label}
        {tab.count !== undefined && (
          <span class={`ml-1.5 px-2 py-0.5 rounded-full text-xs font-medium
            ${activeTab === tab.key ? 'bg-accent/10 text-accent' : 'bg-gray-100 text-gray-600'}`}>
            {tab.count}
          </span>
        )}
      </button>
    ))}
  </nav>
</div>

<script is:inline>
  var container = document.getElementById('{uid}');
  if (container) {
    container.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-tab-key]');
      if (!btn || btn.disabled) return;
      var key = btn.getAttribute('data-tab-key');
      if (!key) return;
      container.dispatchEvent(new CustomEvent('tab-change', { detail: { key: key }, bubbles: true }));
    });

    container.addEventListener('tab-set', function(e) {
      var key = e.detail.key;
      var buttons = container.querySelectorAll('[data-tab-key]');
      buttons.forEach(function(b) {
        var isActive = b.getAttribute('data-tab-key') === key;
        b.className = b.className
          .replace(/border-accent text-accent/g, '')
          .replace(/border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300/g, '')
          .trim();
        if (isActive) {
          b.className += ' border-accent text-accent';
        } else {
          b.className += ' border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300';
        }
        b.setAttribute('aria-selected', String(isActive));
      });
    });
  }
</script>
