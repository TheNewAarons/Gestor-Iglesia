---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-b from-gray-50 to-gray-100">
    <div class="text-center px-4">
      <div class="mb-8">
        <svg class="w-24 h-24 mx-auto text-primary opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h1 class="text-6xl font-bold text-gray-900 mb-4">404</h1>
      <p class="text-2xl font-semibold text-gray-700 mb-2">Página no encontrada</p>
      <p class="text-gray-600 mb-8 max-w-md">Lo sentimos, la página que buscas no existe o ha sido movida.</p>
      <a href="/" class="inline-flex items-center justify-center gap-2 bg-primary text-white hover:bg-primary-600 px-6 py-3 rounded-lg font-medium transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver al inicio
      </a>
    </div>
  </div>
</BaseLayout>
