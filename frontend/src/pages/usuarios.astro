</style>

<script>
  import { usuariosStore } from '../stores/usuarios';
  import { authStore } from '../stores/auth';

  let authChecked = false;
  let editandoId: number | null = null;
  let ministeriosDisponibles: { id: number; nombre: string; slug: string }[] = [];

  usuariosStore.subscribe((s) => {
    renderUsuarios(s.usuarios, s.isLoading);
    actualizarStats(s.usuarios);
  });

  authStore.subscribe((s) => {
    if (authChecked && !s.isLoading && (!s.isAuthenticated || s.user?.rol !== 'admin')) {
      window.location.href = '/login';
    }
  });

  async function init() {
    await authStore.checkAuth();
    authChecked = true;
    const authState = authStore.getState();
    
    if (!authState.isAuthenticated || authState.user?.rol !== 'admin') {
      window.location.href = '/login';
      return;
    }

    await usuariosStore.fetchUsuarios();
    await usuariosStore.fetchMinisteriosDisponibles();
    ministeriosDisponibles = usuariosStore.getState().ministeriosDisponibles;
    renderMinisteriosCheckboxes();
    setupEventListeners();
  }

  function setupEventListeners() {
    document.getElementById('btn-crear-usuario')?.addEventListener('click', () => abrirModal());
    document.getElementById('close-modal')?.addEventListener('click', cerrarModal);
    document.getElementById('cancel-form')?.addEventListener('click', cerrarModal);
    document.getElementById('usuario-modal')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) cerrarModal();
    });
    document.getElementById('usuario-form')?.addEventListener('submit', handleSubmit);

    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const tab = (e.currentTarget as HTMLElement).dataset.tab;
        cambiarTab(tab!);
      });
    });

    document.getElementById('busqueda')?.addEventListener('input', filtrarUsuarios);
    document.getElementById('filtro-rol')?.addEventListener('change', filtrarUsuarios);
    document.getElementById('filtro-estado')?.addEventListener('change', filtrarUsuarios);

    const form = document.getElementById('usuario-form') as HTMLFormElement;
    const inputFirstName = form?.querySelector('input[name="first_name"]') as HTMLInputElement;
    const inputLastName = form?.querySelector('input[name="last_name"]') as HTMLInputElement;
    const inputUsername = form?.querySelector('input[name="username"]') as HTMLInputElement;

    if (inputFirstName && inputLastName && inputUsername) {
      const generarUsername = () => {
        const nombre = (inputFirstName.value || '').trim().toLowerCase().replace(/[^a-záéíóúñ]/g, '');
        const apellido = (inputLastName.value || '').trim().toLowerCase().replace(/[^a-záéíóúñ]/g, '');
        
        if (nombre || apellido) {
          const usernameBase = `${nombre}.${apellido}`.replace(/^\.|\.$/g, '');
          inputUsername.value = usernameBase || '';
        }
      };

      inputFirstName.addEventListener('input', generarUsername);
      inputLastName.addEventListener('input', generarUsername);
    }
  }

  function actualizarStats(usuarios: any[]) {
    const total = usuarios.length;
    const activos = usuarios.filter(u => u.activo).length;
    const inactivos = total - activos;
    
    const statTotal = document.getElementById('stat-total');
    const statActivos = document.getElementById('stat-activos');
    const statInactivos = document.getElementById('stat-inactivos');
    
    if (statTotal) statTotal.textContent = total.toString();
    if (statActivos) statActivos.textContent = activos.toString();
    if (statInactivos) statInactivos.textContent = inactivos.toString();
  }

  function renderUsuarios(usuarios: any[], isLoading: boolean) {
    const tbody = document.getElementById('usuarios-tbody');
    if (!tbody) return;

    if (isLoading) {
      tbody.innerHTML = '<tr><td colspan="4" class="loading-cell">Cargando usuarios...</td></tr>';
      return;
    }

    if (!usuarios || usuarios.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" class="loading-cell">No hay usuarios registrados</td></tr>';
      return;
    }

    tbody.innerHTML = '';
    
    usuarios.forEach(u => {
      const tr = document.createElement('tr');
      tr.style.cursor = 'pointer';
      tr.onclick = () => mostrarDetalles(u.id);
      
      const getString = (val: any, fallback: string = '') => {
        if (typeof val === 'string') return val;
        if (val === null || val === undefined) return fallback;
        if (typeof val === 'object') return JSON.stringify(val);
        return String(val);
      };
      
      const firstName = getString(u.first_name);
      const lastName = getString(u.last_name);
      const username = getString(u.username);
      const nombreMostrar = (firstName && lastName) ? `${firstName} ${lastName}` : (username || 'Usuario del sistema');
      const rol = getString(u.rol);
      const rolDisplay = getString(u.rol_display) || formatearRol(rol);
      
      let ministeriosHtml = '—';
      if (u.ministerios_lidera_detalles && u.ministerios_lidera_detalles.length > 0) {
        const maxVisible = 3;
        const visible = u.ministerios_lidera_detalles.slice(0, maxVisible);
        const remaining = u.ministerios_lidera_detalles.length - maxVisible;

        ministeriosHtml = visible.map((m: any) =>
          `<span class="ministerio-tag" title="${getString(m.nombre)}">${getString(m.nombre)}</span>`
        ).join('');

        if (remaining > 0) {
          const allNames = u.ministerios_lidera_detalles.map((m: any) => getString(m.nombre)).join(', ');
          ministeriosHtml += `<span class="ministerios-more" title="${allNames}">+${remaining} más</span>`;
        }
      }
      
      tr.innerHTML = `
        <td><span class="usuario-name">${nombreMostrar}</span></td>
        <td><span class="rol-badge">${rolDisplay}</span></td>
        <td><div class="ministerios-cell">${ministeriosHtml}</div></td>
        <td>
          <div class="acciones-cell">
            <button class="btn-action" onclick="event.stopPropagation(); editarUsuario(${u.id})" title="Editar">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            </button>
            <button class="btn-action" onclick="event.stopPropagation(); eliminarUsuario(${u.id})" title="Eliminar">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </button>
          </div>
        </td>
      `;
      
      tbody.appendChild(tr);
    });
  }

  function getIniciales(nombre: string, apellido: string): string {
    const inicialNombre = (nombre && nombre.trim()) ? nombre.trim()[0].toUpperCase() : '';
    const inicialApellido = (apellido && apellido.trim()) ? apellido.trim()[0].toUpperCase() : '';
    return `${inicialNombre}${inicialApellido}` || '?';
  }

  function formatearRol(rol: string): string {
    const roles: Record<string, string> = {
      admin: 'Admin',
      pastora: 'Pastora',
      secretaria: 'Secretaria',
      tesorera: 'Tesorera',
      lider_ministerio: 'Líder',
      concilio: 'Concilio'
    };
    return roles[rol] || rol;
  }

  function formatFecha(fecha: string): string {
    const date = new Date(fecha);
    return date.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function renderMinisteriosCheckboxes() {
    const container = document.getElementById('ministerios-list');
    if (!container) return;

    container.innerHTML = ministeriosDisponibles.map(m => `
      <label class="ministerio-checkbox">
        <input type="checkbox" name="ministerios_lidera" value="${m.id}" />
        ${m.nombre}
      </label>
    `).join('');
  }

  function abrirModal(usuario?: any) {
    const modal = document.getElementById('usuario-modal');
    const title = document.getElementById('modal-title');
    const form = document.getElementById('usuario-form') as HTMLFormElement;
    const passwordInput = document.getElementById('password-input') as HTMLInputElement;

    if (!modal || !title || !form) return;

    if (usuario) {
      editandoId = usuario.id;
      title.textContent = 'Editar Usuario';
      passwordInput.required = false;
      passwordInput.placeholder = 'Dejar vacío para mantener';
      
      (form.username as any).value = usuario.username;
      (form.first_name as any).value = usuario.first_name;
      (form.last_name as any).value = usuario.last_name;
      (form.email as any).value = usuario.email;
      (form.telefono as any).value = usuario.telefono || '';
      
      const rolRadio = form.querySelector(`input[name="rol"][value="${usuario.rol}"]`) as HTMLInputElement;
      if (rolRadio) rolRadio.checked = true;
      
      (form.activo as any).checked = usuario.activo;

      document.querySelectorAll('input[name="ministerios_lidera"]').forEach((cb: any) => {
        cb.checked = usuario.ministerios_lidera?.includes(parseInt(cb.value));
      });
    } else {
      editandoId = null;
      title.textContent = 'Nuevo Usuario';
      passwordInput.required = true;
      passwordInput.placeholder = 'Mínimo 8 caracteres';
      form.reset();
      
      const rolRadio = form.querySelector('input[name="rol"][value="concilio"]') as HTMLInputElement;
      if (rolRadio) rolRadio.checked = true;
    }

    modal.classList.add('open');
    cambiarTab('datos');
  }

  function cerrarModal() {
    const modal = document.getElementById('usuario-modal');
    if (modal) modal.classList.remove('open');
    editandoId = null;
  }

  function cambiarTab(tab: string) {
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
    
    document.querySelector(`.tab-btn[data-tab="${tab}"]`)?.classList.add('active');
    document.getElementById(`tab-${tab}`)?.classList.add('active');
  }

  async function handleSubmit(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);

    const firstName = (formData.get('first_name') as string || '').trim().toLowerCase().replace(/[^a-záéíóúñ]/g, '');
    const lastName = (formData.get('last_name') as string || '').trim().toLowerCase().replace(/[^a-záéíóúñ]/g, '');
    const username = `${firstName}.${lastName}`.replace(/^\.|\.$/g, '');

    const rolSeleccionado = form.querySelector('input[name="rol"]:checked') as HTMLInputElement;

    const data: any = {
      username: username,
      first_name: formData.get('first_name'),
      last_name: formData.get('last_name'),
      email: formData.get('email'),
      telefono: formData.get('telefono'),
      rol: rolSeleccionado?.value || 'concilio',
      activo: formData.get('activo') === 'on',
      ministerios_lidera: Array.from(document.querySelectorAll('input[name="ministerios_lidera"]:checked')).map((cb: any) => parseInt(cb.value)),
    };

    if (editandoId) {
      const passwordNueva = formData.get('password');
      if (passwordNueva) {
        data.password_nueva = passwordNueva;
      }
      await usuariosStore.updateUsuario(editandoId, data);
    } else {
      data.password = formData.get('password');
      data.password_confirm = formData.get('password_confirm');
      await usuariosStore.createUsuario(data);
    }

    cerrarModal();
    await usuariosStore.fetchUsuarios();
  }

  function filtrarUsuarios() {
    const busqueda = (document.getElementById('busqueda') as HTMLInputElement).value.toLowerCase();
    const rol = (document.getElementById('filtro-rol') as HTMLSelectElement).value;
    const estado = (document.getElementById('filtro-estado') as HTMLSelectElement).value;

    let usuarios = usuariosStore.getState().usuarios;

    if (busqueda) {
      usuarios = usuarios.filter(u => 
        u.first_name.toLowerCase().includes(busqueda) ||
        u.last_name.toLowerCase().includes(busqueda) ||
        u.username.toLowerCase().includes(busqueda) ||
        u.email.toLowerCase().includes(busqueda)
      );
    }

    if (rol) {
      usuarios = usuarios.filter(u => u.rol === rol);
    }

    if (estado) {
      usuarios = usuarios.filter(u => u.activo === (estado === 'true'));
    }

    renderUsuarios(usuarios, false);
    actualizarStats(usuarios);
  }

  (window as any).editarUsuario = async function(id: number) {
    const usuario = usuariosStore.getState().usuarios.find(u => u.id === id);
    if (usuario) {
      abrirModal(usuario);
    }
  };

  (window as any).eliminarUsuario = async function(id: number) {
    if (confirm('¿Estás seguro de que deseas eliminar este usuario?')) {
      try {
        await usuariosStore.deleteUsuario(id);
        await usuariosStore.fetchUsuarios();
      } catch (error) {
        alert('Error al eliminar usuario');
      }
    }
  };

  (window as any).mostrarDetalles = function(id: number) {
    const usuario = usuariosStore.getState().usuarios.find(u => u.id === id);
    if (!usuario) return;

    const getVal = (v: any) => (v !== null && v !== undefined) ? String(v) : '';
    const panel = document.getElementById('detalles-panel');
    const content = document.getElementById('detalles-content');

    const iniciales = `${getVal(usuario.first_name).charAt(0)}${getVal(usuario.last_name).charAt(0)}`.toUpperCase() || '??';
    const nombreCompleto = `${getVal(usuario.first_name)} ${getVal(usuario.last_name)}`.trim() || getVal(usuario.username);

    content.innerHTML = `
      <div class="detalle-header" data-astro-cid-bcnrsapi>
        <div class="detalle-avatar-wrapper" data-astro-cid-bcnrsapi>
          <div class="detalle-avatar" data-astro-cid-bcnrsapi>${iniciales}</div>
          <div class="detalle-status ${usuario.activo ? 'activo' : 'inactivo'}" data-astro-cid-bcnrsapi></div>
        </div>
        <div class="detalle-nombre" data-astro-cid-bcnrsapi>${nombreCompleto}</div>
        <div class="detalle-username" data-astro-cid-bcnrsapi>@${getVal(usuario.username)}</div>
        <span class="detalle-rol-badge ${getVal(usuario.rol)}" data-astro-cid-bcnrsapi>${getVal(usuario.rol_display) || formatearRol(getVal(usuario.rol))}</span>
      </div>

      <div class="detalle-body" data-astro-cid-bcnrsapi>
        <div class="detalle-seccion" data-astro-cid-bcnrsapi>
          <div class="detalle-seccion-header" data-astro-cid-bcnrsapi>
            <svg data-astro-cid-bcnrsapi xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span data-astro-cid-bcnrsapi>Contacto</span>
          </div>
          <div class="detalle-info-grid" data-astro-cid-bcnrsapi>
            ${getVal(usuario.email) ? `
            <div class="detalle-info-item" data-astro-cid-bcnrsapi>
              <span class="detalle-info-label" data-astro-cid-bcnrsapi>Email</span>
              <span class="detalle-info-value" data-astro-cid-bcnrsapi>${getVal(usuario.email)}</span>
            </div>
            ` : ''}
            ${getVal(usuario.telefono) ? `
            <div class="detalle-info-item" data-astro-cid-bcnrsapi>
              <span class="detalle-info-label" data-astro-cid-bcnrsapi>Teléfono</span>
              <span class="detalle-info-value" data-astro-cid-bcnrsapi>${getVal(usuario.telefono)}</span>
            </div>
            ` : ''}
          </div>
        </div>

        <div class="detalle-seccion" data-astro-cid-bcnrsapi>
          <div class="detalle-seccion-header" data-astro-cid-bcnrsapi>
            <svg data-astro-cid-bcnrsapi xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span data-astro-cid-bcnrsapi>Información</span>
          </div>
          <div class="detalle-info-grid" data-astro-cid-bcnrsapi>
            <div class="detalle-info-item" data-astro-cid-bcnrsapi>
              <span class="detalle-info-label" data-astro-cid-bcnrsapi>Estado</span>
              <span class="detalle-info-value ${usuario.activo ? 'text-success' : 'text-danger'}" data-astro-cid-bcnrsapi>
                <span class="detalle-status-dot ${usuario.activo ? 'activo' : 'inactivo'}" data-astro-cid-bcnrsapi></span>
                ${usuario.activo ? 'Activo' : 'Inactivo'}
              </span>
            </div>
            <div class="detalle-info-item" data-astro-cid-bcnrsapi>
              <span class="detalle-info-label" data-astro-cid-bcnrsapi>Último acceso</span>
              <span class="detalle-info-value" data-astro-cid-bcnrsapi>${usuario.ultimo_login ? formatFecha(usuario.ultimo_login) : 'Nunca'}</span>
            </div>
            <div class="detalle-info-item" data-astro-cid-bcnrsapi>
              <span class="detalle-info-label" data-astro-cid-bcnrsapi>Fecha de registro</span>
              <span class="detalle-info-value" data-astro-cid-bcnrsapi>${formatFecha(usuario.fecha_creacion)}</span>
            </div>
          </div>
        </div>

        ${usuario.ministerios_lidera_detalles?.length ? `
        <div class="detalle-seccion" data-astro-cid-bcnrsapi>
          <div class="detalle-seccion-header" data-astro-cid-bcnrsapi>
            <svg data-astro-cid-bcnrsapi xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <span data-astro-cid-bcnrsapi>Ministerios que lidera</span>
          </div>
          <div class="detalle-ministerios" data-astro-cid-bcnrsapi>
            ${usuario.ministerios_lidera_detalles.map((m: any) => `
              <div class="detalle-ministerio-chip" data-astro-cid-bcnrsapi>
                <span class="detalle-ministerio-icon" data-astro-cid-bcnrsapi>${m.nombre.charAt(0)}</span>
                <span class="detalle-ministerio-nombre" data-astro-cid-bcnrsapi>${m.nombre}</span>
              </div>
            `).join('')}
          </div>
        </div>
        ` : ''}
      </div>

      <div class="detalle-footer" data-astro-cid-bcnrsapi>
        <button class="btn-edit" data-astro-cid-bcnrsapi onclick="editarUsuario(${usuario.id})">
          <svg data-astro-cid-bcnrsapi xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
          Editar usuario
        </button>
      </div>
    `;

    panel?.classList.add('open');
  };

  (window as any).cerrarDetalles = function() {
    const panel = document.getElementById('detalles-panel');
    panel?.classList.remove('open');
  };

  init();
</script>