---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Gestión de Usuarios">
  <div class="usuarios-page">
    <div class="stats-bar">
      <div class="stat-card">
        <div class="stat-icon total">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
        <div class="stat-info">
          <span class="stat-value" id="stat-total">0</span>
          <span class="stat-label">Total Usuarios</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon activos">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <div class="stat-info">
          <span class="stat-value" id="stat-activos">0</span>
          <span class="stat-label">Activos</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon inactivos">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
        </div>
        <div class="stat-info">
          <span class="stat-value" id="stat-inactivos">0</span>
          <span class="stat-label">Inactivos</span>
        </div>
      </div>
    </div>

    <div class="toolbar">
      <div class="search-box">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="busqueda" placeholder="Buscar por nombre, usuario o email..." />
      </div>
      <div class="filters-group">
        <select id="filtro-rol" class="filter-select">
          <option value="">Todos los roles</option>
          <option value="admin">Admin</option>
          <option value="pastora">Pastora</option>
          <option value="secretaria">Secretaria</option>
          <option value="tesorera">Tesorera</option>
          <option value="lider_ministerio">Líder de Ministerio</option>
          <option value="concilio">Concilio</option>
        </select>
        <select id="filtro-estado" class="filter-select">
          <option value="">Todos los estados</option>
          <option value="true">Activos</option>
          <option value="false">Inactivos</option>
        </select>
        <button class="btn-primary" id="btn-crear-usuario">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Nuevo Usuario
        </button>
      </div>
    </div>

    <div class="table-container">
      <table class="usuarios-table">
        <thead>
          <tr>
            <th>Usuario</th>
            <th>Rol</th>
            <th>Ministerios</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="usuarios-tbody">
          <tr>
            <td colspan="4" class="loading-cell">Cargando usuarios...</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="detalles-panel" id="detalles-panel">
      <div class="detalles-header">
        <h3>Detalles del Usuario</h3>
        <button class="close-detalles" onclick="cerrarDetalles()">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="detalles-content" id="detalles-content"></div>
    </div>
  </div>

  <div class="modal-overlay" id="usuario-modal">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <h2 id="modal-title">Nuevo Usuario</h2>
        </div>
        <button class="close-btn" id="close-modal">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <form id="usuario-form">
        <div class="form-tabs">
          <button type="button" class="tab-btn active" data-tab="datos">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            Datos Personales
          </button>
          <button type="button" class="tab-btn" data-tab="rol">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            Rol y Permisos
          </button>
        </div>
        
        <div class="tab-content active" id="tab-datos">
          <div class="form-section">
            <div class="form-row">
              
            </div>
            <div class="form-row two-cols">
              <div class="form-group">
                <label class="label">Nombre *</label>
                <input type="text" name="first_name" class="input" required placeholder="Primer nombre" />
              </div>
              <div class="form-group">
                <label class="label">Apellido *</label>
                <input type="text" name="last_name" class="input" required placeholder="Apellido" />
              </div>
            </div>
            <div class="form-group">
              <label class="label">Email *</label>
              <div class="input-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                <input type="email" name="email" class="input" required placeholder="correo@ejemplo.com" />
              </div>
            </div>
            <div class="form-row two-cols">
              <div class="form-group">
                <label class="label">Contraseña *</label>
                <input type="password" name="password" class="input" id="password-input" placeholder="Mínimo 8 caracteres" />
              </div>
              <div class="form-group">
                <label class="label">Confirmar *</label>
                <input type="password" name="password_confirm" class="input" placeholder="Repite la contraseña" />
              </div>
            </div>
            <div class="form-group">
              <label class="label">Teléfono</label>
              <div class="input-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                <input type="text" name="telefono" class="input" placeholder="Número de teléfono" />
              </div>
            </div>
          </div>
        </div>

        <div class="tab-content" id="tab-rol">
          <div class="form-section">
            <div class="form-group">
              <label class="label">Rol del Usuario</label>
              <div class="rol-selector">
                <label class="rol-option">
                  <input type="radio" name="rol" value="admin" />
                  <div class="rol-card">
                    <span class="rol-icon admin">👑</span>
                    <div class="rol-info">
                      <span class="rol-name">Administrador</span>
                      <span class="rol-desc">Acceso total al sistema</span>
                    </div>
                  </div>
                </label>
                <label class="rol-option">
                  <input type="radio" name="rol" value="pastora" />
                  <div class="rol-card">
                    <span class="rol-icon pastora">✝️</span>
                    <div class="rol-info">
                      <span class="rol-name">Pastora</span>
                      <span class="rol-desc">Gestión pastoral completa</span>
                    </div>
                  </div>
                </label>
                <label class="rol-option">
                  <input type="radio" name="rol" value="secretaria" />
                  <div class="rol-card">
                    <span class="rol-icon secretaria">📋</span>
                    <div class="rol-info">
                      <span class="rol-name">Secretaria</span>
                      <span class="rol-desc">Membresía y registros</span>
                    </div>
                  </div>
                </label>
                <label class="rol-option">
                  <input type="radio" name="rol" value="tesorera" />
                  <div class="rol-card">
                    <span class="rol-icon tesorera">💰</span>
                    <div class="rol-info">
                      <span class="rol-name">Tesorera</span>
                      <span class="rol-desc">Gestión financiera</span>
                    </div>
                  </div>
                </label>
                <label class="rol-option">
                  <input type="radio" name="rol" value="lider_ministerio" />
                  <div class="rol-card">
                    <span class="rol-icon lider">👥</span>
                    <div class="rol-info">
                      <span class="rol-name">Líder de Ministerio</span>
                      <span class="rol-desc">Solo su ministry</span>
                    </div>
                  </div>
                </label>
                <label class="rol-option">
                  <input type="radio" name="rol" value="concilio" />
                  <div class="rol-card">
                    <span class="rol-icon concilio">🛡️</span>
                    <div class="rol-info">
                      <span class="rol-name">Concilio</span>
                      <span class="rol-desc">Vista general</span>
                    </div>
                  </div>
                </label>
              </div>
            </div>
            <div class="form-group" id="ministerios-group">
              <label class="label">Ministerios que lidera</label>
              <p class="help-text">Selecciona los ministerios que este usuario podrá administrar</p>
              <div class="ministerios-grid" id="ministerios-list"></div>
            </div>
            <div class="form-group">
              <label class="label">Estado</label>
              <div class="toggle-wrapper">
                <label class="toggle">
                  <input type="checkbox" name="activo" checked />
                  <span class="toggle-slider"></span>
                </label>
                <span class="toggle-label">Usuario activo</span>
              </div>
            </div>
          </div>
        </div>

        <div class="form-actions">
          <button type="button" class="btn-secondary" id="cancel-form">Cancelar</button>
          <button type="submit" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            Guardar Usuario
          </button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<style>
  .usuarios-page {
    padding: 1.5rem;
  }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .stat-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-icon.total {
    background: linear-gradient(135deg, #6366F1, #8B5CF6);
    color: white;
  }

  .stat-icon.activos {
    background: linear-gradient(135deg, #10B981, #34D399);
    color: white;
  }

  .stat-icon.inactivos {
    background: linear-gradient(135deg, #F59E0B, #FBBF24);
    color: white;
  }

  .stat-info {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    max-width: 400px;
    padding: 0.625rem 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .search-box svg {
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }

  .search-box input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 0.875rem;
    background: transparent;
  }

  .filters-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .filter-select {
    padding: 0.625rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-size: 0.875rem;
    background: var(--color-bg);
    cursor: pointer;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: linear-gradient(135deg, #6366F1, #8B5CF6);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: var(--color-border);
    color: var(--color-text);
    border: none;
    border-radius: 8px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    background: var(--color-border-hover);
  }

  .table-container {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .usuarios-table {
    width: 100%;
    border-collapse: collapse;
  }

  .usuarios-table th {
    padding: 1rem;
    text-align: left;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    background: #F9FAFB;
    border-bottom: 2px solid var(--color-border);
  }

  .usuarios-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .usuarios-table tbody tr:hover td {
    background: #F9FAFB;
  }

  .usuario-name {
    font-weight: 500;
  }

  .rol-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .ministerios-cell {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ministerio-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.6rem;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 500;
    color: #475569;
    max-width: 100px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: default;
  }

  .ministerio-tag:hover {
    background: #E2E8F0;
    border-color: #CBD5E1;
  }

  .ministerios-more {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    background: #EEF2FF;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #6366F1;
    cursor: default;
  }

  .acciones-cell {
    display: flex;
    gap: 0.5rem;
  }

  .btn-action {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
  }

  .btn-action:hover {
    background: var(--color-border);
  }

  .loading-cell {
    text-align: center;
    padding: 2rem;
    color: var(--color-text-secondary);
  }

.detalles-panel {
    display: none;
    position: fixed;
    top: 0;
    right: -400px;
    width: 380px;
    height: 100vh;
    background: white;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.1);
    z-index: 50;
    transition: right 0.3s ease;
    overflow-y: auto;
  }

  .detalles-panel.open {
    display: block;
    right: 0;
  }

  .detalles-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #E2E8F0;
    background: #F8FAFC;
    position: sticky;
    top: 0;
  }

  .detalles-header h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: #1E293B;
  }

  .close-detalles {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #64748B;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .close-detalles:hover {
    background: #E2E8F0;
    color: #1E293B;
  }

  .detalles-content {
    padding: 0;
  }

.detalle-seccion {
    margin-bottom: 0;
  }

  .detalle-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2.5rem 1.5rem 2rem;
    background: linear-gradient(135deg, #6366F1, #8B5CF6);
    color: white;
    text-align: center;
    position: relative;
  }

  .detalle-avatar-wrapper {
    position: relative;
    margin-bottom: 0.75rem;
  }

  .detalle-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 700;
    border: 4px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(4px);
  }

  .detalle-status {
    position: absolute;
    bottom: 4px;
    right: 4px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.4);
  }

  .detalle-status.activo { background: #10B981; }
  .detalle-status.inactivo { background: #EF4444; }

  .detalle-body {
    padding: 1.5rem;
  }

  .detalle-seccion-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #E2E8F0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748B;
  }

  .detalle-seccion-header svg {
    color: #6366F1;
  }

  .detalle-info-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .detalle-info-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
  }

  .detalle-info-label {
    font-size: 0.85rem;
    color: #64748B;
  }

  .detalle-info-value {
    font-size: 0.85rem;
    color: #1E293B;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .detalle-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  .detalle-status-dot.activo { background: #10B981; }
  .detalle-status-dot.inactivo { background: #EF4444; }

  .text-success { color: #10B981; }
  .text-danger { color: #EF4444; }

  .detalle-ministerios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .detalle-ministerio-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: #F1F5F9;
    border-radius: 8px;
    border: 1px solid #E2E8F0;
    transition: all 0.2s ease;
  }

  .detalle-ministerio-chip:hover {
    background: #E2E8F0;
    border-color: #CBD5E1;
  }

  .detalle-ministerio-icon {
