            <span class="list-item-title">${p.titulo}</span>
            <span class="list-item-subtitle">${formatDate(p.fecha_planificada)}${p.hora ? ' ' + p.hora : ''} • ${p.ubicacion || 'Sin ubicación'}</span>
            <span class="list-item-subtitle">${p.descripcion || ''}</span>
          </div>
          <div class="list-item-meta">
            <span class="badge badge-${getEstadoPlanificacionColor(p.estado)}">${p.estado}</span>
            ${p.tipo === 'compartida' ? '<span class="badge badge-info">Compartida</span>' : ''}
            <select class="input" onchange="cambiarEstadoPlanificacion(${p.id}, this.value)" style="padding: 0.25rem; font-size: 0.75rem;">
              <option value="">Cambiar estado</option>
              <option value="planificada">Planificada</option>
              <option value="en_proceso">En Proceso</option>
              <option value="completada">Completada</option>
              <option value="cancelada">Cancelada</option>
            </select>
          </div>
        </div>
      `).join('')
      : '<div class="empty-state"><p>No hay planificaciones registradas</p></div>';

    tab.innerHTML = `
      <div class="section">
        <div class="section-header">
          <h3 class="section-title">Planificación de Actividades</h3>
          <button class="btn btn-primary" onclick="openModal('planificacion')">Nueva Planificación</button>
        </div>
        ${filterEstado}
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value">${planificaciones.filter(p => p.estado === 'planificada').length}</div>
            <div class="stat-label">Planificadas</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">${planificaciones.filter(p => p.estado === 'en_proceso').length}</div>
            <div class="stat-label">En Proceso</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">${planificaciones.filter(p => p.estado === 'completada').length}</div>
            <div class="stat-label">Completadas</div>
          </div>
        </div>
      </div>
      <div class="section">
        <div class="card-list">${rows}</div>
      </div>
    `;
  }

  function getEstadoPlanificacionColor(estado: string): string {
    const colors: Record<string, string> = { planificada: 'info', en_proceso: 'warning', completada: 'success', cancelada: 'danger' };
    return colors[estado] || 'secondary';
  }

  (window as any).filterPlanificacionesByEstado = function(estado: string) {
    const url = estado ? `/ministerios/${slug}/planificaciones/?estado=${estado}` : `/ministerios/${slug}/planificaciones/`;
    fetch(url).then(res => res.json()).then(data => renderPlanificaciones(data));
  };

  (window as any).cambiarEstadoPlanificacion = async function(id: number, estado: string) {
    if (!estado) return;
    try {
      await fetch(`/api/ministerios/${slug}/planificaciones/${id}/`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ estado })
      });
      ministeriosStore.fetchPlanificaciones(slug);
    } catch (error) {
      alert('Error al cambiar estado');
    }
  };

  function getCategoriaColor(categoria: string): string {
    const colors: Record<string, string> = { rapida: 'success', media: 'warning', lenta: 'info' };
    return colors[categoria] || 'secondary';
  }

  function getTipoRecursoColor(tipo: string): string {
    const colors: Record<string, string> = { colorimetria: 'info', plantilla: 'warning', imagen: 'success', video: 'danger', logo: 'secondary', documento: 'info' };
    return colors[tipo] || 'secondary';
  }

  function getPrioridadColor(prioridad: string): string {
    const colors: Record<string, string> = { alta: 'danger', media: 'warning', baja: 'info' };
    return colors[prioridad] || 'secondary';
  }

  function formatCurrency(amount: number): string {
    return new Intl.NumberFormat('es-PY', { style: 'currency', currency: 'PYG', minimumFractionDigits: 0 }).format(amount);
  }

  function formatDate(dateStr: string): string {
    return new Date(dateStr).toLocaleDateString('es-PY', { weekday: 'short', day: 'numeric', month: 'short' });
  }

  function formatDateTime(dateStr: string): string {
    return new Date(dateStr).toLocaleString('es-PY', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  }

  function getBadgeColor(rol: string): string {
    const colors: Record<string, string> = { lider: 'success', sublider: 'info', tesorero: 'warning', secretaria: 'info', miembro: 'secondary' };
    return colors[rol] || 'secondary';
  }

  function getEstadoColor(estado: string): string {
    const colors: Record<string, string> = { nuevo: 'success', bueno: 'info', regular: 'warning', mal_estado: 'danger' };
    return colors[estado] || 'secondary';
  }

  (window as any).openModal = function(type: string) {
    const modal = document.getElementById('form-modal');
    const content = document.getElementById('form-modal-content');
    if (!modal || !content) return;

    let html = `<div class="form-modal-header">
      <h3 class="form-modal-title">${getModalTitle(type)}</h3>
      <button class="close-btn" onclick="closeModal()">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <form id="modal-form">${getModalFields(type)}<div class="form-actions">
      <button type="button" class="btn btn-outline" onclick="closeModal()">Cancelar</button>
      <button type="submit" class="btn btn-primary">Guardar</button>
    </div></form>`;

    content.innerHTML = html;
    modal.classList.add('open');

    if (type === 'miembro' && slug === 'dni') {
      const claseField = document.getElementById('clase-field');
      if (claseField) claseField.style.display = 'block';
    }

    if (type === 'ofrenda' && slug === 'dni') {
      const claseField = document.getElementById('ofrenda-clase-field');
      if (claseField) claseField.style.display = 'block';
    }

    if (type === 'asistencia') {
      setTimeout(() => {
        const select = document.querySelector('select[name="es_visita"]') as HTMLSelectElement;
        if (select) {
          select.addEventListener('change', (e: any) => {
            const visitaField = document.getElementById('visita-field');
            const miembroField = document.getElementById('miembro-field');
            if (e.target.value === 'true') {
              if (visitaField) visitaField.style.display = 'block';
              if (miembroField) miembroField.style.display = 'none';
            } else {
              if (visitaField) visitaField.style.display = 'none';
              if (miembroField) miembroField.style.display = 'block';
            }
          });
        }
      }, 100);
    }

    document.getElementById('modal-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      await handleFormSubmit(type);
    });
  };

