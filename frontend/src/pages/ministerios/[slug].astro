      await ministeriosStore.toggleIdeaCompletada(id, completada);
      ministeriosStore.fetchIdeas(slug!);
    } catch (error) {
      alert('Error al actualizar idea');
    }
  };

  (window as any).generarPrograma = async function() {
    const fecha = prompt('Ingrese la fecha del programa (YYYY-MM-DD):');
    if (!fecha) return;
    try {
      await ministeriosStore.generarPrograma(fecha, slug!);
      ministeriosStore.fetchProgramas(slug);
      alert('Programa generado exitosamente');
    } catch (error) {
      alert('Error al generar programa');
    }
  };

  async function handleFormSubmit(type: string) {
    const form = document.getElementById('modal-form') as HTMLFormElement;
    const formData = new FormData(form);
    const data: any = {};

    for (const [key, value] of formData.entries()) {
      data[key] = value;
    }

    if (data.monto) data.monto = parseFloat(data.monto);
    if (data.cantidad) data.cantidad = parseInt(data.cantidad);
    if (data.presente) data.presente = data.presente === 'true';
    if (data.es_visita) data.es_visita = data.es_visita === 'true';

    try {
      switch(type) {
        case 'miembro':
          await ministeriosStore.addMiembro(slug!, data);
          ministeriosStore.fetchMiembros(slug!);
          break;
        case 'movimiento':
          await ministeriosStore.addMovimiento(slug!, data);
          ministeriosStore.fetchCaja(slug!);
          break;
        case 'inventario':
          await ministeriosStore.addInventarioItem(slug!, data);
          ministeriosStore.fetchInventario(slug!);
          break;
        case 'ofrenda':
          await ministeriosStore.addOfrenda(slug!, data);
          ministeriosStore.fetchOfrendas(slug!);
          break;
        case 'evento':
          await ministeriosStore.addEvento(slug!, data);
          ministeriosStore.fetchEventos(slug!);
          break;
        case 'asistencia':
          await ministeriosStore.addAsistencia(slug!, data);
          ministeriosStore.fetchAsistencia(slug!);
          break;
        case 'leccion':
          await ministeriosStore.addLeccion(data);
          ministeriosStore.fetchLecciones();
          break;
        case 'cancion':
          await ministeriosStore.addCancion(data);
          ministeriosStore.fetchCanciones();
          break;
        case 'recurso':
          await ministeriosStore.addRecurso(data);
          ministeriosStore.fetchRecursos(slug!);
          break;
        case 'idea':
          await ministeriosStore.addIdea(data);
          ministeriosStore.fetchIdeas(slug!);
          break;
        case 'planificacion':
          if (data.presupuesto) data.presupuesto = parseFloat(data.presupuesto);
          await ministeriosStore.addPlanificacion(slug!, data);
          ministeriosStore.fetchPlanificaciones(slug!);
          break;
      }
      closeModal();
    } catch (error) {
      alert('Error al guardar: ' + (error instanceof Error ? error.message : 'Error desconocido'));
    }
  }

  (window as any).closeModal = function() {
    const modal = document.getElementById('form-modal');
    if (modal) modal.classList.remove('open');
  };

  document.addEventListener('click', (e) => {
    const modal = document.getElementById('form-modal');
    if (modal?.classList.contains('open') && e.target === modal) {
      modal.classList.remove('open');
    }
  });
</script>

