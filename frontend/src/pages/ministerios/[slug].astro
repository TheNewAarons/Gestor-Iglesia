---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import MinistryPage from '../../islands/ministry/MinistryPage.astro';

export function getStaticPaths() {
  const ministerios = [
    'mni', 'dni', 'jni', 'mam', 'vid', 'explo',
    'danza', 'teatro', 'alabanza', 'comunicaciones',
    'compasion', 'nazakids', 'adulto-mayor'
  ];
  return ministerios.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;

const ministryTabs: Record<string, string[]> = {
  mni: ['dashboard', 'miembros', 'enfoques', 'programa', 'ofrendas', 'caja', 'inventario', 'planificacion', 'notas', 'eventos'],
  dni: ['dashboard', 'miembros', 'asistencia', 'caja', 'inventario', 'ofrendas', 'cumpleanos', 'biblias', 'notas', 'eventos'],
  explo: ['dashboard', 'miembros', 'lecciones', 'planificacion', 'caja', 'inventario', 'notas', 'eventos'],
  alabanza: ['dashboard', 'miembros', 'canciones', 'programas', 'planificacion', 'caja', 'notas', 'eventos'],
  comunicaciones: ['dashboard', 'miembros', 'recursos', 'ideas', 'planificacion', 'caja', 'notas', 'eventos'],
  default: ['dashboard', 'miembros', 'planificacion', 'caja', 'inventario', 'ofrendas', 'notas', 'eventos']
};

const tabs = ministryTabs[slug || ''] || ministryTabs.default;
---

<DashboardLayout title="Ministerio" showBack={true}>
  <MinistryPage slug={slug!} tabs={tabs} />
</DashboardLayout>
