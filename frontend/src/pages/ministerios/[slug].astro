  function renderAsistencia(asistencia: any[]) {
    const tab = document.getElementById('tab-asistencia');
    if (!tab) return;

    const isDNI = slug === 'dni';
    const mesActual = new Date().getMonth() + 1;
    const anioActual = new Date().getFullYear();

    const totalPresentes = asistencia.filter(a => a.presente && !a.es_visita).length;
    const totalVisitas = asistencia.filter(a => a.es_visita).length;
    const totalBiblias = asistencia.filter(a => a.tiene_biblia).length;

    const filterClase = isDNI ? `
      <div class="form-group" style="margin-bottom: 1rem;">
        <select class="input" onchange="filterAsistenciaByClase(this.value)" style="max-width: 200px;">
          <option value="">Todas las clases</option>
          <option value="ninos">Niños (0-12)</option>
          <option value="jovenes">Jóvenes (13-17)</option>
          <option value="adultos_jovenes">Adultos Jóvenes (18-35)</option>
          <option value="adultos">Adultos (36-60)</option>
          <option value="adultos_mayores">Adultos Mayores (60+)</option>
        </select>
      </div>
    ` : '';

    const filterFecha = isDNI ? `
      <div class="form-group" style="margin-bottom: 1rem;">
        <input type="date" class="input" onchange="filterAsistenciaByFecha(this.value)" style="max-width: 200px;" />
      </div>
    ` : '';

    const rows = asistencia.length
      ? asistencia.map(a => `
        <tr>
          <td>${a.es_visita ? a.nombre_visita : a.miembro_nombre || 'N/A'}</td>
          <td>${a.clase ? getClaseLabel(a.clase) : '-'}</td>
          <td>${formatDate(a.fecha)}</td>
          <td>${a.presente ? '<span class="badge badge-success">Presente</span>' : '<span class="badge badge-danger">Ausente</span>'}</td>
          <td>${a.tiene_biblia ? '<span class="badge badge-info">Biblia</span>' : '-'}</td>
          ${a.es_visita ? '<td><span class="badge badge-warning">Visita</span></td>' : '<td>-</td>'}
        </tr>
      `).join('')
      : '<tr><td colspan="6" class="empty-state">No hay registros de asistencia</td></tr>';

    const historialDOM = isDNI ? `
      <div class="asistencia-tabs" style="display: flex; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 1px solid var(--color-border-light);">
        <button class="tab-btn active" onclick="switchAsistenciaView('registro')" id="btn-asistencia-registro">Registro</button>
        <button class="tab-btn" onclick="switchAsistenciaView('resumen')" id="btn-asistencia-resumen">Resumen por Domingo</button>
        <button class="tab-btn" onclick="switchAsistenciaView('acumulativa')" id="btn-asistencia-acumulativa">Acumulativa</button>
      </div>
      <div id="asistencia-view-registro">
        ${filterClase}
        ${filterFecha}
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Clase</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Biblia</th>
                <th>Tipo</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        </div>
      </div>
      <div id="asistencia-view-resumen" style="display: none;">
        <p style="color: var(--color-text-secondary); margin-bottom: 1rem;">Cargando resumen...</p>
      </div>
      <div id="asistencia-view-acumulativa" style="display: none;">
        <p style="color: var(--color-text-secondary); margin-bottom: 1rem;">Cargando acumulado...</p>
      </div>
    ` : `<div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Clase</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Tipo</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
    </div>`;

    tab.innerHTML = `
      <div class="section">
        <div class="section-header">
          <h3 class="section-title">${isDNI ? 'Control de Asistencia DNI' : 'Registro de Asistencia'}</h3>
          <button class="btn btn-primary" onclick="openModal('asistencia')">Registrar Asistencia</button>
        </div>
        ${isDNI ? `
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value">${totalPresentes}</div>
            <div class="stat-label">Miembros Presentes</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">${totalVisitas}</div>
            <div class="stat-label">Visitas</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">${totalBiblias}</div>
            <div class="stat-label">Con Biblia</div>
          </div>
        </div>
        ` : `
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value">${asistencia.filter(a => a.presente).length}</div>
            <div class="stat-label">Presentes</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">${asistencia.filter(a => !a.presente).length}</div>
            <div class="stat-label">Ausentes</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">${asistencia.filter(a => a.es_visita).length}</div>
            <div class="stat-label">Visitas</div>
          </div>
        </div>
        `}
      </div>
      <div class="section">
        <div class="section-header">
          <h3 class="section-title">Historial${isDNI ? '' : ' Reciente'}</h3>
        </div>
        ${historialDOM}
      </div>
    `;

    if (isDNI) {
      loadAsistenciaResumenDNI(mesActual, anioActual);
    }
  }

  function loadAsistenciaResumenDNI(mes: number, anio: number) {
    fetch(`/api/ministerios/dni/asistencia/resumen/?mes=${mes}&anio=${anio}`)
      .then(res => res.json())
      .then(data => {
        const container = document.getElementById('asistencia-view-resumen');
        if (!container) return;

        if (data.length === 0) {
          container.innerHTML = '<div class="empty-state"><p>No hay datos de asistencia para este mes</p></div>';
          return;
        }

        const rows = data.map((r: any) => `
          <div class="list-item">
            <div class="list-item-info">
              <span class="list-item-title">${formatDate(r.fecha)}</span>
              <span class="list-item-subtitle">
                ${r.por_clase ? Object.entries(r.por_clase).map(([k, v]) => getClaseLabel(k) + ': ' + v).join(' | ') : ''}
              </span>
            </div>
            <div class="list-item-meta">
              <span class="badge badge-success">${r.total_asistencia} asist.</span>
              <span class="badge badge-info">${r.total_visitas} visitas</span>
              <span class="badge badge-warning">${r.total_biblias} biblias</span>
              <span class="amount positive">${formatCurrency(r.total_ofrendas)}</span>
            </div>
          </div>
        `).join('');

        container.innerHTML = `<div class="card-list">${rows}</div>`;
      })
      .catch(err => console.error('Error loading resumen:', err));
  }

  function loadAsistenciaAcumulativaDNI(mes: number, anio: number) {
    fetch(`/api/ministerios/dni/asistencia/acumulativa/?mes=${mes}&anio=${anio}`)
      .then(res => res.json())
      .then(data => {
        const container = document.getElementById('asistencia-view-acumulativa');
        if (!container) return;

        const miembrosRows = data.miembros && data.miembros.length
          ? data.miembros.map((m: any) => `
            <div class="list-item">
              <div class="list-item-info">
                <span class="list-item-title">${m.nombre_completo}</span>
                <span class="list-item-subtitle">${m.clase ? getClaseLabel(m.clase) : 'Sin clase'}</span>
              </div>
              <div class="list-item-meta">
                <span class="badge badge-success">${m.asistencias_count} veces</span>
              </div>
            </div>
          `).join('')
          : '<div class="empty-state"><p>No hay datos de miembros</p></div>';

        container.innerHTML = `
          <div class="stats-grid" style="margin-bottom: 1rem;">
            <div class="stat-card">
              <div class="stat-value">${data.total_asistencias || 0}</div>
              <div class="stat-label">Total Asistencias</div>
            </div>
            <div class="stat-card">
              <div class="stat-value">${data.visitas_total || 0}</div>
              <div class="stat-label">Visitas Únicas</div>
            </div>
          </div>
          <div class="card-list">${miembrosRows}</div>
        `;
      })
      .catch(err => console.error('Error loading acumulativa:', err));
  }

  (window as any).switchAsistenciaView = function(view: string) {
    document.querySelectorAll('.asistencia-tabs .tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(`btn-asistencia-${view}`)?.classList.add('active');

    document.getElementById('asistencia-view-registro')!.style.display = view === 'registro' ? 'block' : 'none';
    document.getElementById('asistencia-view-resumen')!.style.display = view === 'resumen' ? 'block' : 'none';
    document.getElementById('asistencia-view-acumulativa')!.style.display = view === 'acumulativa' ? 'block' : 'none';

    if (view === 'resumen') {
      loadAsistenciaResumenDNI(new Date().getMonth() + 1, new Date().getFullYear());
    } else if (view === 'acumulativa') {
      loadAsistenciaAcumulativaDNI(new Date().getMonth() + 1, new Date().getFullYear());
    }
  };

  (window as any).filterAsistenciaByClase = function(clase: string) {
    const url = clase ? `/ministerios/${slug}/asistencia/?clase=${clase}` : `/ministerios/${slug}/asistencia/`;
    fetch(url).then(res => res.json()).then(data => renderAsistencia(data));
  };

  (window as any).filterAsistenciaByFecha = function(fecha: string) {
