---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Ministerios">
  <div id="app"></div>
</DashboardLayout>

<script>
  const app = document.getElementById('app');

  const iconos: Record<string, string> = {
    mni: '<circle cx="12" cy="7" r="4"/><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>',
    dni: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
    jni: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    mam: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
    vid: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
    explo: '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>',
    danza: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>',
    teatro: '<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M10 8h4"/><path d="M12 16v-2"/>',
    alabanza: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
    comunicaciones: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
    compasion: '<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
    nazakids: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>',
    'adulto-mayor': '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M17 8h.01"/>'
  };

  async function loadMinisterios() {
    app.innerHTML = '<div style="text-align:center;padding:2rem;">Cargando...</div>';

    try {
      const res = await fetch('http://localhost:8000/api/ministerios/');
      const data = await res.json();
      const ministerios = data.results || data;

      if (!ministerios.length) {
        app.innerHTML = '<p style="text-align:center;color:#64748b;">No hay ministerios</p>';
        return;
      }

      const html = `
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;">
          ${ministerios.map(m => `
            <a href="/ministerios/${m.slug}" style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:1rem;cursor:pointer;transition:all 0.2s;text-decoration:none;display:block;">
              <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
                <div style="width:40px;height:40px;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#fff;background-color:${m.color}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    ${iconos[m.slug] || iconos.mni}
                  </svg>
                </div>
                <div>
                  <h3 style="font-size:1rem;font-weight:600;color:#1e293b;margin:0;">${m.nombre}</h3>
                  <p style="font-size:0.8rem;color:#64748b;margin:0;">${m.descripcion || ''}</p>
                </div>
              </div>
              <div style="display:flex;gap:1rem;padding-top:0.75rem;border-top:1px solid #f1f5f9;">
                <span style="font-size:0.75rem;color:#94a3b8;"><b style="color:#1e293b">${m.miembros_count || 0}</b> miembros</span>
                ${m.lideres_nombres?.length ? `<span style="font-size:0.75rem;color:#94a3b8;"><b style="color:#1e293b">${m.lideres_nombres.length}</b> líderes</span>` : ''}
              </div>
            </a>
          `).join('')}
        </div>
      `;

      app.innerHTML = html;
    } catch (e) {
      app.innerHTML = `<p style="text-align:center;color:#ef4444;">Error: ${e.message}</p>`;
    }
  }

  loadMinisterios();
</script>