---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Gestor de Iglesia - Gestión centralizada para ministerios, finanzas y más" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1E3A5F" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Gestor Iglesia" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | Gestor Iglesia</title>
    <ViewTransitions />
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }

      // Auto-label table cells for responsive card view on mobile
      function labelTable(table) {
        var headers = Array.from(table.querySelectorAll('thead th')).map(function(th) {
          return th.textContent.trim();
        });
        if (!headers.length) return;
        table.querySelectorAll('tbody tr').forEach(function(row) {
          Array.from(row.querySelectorAll('td')).forEach(function(td, i) {
            if (headers[i]) td.setAttribute('data-label', headers[i]);
          });
        });
      }

      function labelAllTables(root) {
        (root || document).querySelectorAll('.overflow-x-auto table').forEach(labelTable);
      }

      // Label tables already in DOM
      document.addEventListener('DOMContentLoaded', function() { labelAllTables(); });
      document.addEventListener('astro:page-load', function() { labelAllTables(); });

      // Watch for tables added dynamically (JS-rendered islands)
      var tableObserver = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          mutation.addedNodes.forEach(function(node) {
            if (node.nodeType !== 1) return;
            if (node.tagName === 'TABLE') {
              labelTable(node);
            } else if (node.querySelectorAll) {
              node.querySelectorAll('.overflow-x-auto table').forEach(labelTable);
              // Also re-label when tbody rows are added to existing tables
              var parentTable = node.closest && node.closest('.overflow-x-auto table');
              if (parentTable) labelTable(parentTable);
            }
          });
        });
      });

      document.addEventListener('DOMContentLoaded', function() {
        tableObserver.observe(document.body, { childList: true, subtree: true });
      });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes slide-in-from-right {
    from { transform: translateX(30px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  ::view-transition-old(fade) {
    animation: fade-out 0.15s ease-out;
  }
  ::view-transition-new(fade) {
    animation: fade-in 0.15s ease-in;
  }
</style>
