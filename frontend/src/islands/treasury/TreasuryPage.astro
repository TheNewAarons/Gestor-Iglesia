---
export interface Props {
  tabs: string[];
}
---

<main>
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Tesorería</h1>
    <p class="text-sm text-gray-500 mt-1">Gestion centralizada de finanzas de la iglesia</p>
  </div>

  <nav class="flex gap-0 overflow-x-auto border-b border-gray-200 mb-6" id="tabs-nav">
    <button class="mp-tab inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 border-primary text-primary transition-colors whitespace-nowrap" data-tab="dashboard"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>Dashboard</button>
    <button class="mp-tab inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors whitespace-nowrap" data-tab="flujo-caja"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>Flujo de Caja</button>
    <button class="mp-tab inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors whitespace-nowrap" data-tab="boletas"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="8" x2="22" y2="8"/></svg>Boletas</button>
    <button class="mp-tab inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors whitespace-nowrap" data-tab="traspasos"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>Traspasos</button>
    <button class="mp-tab inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors whitespace-nowrap" data-tab="informe"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>Informe Mensual</button>
    <button class="mp-tab inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors whitespace-nowrap" data-tab="movimientos"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>Movimientos</button>
    <button class="mp-tab inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors whitespace-nowrap" data-tab="historial"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>Historial</button>
    <button class="mp-tab inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors whitespace-nowrap" data-tab="pendientes"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>Pendientes <span id="pendientes-count" class="ml-1 inline-flex items-center justify-center px-1.5 py-0.5 text-xs font-bold leading-none text-white bg-amber-500 rounded-full" style="display:none">0</span></button>
    <button class="mp-tab inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors whitespace-nowrap" data-tab="configuracion"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>Configuracion</button>
  </nav>

  <div id="loading-indicator" class="h-1 bg-gradient-to-r from-primary to-blue-300 rounded animate-pulse mb-4" style="display:none"></div>
  <div id="error-banner" class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg mb-4 text-sm" style="display:none"></div>
  <div id="success-banner" class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-4 text-sm" style="display:none"></div>

  <div class="tab-content" id="tab-dashboard"></div>
  <div class="tab-content" style="display:none" id="tab-flujo-caja"></div>
  <div class="tab-content" style="display:none" id="tab-boletas"></div>
  <div class="tab-content" style="display:none" id="tab-traspasos"></div>
  <div class="tab-content" style="display:none" id="tab-informe"></div>
  <div class="tab-content" style="display:none" id="tab-movimientos"></div>
  <div class="tab-content" style="display:none" id="tab-historial"></div>
  <div class="tab-content" style="display:none" id="tab-pendientes"></div>
  <div class="tab-content" style="display:none" id="tab-configuracion"></div>

  <div id="boleta-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" style="display:none">
    <div class="bg-white rounded-xl shadow-xl max-w-lg w-full mx-4 max-h-[80vh] overflow-y-auto">
      <div class="flex justify-between items-center px-5 py-4 border-b border-gray-100"><h3 class="text-base font-semibold text-gray-900">Detalle de Boleta</h3><button id="modal-close" class="text-gray-400 hover:text-gray-600 text-2xl leading-none">&times;</button></div>
      <div id="modal-body" class="p-5"></div>
    </div>
  </div>
</main>

<script>
  import { tesoreriaStore } from '../../stores/tesoreria';
  import { showError as toastError } from '../../utils/toast';

  const store = tesoreriaStore;
  let currentTab = 'dashboard';

  function formatCurrency(val: number | string): string {
    const n = typeof val === 'string' ? parseFloat(val) : val;
    return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', minimumFractionDigits: 0 }).format(n);
  }

  function showLoading() { const el = document.getElementById('loading-indicator'); if (el) el.style.display = 'block'; }
  function hideLoading() { const el = document.getElementById('loading-indicator'); if (el) el.style.display = 'none'; }

  function showError(msg: string) {
    const el = document.getElementById('error-banner');
    if (!el) return;
    el.textContent = msg;
    el.style.display = 'block';
    setTimeout(() => { el.style.display = 'none'; }, 5000);
  }

  function showSuccess(msg: string) {
    const el = document.getElementById('success-banner');
    if (!el) return;
    el.textContent = msg;
    el.style.display = 'block';
    setTimeout(() => { el.style.display = 'none'; }, 3000);
  }

  store.subscribe(() => {
    const state = store.getState();
    if (state.loading) showLoading(); else hideLoading();
    if (state.error) showError(state.error);
    if (state.successMessage) showSuccess(state.successMessage);
    renderCurrentTab();
  });

  function switchTab(tabName: string) {
    currentTab = tabName;
    document.querySelectorAll('.mp-tab').forEach((b) => {
      b.className = 'mp-tab inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors whitespace-nowrap';
    });
    const activeBtn = document.querySelector(`[data-tab="${tabName}"]`);
    if (activeBtn) {
      activeBtn.className = 'mp-tab inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 border-primary text-primary transition-colors whitespace-nowrap';
    }
    document.querySelectorAll('.tab-content').forEach((el: any) => el.style.display = 'none');
    const targetTab = document.getElementById(`tab-${tabName}`);
    if (targetTab) targetTab.style.display = 'block';
    if (tabName === 'pendientes') store.fetchPendientes();
    renderCurrentTab();
  }

  function renderCurrentTab() {
    const state = store.getState();
    switch (currentTab) {
      case 'dashboard': renderDashboard(state); break;
      case 'flujo-caja': renderFlujoCaja(state); break;
      case 'boletas': renderBoletas(state); break;
      case 'traspasos': renderTraspasos(state); break;
      case 'informe': renderInforme(state); break;
      case 'movimientos': renderMovimientos(state); break;
      case 'historial': renderHistorial(state); break;
      case 'pendientes': renderPendientes(state); break;
      case 'configuracion': renderConfiguracion(state); break;
    }
  }

  // --- Dashboard ---
  function renderDashboard(state: any) {
    const el = document.getElementById('tab-dashboard')!;
    if (!state.saldos || state.saldos.length === 0) {
      el.innerHTML = `
        <div class="text-center py-12 text-gray-500">
          <p class="text-sm text-gray-700 mb-1">No hay ministerios con cajas activas.</p>
          <button class="inline-flex items-center justify-center gap-2 font-medium transition-colors bg-primary text-white hover:bg-primary-600 shadow-sm px-3 py-1.5 text-xs rounded-md cursor-pointer" onclick="location.reload()">Recargar</button>
        </div>`;
      return;
    }
    const totalSaldo = state.saldos.reduce((acc: number, s: any) => acc + s.saldo, 0);
    const totalIngresos = state.saldos.reduce((acc: number, s: any) => acc + s.total_ingresos, 0);
    const totalEgresos = state.saldos.reduce((acc: number, s: any) => acc + s.total_egresos, 0);
    el.innerHTML = `
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5">
          <div class="text-xs text-gray-500 mb-1.5 uppercase tracking-wider">Saldo Total</div>
          <div class="text-2xl font-bold ${totalSaldo >= 0 ? 'text-green-700' : 'text-red-600'}">${formatCurrency(totalSaldo)}</div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5">
          <div class="text-xs text-gray-500 mb-1.5 uppercase tracking-wider">Total Ingresos</div>
          <div class="text-2xl font-bold text-green-700">${formatCurrency(totalIngresos)}</div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5">
          <div class="text-xs text-gray-500 mb-1.5 uppercase tracking-wider">Total Egresos</div>
          <div class="text-2xl font-bold text-red-600">${formatCurrency(totalEgresos)}</div>
        </div>
      </div>
      <h3 class="font-semibold text-gray-900 mb-4">Saldos por Ministerio</h3>
      <div class="flex flex-col gap-3">
        ${state.saldos.map((s: any) => `
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4" style="border-left: 3px solid ${s.ministry_color}">
            <div class="flex justify-between items-center mb-2">
              <span class="font-semibold text-gray-900">${s.ministry_nombre}</span>
              <span class="font-bold text-lg ${s.saldo >= 0 ? 'text-green-700' : 'text-red-600'}">${formatCurrency(s.saldo)}</span>
            </div>
            <div class="flex gap-6 text-xs text-gray-500">
              <span>Ingresos: ${formatCurrency(s.total_ingresos)}</span>
              <span>Egresos: ${formatCurrency(s.total_egresos)}</span>
            </div>
          </div>
        `).join('')}
      </div>`;
  }

  // --- Flujo de Caja ---
  function renderFlujoCaja(state: any) {
    const el = document.getElementById('tab-flujo-caja')!;
    const now = new Date();
    el.innerHTML = `
      <div class="flex gap-3 items-end flex-wrap mb-5 p-4 bg-white rounded-lg shadow-sm border border-gray-100">
        <div class="flex flex-col gap-1">
          <label class="text-sm font-medium text-gray-700">Mes</label>
          <select class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white" id="flujo-mes">
            ${Array.from({length:12}, (_, i) => `<option value="${i+1}" ${i+1 === now.getMonth()+1 ? 'selected' : ''}>${new Date(2024,i,1).toLocaleString('es',{month:'long'})}</option>`).join('')}
          </select>
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-sm font-medium text-gray-700">Año</label>
          <select class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white" id="flujo-anio">
            ${Array.from({length:5}, (_, i) => `<option value="${now.getFullYear()-2+i}" ${now.getFullYear()-2+i === now.getFullYear() ? 'selected' : ''}>${now.getFullYear()-2+i}</option>`).join('')}
          </select>
        </div>
        <button class="inline-flex items-center justify-center gap-2 font-medium transition-colors bg-primary text-white hover:bg-primary-600 shadow-sm px-3 py-1.5 text-xs rounded-md cursor-pointer" id="btn-buscar-flujo">Buscar</button>
      </div>
      <div id="flujo-content">
        ${!state.flujo ? '<div class="text-center py-12 text-gray-500"><p class="text-sm text-gray-700 mb-1">Selecciona mes y año para ver el flujo de caja.</p></div>' : `
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5"><div class="text-xs text-gray-500 mb-1.5 uppercase tracking-wider">Ofrendas</div><div class="text-2xl font-bold text-green-700">${formatCurrency(state.flujo.total_ofrendas)}</div></div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5"><div class="text-xs text-gray-500 mb-1.5 uppercase tracking-wider">Ingresos Caja</div><div class="text-2xl font-bold text-green-700">${formatCurrency(state.flujo.total_ingresos_caja)}</div></div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5"><div class="text-xs text-gray-500 mb-1.5 uppercase tracking-wider">Egresos</div><div class="text-2xl font-bold text-red-600">${formatCurrency(state.flujo.total_egresos)}</div></div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5"><div class="text-xs text-gray-500 mb-1.5 uppercase tracking-wider">Saldo Neto</div><div class="text-2xl font-bold ${state.flujo.saldo_neto >= 0 ? 'text-green-700' : 'text-red-600'}">${formatCurrency(state.flujo.saldo_neto)}</div></div>
          </div>
        `}
      </div>`;
    setTimeout(() => {
      document.getElementById('btn-buscar-flujo')?.addEventListener('click', () => {
        const mes = parseInt((document.getElementById('flujo-mes') as HTMLSelectElement).value);
        const anio = parseInt((document.getElementById('flujo-anio') as HTMLSelectElement).value);
        store.fetchFlujoCaja(mes, anio);
      });
    }, 0);
  }

  // --- Boletas ---
  function renderBoletas(state: any) {
    const el = document.getElementById('tab-boletas')!;
    el.innerHTML = `
      <div class="flex gap-3 items-end flex-wrap mb-5 p-4 bg-white rounded-lg shadow-sm border border-gray-100">
        <div class="flex flex-col gap-1">
          <label class="text-sm font-medium text-gray-700">Desde</label>
          <input type="date" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md bg-white" id="boleta-inicio" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white" />
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-sm font-medium text-gray-700">Hasta</label>
          <input type="date" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md bg-white" id="boleta-fin" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white" />
        </div>
        <button class="inline-flex items-center justify-center gap-2 font-medium transition-colors bg-primary text-white hover:bg-primary-600 shadow-sm px-3 py-1.5 text-xs rounded-md cursor-pointer" id="btn-buscar-boletas">Buscar</button>
      </div>
      <div class="overflow-x-auto bg-white rounded-lg shadow-sm border border-gray-100">
        <table class="w-full text-sm" id="boletas-table">
          <thead><tr class="border-b border-gray-200"><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Fecha</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Ministerio</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Tipo</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Monto</th><th>Descripción</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Registrado por</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Boleta</th></tr></thead>
          <tbody>
            ${state.boletas.results && state.boletas.results.length > 0
              ? state.boletas.results.map((b: any) => `
                <tr class="clickable-row border-b border-gray-100 hover:bg-gray-50" data-boleta-id="${b.id}">
                  <td class="px-4 py-2">${new Date(b.fecha).toLocaleDateString('es-PY')}</td>
                  <td><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium" style="background:${b.ministry_color || '#6b7280'}20;color:${b.ministry_color || '#6b7280'}">${b.ministry_nombre}</span></td>
                  <td><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${b.tipo === 'ingreso' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">${b.tipo}</span></td>
                  <td class="${b.tipo === 'ingreso' ? 'text-green-700' : 'text-red-600'} font-medium">${formatCurrency(b.monto)}</td>
                  <td>${b.descripcion}</td>
                  <td>${b.registrado_por_nombre || '-'}</td>
                  <td>${b.imagen ? '<span class="badge badge-info">Ver</span>' : '-'}</td>
                </tr>`).join('')
              : '<tr><td colspan="6" class="text-center empty-cell">No hay boletas registradas</td></tr>'}
          </tbody>
        </table>
      </div>`;
    setTimeout(() => {
      document.getElementById('btn-buscar-boletas')?.addEventListener('click', () => {
        const ini = (document.getElementById('boleta-inicio') as HTMLInputElement).value;
        const fin = (document.getElementById('boleta-fin') as HTMLInputElement).value;
        store.fetchBoletas(ini || undefined, fin || undefined);
      });
      document.querySelectorAll('.clickable-row').forEach(row => {
        row.addEventListener('click', () => {
          const id = parseInt((row as HTMLElement).dataset.boletaId!);
          openBoletaModal(id);
        });
      });
    }, 0);
  }

  // --- Traspasos ---
  function renderTraspasos(state: any) {
    const el = document.getElementById('tab-traspasos')!;
    const ministryOptions = state.saldos.map((s: any) =>
      `<option value="${s.ministry_slug}">${s.ministry_nombre}</option>`
    ).join('');
    el.innerHTML = `
      <h3 class="font-semibold text-gray-900 mb-4">Nuevo Traspaso</h3>
      <form id="traspaso-form" class="traspaso-form">
        <div class="flex gap-3 items-end flex-wrap">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-medium text-gray-700">Ministerio</label>
            <select class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white" name="ministry_slug" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white" required>${ministryOptions}</select>
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-medium text-gray-700">Monto</label>
            <input type="number" name="monto" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md bg-white" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white" step="1000" min="1" required />
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-medium text-gray-700">Descripción</label>
            <input type="text" name="descripcion" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md bg-white" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white" placeholder="Traspaso mensual" />
          </div>
          <button type="submit" class="inline-flex items-center justify-center gap-2 font-medium transition-colors bg-primary text-white hover:bg-primary-600 shadow-sm px-4 py-2 text-sm rounded-md cursor-pointer" style="align-self:flex-end">Registrar Traspaso</button>
        </div>
      </form>
      <h3 class="font-semibold text-gray-900 mb-4" style="margin-top:1.5rem">Historial de Traspasos</h3>
      <div class="overflow-x-auto bg-white rounded-lg shadow-sm border border-gray-100">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-gray-200"><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Fecha</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Ministerio</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Monto</th><th>Descripción</th><th>Registrado por</th></tr></thead>
          <tbody>
            ${state.traspasos.results && state.traspasos.results.length > 0
              ? state.traspasos.results.map((t: any) => `
                <tr>
                  <td class="px-4 py-2">${new Date(t.fecha).toLocaleDateString('es-PY')}</td>
                  <td><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium" style="background:${t.ministry_color || '#6b7280'}20;color:${t.ministry_color || '#6b7280'}">${t.ministry_nombre}</span></td>
                  <td class="text-green-700 font-medium">${formatCurrency(t.monto)}</td>
                  <td>${t.descripcion}</td>
                  <td>${t.registrado_por_nombre || '-'}</td>
                </tr>`).join('')
              : '<tr><td colspan="5" class="text-center empty-cell">No hay traspasos registrados</td></tr>'}
          </tbody>
        </table>
      </div>`;
    setTimeout(() => {
      document.getElementById('traspaso-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const form = e.target as HTMLFormElement;
        const fd = new FormData(form);
        const ministry = fd.get('ministry_slug') as string;
        const monto = fd.get('monto') as string;
        if (!ministry) { toastError('Selecciona un ministerio'); return; }
        if (!monto || parseFloat(monto) <= 0) { toastError('El monto debe ser mayor a 0'); return; }
        store.crearTraspaso({
          ministry_slug: ministry,
          monto: monto,
          descripcion: fd.get('descripcion') as string,
        });
      });
    }, 0);
  }

  // --- Informe Mensual ---
  function renderInforme(state: any) {
    const el = document.getElementById('tab-informe')!;
    const now = new Date();
    el.innerHTML = `
      <div class="flex gap-3 items-end flex-wrap mb-5 p-4 bg-white rounded-lg shadow-sm border border-gray-100">
        <div class="flex flex-col gap-1">
          <label class="text-sm font-medium text-gray-700">Mes</label>
          <select class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white" id="informe-mes">
            ${Array.from({length:12}, (_, i) => `<option value="${i+1}" ${i+1 === now.getMonth()+1 ? 'selected' : ''}>${new Date(2024,i,1).toLocaleString('es',{month:'long'})}</option>`).join('')}
          </select>
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-sm font-medium text-gray-700">Año</label>
          <select class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white" id="informe-anio">
            ${Array.from({length:5}, (_, i) => `<option value="${now.getFullYear()-2+i}" ${now.getFullYear()-2+i === now.getFullYear() ? 'selected' : ''}>${now.getFullYear()-2+i}</option>`).join('')}
          </select>
        </div>
        <button class="inline-flex items-center justify-center gap-2 font-medium transition-colors bg-primary text-white hover:bg-primary-600 shadow-sm px-3 py-1.5 text-xs rounded-md cursor-pointer" id="btn-generar-informe">Generar</button>
        <button class="inline-flex items-center justify-center gap-2 font-medium transition-colors text-gray-600 hover:bg-gray-100 px-3 py-1.5 text-xs rounded-md cursor-pointer border border-gray-300" id="btn-exportar-informe">Exportar JSON</button>
        <button class="inline-flex items-center justify-center gap-2 font-medium transition-colors text-gray-600 hover:bg-gray-100 px-3 py-1.5 text-xs rounded-md cursor-pointer border border-gray-300" id="btn-exportar-pdf">Exportar PDF</button>
        <button class="inline-flex items-center justify-center gap-2 font-medium transition-colors text-gray-600 hover:bg-gray-100 px-3 py-1.5 text-xs rounded-md cursor-pointer border border-gray-300" id="btn-exportar-excel">Exportar Excel</button>
      </div>
      <div id="informe-content">
        ${!state.informe
          ? '<div class="text-center py-12 text-gray-500"><p class="text-sm text-gray-700 mb-1">Genera un informe para ver los detalles.</p></div>'
          : renderInformeDetalle(state.informe)
        }
      </div>`;
    setTimeout(() => {
      document.getElementById('btn-generar-informe')?.addEventListener('click', () => {
        const mes = parseInt((document.getElementById('informe-mes') as HTMLSelectElement).value);
        const anio = parseInt((document.getElementById('informe-anio') as HTMLSelectElement).value);
        store.fetchInforme(mes, anio, true);
      });
      document.getElementById('btn-exportar-informe')?.addEventListener('click', () => {
        const mes = parseInt((document.getElementById('informe-mes') as HTMLSelectElement).value);
        const anio = parseInt((document.getElementById('informe-anio') as HTMLSelectElement).value);
        store.exportarInformeJson(mes, anio);
      });
      document.getElementById('btn-exportar-pdf')?.addEventListener('click', () => {
        const mes = parseInt((document.getElementById('informe-mes') as HTMLSelectElement).value);
        const anio = parseInt((document.getElementById('informe-anio') as HTMLSelectElement).value);
        store.exportarInformePdf(mes, anio);
      });
      document.getElementById('btn-exportar-excel')?.addEventListener('click', () => {
        const mes = parseInt((document.getElementById('informe-mes') as HTMLSelectElement).value);
        const anio = parseInt((document.getElementById('informe-anio') as HTMLSelectElement).value);
        store.exportarInformeExcel(mes, anio);
      });
    }, 0);
  }

