---
const DIAS_SEMANA = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
const MESES = [
  'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
];
---

<div id="calendario-page">
  <div id="calendario-skeleton" class="animate-pulse">
    <div class="flex items-center justify-between mb-6">
      <div class="h-8 bg-gray-200 rounded w-48"></div>
      <div class="flex gap-2">
        <div class="h-9 w-24 bg-gray-200 rounded-lg"></div>
        <div class="h-9 w-36 bg-gray-200 rounded-lg"></div>
      </div>
    </div>
    <div class="grid grid-cols-7 gap-px bg-gray-200 rounded-lg overflow-hidden">
      {Array.from({ length: 35 }).map(() => <div class="h-24 bg-gray-50"></div>)}
    </div>
  </div>

  <div id="calendario-content" class="hidden">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
      <div class="flex items-center gap-2">
        <button id="btn-prev-month" class="p-2 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors" aria-label="Mes anterior">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <h2 id="month-label" class="text-xl font-semibold text-gray-900 min-w-52 text-center"></h2>
        <button id="btn-next-month" class="p-2 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors" aria-label="Mes siguiente">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <div class="flex items-center gap-2">
        <button id="btn-today" class="px-3 py-1.5 text-sm font-medium text-accent bg-accent/10 rounded-lg hover:bg-accent/20 transition-colors">
          Hoy
        </button>
        <select id="filter-ministerio" class="text-sm border border-gray-200 rounded-lg px-3 py-2 bg-white text-gray-700 focus:border-accent focus:ring-1 focus:ring-accent outline-none">
          <option value="">Todos los ministerios</option>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-7 gap-px bg-gray-200 rounded-lg overflow-hidden">
      {DIAS_SEMANA.map((dia) => (
        <div class="bg-gray-100 py-2 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">
          {dia}
        </div>
      ))}
    </div>
    <div id="calendar-grid" class="grid grid-cols-7 gap-px bg-gray-200 rounded-b-lg overflow-hidden"></div>

    <div id="events-list-mobile" class="mt-6 md:hidden space-y-3"></div>
  </div>
</div>

<div id="evento-modal" class="fixed inset-0 z-50 hidden items-center justify-center">
  <div class="fixed inset-0 bg-black/40" id="evento-modal-backdrop"></div>
  <div class="relative bg-white rounded-xl shadow-xl max-w-lg w-full mx-4 p-6 z-10">
    <button id="evento-modal-close" class="absolute top-4 right-4 p-1 text-gray-400 hover:text-gray-600">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div id="evento-modal-content"></div>
  </div>
</div>

<script>
  import { api } from '../utils/api';
  import { authStore } from '../stores/auth';
  import { MINISTRY_COLORS } from '../utils/colors';

  var year, month, events, ministerios;
  var unsub = null;

  const DIAS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
  const MESES_LIST = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

  function formatDate(d) {
    return new Date(d).toLocaleDateString('es-PY', { year: 'numeric', month: 'long', day: 'numeric' });
  }

  function fmtTime(t) {
    if (!t) return '';
    return t.length >= 5 ? t.substring(0, 5) : t;
  }

  function getMinistryColor(slug) {
    var c = MINISTRY_COLORS[slug];
    return c ? c.primary : '#3B82F6';
  }

  function getEventColor(evento) {
    if (evento.ministry_nombre) {
      return getMinistryColor(evento.ministry_nombre.toLowerCase().replace(/\s+/g, '-'));
    }
    return '#3B82F6';
  }

  async function loadCalendario() {
    const skeleton = document.getElementById('calendario-skeleton');
    const content = document.getElementById('calendario-content');
    const select = document.getElementById('filter-ministerio');

    const ahora = new Date();
    year = ahora.getFullYear();
    month = ahora.getMonth() + 1;
    const ministerioSlug = select ? select.value : '';

    try {
      const params = new URLSearchParams({ year: year.toString(), month: month.toString() });
      if (ministerioSlug) params.append('ministerio', ministerioSlug);
      events = await api.get('/eventos/calendario/?' + params.toString());
    } catch (e) {
      events = [];
      console.error('Error loading calendar:', e);
    }

    if (skeleton) skeleton.classList.add('hidden');
    if (content) content.classList.remove('hidden');
    renderCalendario();
  }

  async function loadMinisterios() {
    try {
      const response = await api.get('/ministerios/');
      ministerios = response.results || [];
      const select = document.getElementById('filter-ministerio');
      if (select) {
        ministerios.forEach(function(m) {
          var opt = document.createElement('option');
          opt.value = m.slug;
          opt.textContent = m.nombre;
          select.appendChild(opt);
        });
      }
    } catch (e) {
      ministerios = [];
      console.error('Error loading ministerios:', e);
    }
  }

  function renderCalendario() {
    const label = document.getElementById('month-label');
    if (label) label.textContent = MESES_LIST[month - 1] + ' ' + year;

    const grid = document.getElementById('calendar-grid');
    if (!grid) return;

    const firstDay = new Date(year, month - 1, 1).getDay(); // 0=Dom, 1=Lun, ...
    const offset = firstDay === 0 ? 6 : firstDay - 1; // Convertir a Lun=0
    const daysInMonth = new Date(year, month, 0).getDate();
    const today = new Date();
    const todayStr = new Date(today.getFullYear(), today.getMonth(), today.getDate()).toISOString().split('T')[0];

    var html = '';

    // Días vacíos antes del 1ro
    for (var i = 0; i < offset; i++) {
      html += '<div class="bg-gray-50/50 min-h-[96px] p-2"></div>';
    }

    for (var d = 1; d <= daysInMonth; d++) {
      var dateStr = year + '-' + String(month).padStart(2, '0') + '-' + String(d).padStart(2, '0');
      var isToday = dateStr === todayStr;
      var dayEvents = events.filter(function(ev) {
        return ev.fecha_inicio && ev.fecha_inicio.startsWith(dateStr);
      });

      html += '<div class="bg-white min-h-[96px] p-1.5 ' + (isToday ? 'ring-2 ring-accent ring-inset' : '') + '">';
      html += '<div class="text-right mb-1">';
      html += '<span class="inline-flex items-center justify-center w-7 h-7 text-sm rounded-full ' + (isToday ? 'bg-accent text-white font-bold' : 'text-gray-700') + '">' + d + '</span>';
      html += '</div>';
      html += '<div class="space-y-0.5">';

      var maxShow = dayEvents.length > 3 ? 2 : dayEvents.length;
      for (var e = 0; e < maxShow; e++) {
        var ev = dayEvents[e];
        var color = getEventColor(ev);
        var timeStr = ev.hora_inicio ? fmtTime(ev.hora_inicio) + ' ' : '';
        html += '<div class="evento-badge truncate text-xs px-1.5 py-0.5 rounded cursor-pointer hover:opacity-80 transition-opacity" style="background-color:' + color + '1a;color:' + color + ';border-left:2px solid ' + color + '" data-event-id="' + ev.id + '" title="' + ev.titulo + '">' + timeStr + ev.titulo + '</div>';
      }

      if (dayEvents.length > 3) {
        html += '<div class="text-xs text-gray-400 pl-1 cursor-pointer hover:text-accent" data-day-events="' + dateStr + '">+' + (dayEvents.length - 2) + ' más</div>';
      }

      html += '</div>';
      html += '</div>';
    }

    // Completar última fila
    var totalCells = offset + daysInMonth;
    var remaining = totalCells % 7;
    if (remaining > 0) {
      for (var r = 0; r < 7 - remaining; r++) {
        html += '<div class="bg-gray-50/50 min-h-[96px] p-2"></div>';
      }
    }

    grid.innerHTML = html;

    // Bind event click handlers
    grid.querySelectorAll('.evento-badge').forEach(function(badge) {
      badge.addEventListener('click', function(e) {
        e.stopPropagation();
        var id = parseInt(badge.getAttribute('data-event-id'));
        var ev = events.find(function(ev) { return ev.id === id; });
        if (ev) openEventoModal(ev);
      });
    });

    // Bind "+X más" handlers
    grid.querySelectorAll('[data-day-events]').forEach(function(el) {
      el.addEventListener('click', function(e) {
        e.stopPropagation();
        var dateStr = el.getAttribute('data-day-events');
        var dayEvents = events.filter(function(ev) {
          return ev.fecha_inicio && ev.fecha_inicio.startsWith(dateStr);
        });
        if (dayEvents.length > 0) {
          showDayEvents(dateStr, dayEvents);
        }
      });
    });

    // Mobile events list
    renderMobileEvents();
  }

  function renderMobileEvents() {
    var mobile = document.getElementById('events-list-mobile');
    if (!mobile || events.length === 0) {
      if (mobile) mobile.innerHTML = '<p class="text-sm text-gray-400 text-center py-8">No hay eventos este mes</p>';
      return;
    }

    var grouped = {};
    events.forEach(function(ev) {
      var d = ev.fecha_inicio ? ev.fecha_inicio.split('T')[0] : null;
      if (!d) return;
      if (!grouped[d]) grouped[d] = [];
      grouped[d].push(ev);
    });

    var html = '';
    Object.keys(grouped).sort().forEach(function(dateKey) {
      var dateEvents = grouped[dateKey];
      html += '<div class="mb-4">';
      html += '<h3 class="text-sm font-semibold text-gray-700 mb-2">' + formatDate(dateKey) + '</h3>';
      dateEvents.forEach(function(ev) {
        var color = getEventColor(ev);
        html += '<div class="evento-badge flex items-center gap-3 p-3 bg-white rounded-lg border border-gray-200 mb-2 cursor-pointer hover:border-accent/30 transition-colors" data-event-id="' + ev.id + '" style="border-left: 3px solid ' + color + '">';
        html += '<div class="flex-1 min-w-0">';
        html += '<p class="text-sm font-medium text-gray-900 truncate">' + ev.titulo + '</p>';
        html += '<p class="text-xs text-gray-500">' + fmtTime(ev.hora_inicio) + (ev.hora_fin ? ' - ' + fmtTime(ev.hora_fin) : '') + (ev.ubicacion ? ' &middot; ' + ev.ubicacion : '') + '</p>';
        html += '</div>';
        html += '<span class="text-xs px-2 py-0.5 rounded-full font-medium" style="background-color:' + color + '1a;color:' + color + '">' + (ev.ministry_nombre || '') + '</span>';
        html += '</div>';
      });
      html += '</div>';
    });

    mobile.innerHTML = html;

    mobile.querySelectorAll('.evento-badge').forEach(function(el) {
      el.addEventListener('click', function() {
        var id = parseInt(el.getAttribute('data-event-id'));
        var ev = events.find(function(ev) { return ev.id === id; });
        if (ev) openEventoModal(ev);
      });
    });
  }

  function showDayEvents(dateStr, dayEvents) {
    var content = document.getElementById('evento-modal-content');
    var color = dayEvents.length > 0 ? getEventColor(dayEvents[0]) : '#3B82F6';

    var html = '<h3 class="text-lg font-semibold text-gray-900 mb-1">' + formatDate(dateStr) + '</h3>';
    html += '<p class="text-sm text-gray-500 mb-4">' + dayEvents.length + ' evento' + (dayEvents.length !== 1 ? 's' : '') + '</p>';
    html += '<div class="space-y-3 max-h-96 overflow-y-auto">';

    dayEvents.forEach(function(ev) {
      html += '<div class="p-3 rounded-lg border border-gray-100" style="border-left: 3px solid ' + getEventColor(ev) + '">';
      html += '<p class="font-medium text-gray-900">' + ev.titulo + '</p>';
      html += '<p class="text-sm text-gray-500 mt-1">' + fmtTime(ev.hora_inicio) + (ev.hora_fin ? ' - ' + fmtTime(ev.hora_fin) : '') + '</p>';
      if (ev.ubicacion) html += '<p class="text-sm text-gray-500">📍 ' + ev.ubicacion + '</p>';
      if (ev.descripcion) html += '<p class="text-sm text-gray-600 mt-2">' + ev.descripcion + '</p>';
      html += '<p class="text-xs text-gray-400 mt-2">' + (ev.ministry_nombre || '') + ' &middot; Creado por ' + (ev.creado_por_nombre || '—') + '</p>';
      html += '</div>';
    });

    html += '</div>';

    content.innerHTML = html;
    document.getElementById('evento-modal').classList.remove('hidden');
    document.getElementById('evento-modal').classList.add('flex');
  }

  function openEventoModal(ev) {
    var content = document.getElementById('evento-modal-content');
    var color = getEventColor(ev);

    var html = '';
    html += '<div class="w-3 h-3 rounded-full mb-3" style="background-color:' + color + '"></div>';
    html += '<h3 class="text-xl font-semibold text-gray-900">' + ev.titulo + '</h3>';
    html += '<p class="text-sm text-gray-500 mt-1">' + (ev.ministry_nombre || '') + '</p>';
    html += '<div class="mt-4 space-y-3">';
    html += '<div class="flex items-center gap-2 text-sm"><span class="text-gray-400">🕐</span><span class="text-gray-700">' + formatDate(ev.fecha_inicio) + ' &middot; ' + fmtTime(ev.hora_inicio) + (ev.hora_fin ? ' - ' + fmtTime(ev.hora_fin) : '') + '</span></div>';
    if (ev.ubicacion) html += '<div class="flex items-center gap-2 text-sm"><span class="text-gray-400">📍</span><span class="text-gray-700">' + ev.ubicacion + '</span></div>';
    if (ev.tipo === 'compartido' && ev.ministerios_relacionados_nombres && ev.ministerios_relacionados_nombres.length > 0) {
      html += '<div class="flex items-center gap-2 text-sm"><span class="text-gray-400">👥</span><span class="text-gray-700">Compartido con: ' + ev.ministerios_relacionados_nombres.join(', ') + '</span></div>';
    }
    if (ev.descripcion) html += '<div class="mt-3 pt-3 border-t border-gray-100"><p class="text-sm text-gray-600">' + ev.descripcion + '</p></div>';
    html += '<p class="text-xs text-gray-400 mt-4">Creado por ' + (ev.creado_por_nombre || '—') + ' &middot; ' + formatDate(ev.created_at || ev.fecha_inicio) + '</p>';
    html += '</div>';

    content.innerHTML = html;
    document.getElementById('evento-modal').classList.remove('hidden');
    document.getElementById('evento-modal').classList.add('flex');
  }

  function closeModal() {
    document.getElementById('evento-modal').classList.add('hidden');
    document.getElementById('evento-modal').classList.remove('flex');
  }

  async function navigateMonth(delta) {
    month += delta;
    if (month > 12) { month = 1; year++; }
    if (month < 1) { month = 12; year--; }
    await loadCalendario();
  }

  async function init() {
    if (unsub) { unsub(); unsub = null; }

    unsub = authStore.subscribe(function(state) {
      if (!state.isLoading) {
        if (!state.isAuthenticated) {
          window.location.href = '/login';
          return;
        }
      }
    });

    await authStore.checkAuth();
    if (!authStore.getState().isAuthenticated) return;

    await loadMinisterios();
    await loadCalendario();

    document.getElementById('btn-prev-month').addEventListener('click', function() { navigateMonth(-1); });
    document.getElementById('btn-next-month').addEventListener('click', function() { navigateMonth(1); });
    document.getElementById('btn-today').addEventListener('click', async function() {
      var ahora = new Date();
      year = ahora.getFullYear();
      month = ahora.getMonth() + 1;
      await loadCalendario();
    });
    document.getElementById('filter-ministerio').addEventListener('change', async function() {
      await loadCalendario();
    });

    var closeBtn = document.getElementById('evento-modal-close');
    var backdrop = document.getElementById('evento-modal-backdrop');
    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeModal();
    });
  }

  document.addEventListener('astro:page-load', function() {
    if (document.getElementById('calendario-page')) init();
  });

  document.addEventListener('astro:before-swap', function() {
    if (unsub) { unsub(); unsub = null; }
  });
</script>
