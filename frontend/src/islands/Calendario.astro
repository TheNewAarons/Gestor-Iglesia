---
const DIAS_SEMANA = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
const MESES = [
  'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
];
---

<div id="calendario-page">
  <div id="calendario-skeleton" class="animate-pulse">
    <div class="flex items-center justify-between mb-6">
      <div class="h-8 bg-gray-200 rounded w-48"></div>
      <div class="flex gap-2">
        <div class="h-9 w-24 bg-gray-200 rounded-lg"></div>
        <div class="h-9 w-36 bg-gray-200 rounded-lg"></div>
      </div>
    </div>
    <div class="grid grid-cols-7 gap-px bg-gray-200 rounded-lg overflow-hidden">
      {Array.from({ length: 35 }).map(() => <div class="h-24 bg-gray-50"></div>)}
    </div>
  </div>

  <div id="calendario-content" class="hidden">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
      <div class="flex items-center gap-2">
        <button id="btn-prev-month" class="p-2 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors" aria-label="Mes anterior">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <h2 id="month-label" class="text-xl font-semibold text-gray-900 min-w-52 text-center"></h2>
        <button id="btn-next-month" class="p-2 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors" aria-label="Mes siguiente">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <div class="flex items-center gap-2">
        <button id="btn-today" class="px-3 py-1.5 text-sm font-medium text-accent bg-accent/10 rounded-lg hover:bg-accent/20 transition-colors">
          Hoy
        </button>
        <select id="filter-ministerio" class="text-sm border border-gray-200 rounded-lg px-3 py-2 bg-white text-gray-700 focus:border-accent focus:ring-1 focus:ring-accent outline-none">
          <option value="">Todos los ministerios</option>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-7 gap-px bg-gray-200 rounded-lg overflow-hidden">
      {DIAS_SEMANA.map((dia) => (
        <div class="bg-gray-100 py-2 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">
          {dia}
        </div>
      ))}
    </div>
    <div id="calendar-grid" class="grid grid-cols-7 gap-px bg-gray-200 rounded-b-lg overflow-hidden"></div>

    <div id="events-list-mobile" class="mt-6 md:hidden space-y-3"></div>
  </div>
</div>

<div id="evento-modal" class="fixed inset-0 z-50 hidden items-center justify-center">
  <div class="fixed inset-0 bg-black/40" id="evento-modal-backdrop"></div>
  <div class="relative bg-white rounded-xl shadow-xl max-w-lg w-full mx-4 p-6 z-10">
    <button id="evento-modal-close" class="absolute top-4 right-4 p-1 text-gray-400 hover:text-gray-600">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div id="evento-modal-content"></div>
  </div>
</div>

<script>
  import { api } from '../utils/api';
  import { authStore } from '../stores/auth';
  import { MINISTRY_COLORS } from '../utils/colors';

  var year, month, events, ministerios;
  var unsub = null;

  const DIAS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
  const MESES_LIST = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

  function formatDate(d) {
    return new Date(d).toLocaleDateString('es-PY', { year: 'numeric', month: 'long', day: 'numeric' });
  }

  function fmtTime(t) {
    if (!t) return '';
    return t.length >= 5 ? t.substring(0, 5) : t;
  }

  function getMinistryColor(slug) {
    var c = MINISTRY_COLORS[slug];
    return c ? c.primary : '#3B82F6';
  }

  function getEventColor(evento) {
    if (evento.ministry_nombre) {
      return getMinistryColor(evento.ministry_nombre.toLowerCase().replace(/\s+/g, '-'));
    }
    return '#3B82F6';
  }

  function isMultiDay(ev) {
    if (!ev.fecha_fin) return false;
    var s = ev.fecha_inicio ? ev.fecha_inicio.substring(0, 10) : null;
    var e = ev.fecha_fin.substring(0, 10);
    return s && s !== e;
  }

  function eventDaysInMonth(ev) {
    var days = [];
    var start = new Date(ev.fecha_inicio);
    start.setHours(0, 0, 0, 0);
    var end = ev.fecha_fin ? new Date(ev.fecha_fin) : new Date(ev.fecha_inicio);
    end.setHours(23, 59, 59, 999);
    var monthStart = new Date(year, month - 1, 1);
    var monthEnd = new Date(year, month, 0);
    monthEnd.setHours(23, 59, 59, 999);

    var iter = new Date(start);
    while (iter <= end) {
      if (iter >= monthStart && iter <= monthEnd) {
        var ds = iter.getFullYear() + '-' + String(iter.getMonth() + 1).padStart(2, '0') + '-' + String(iter.getDate()).padStart(2, '0');
        days.push(ds);
      }
      iter.setDate(iter.getDate() + 1);
    }
    return days;
  }

  function getDayType(ev, dateStr) {
    if (!isMultiDay(ev)) return 'single';
    var days = eventDaysInMonth(ev);
    if (days.length === 0) return 'single';
    if (dateStr === days[0]) return 'start';
    if (dateStr === days[days.length - 1]) return 'end';
    return 'middle';
  }

  function isAllDay(ev) {
    return !ev.hora_inicio;
  }

  function getMinistryAbbr(nombre) {
    if (!nombre) return '';
    if (nombre.length <= 8) return nombre;
    var words = nombre.split(/\s+/);
    if (words.length <= 2) return nombre.substring(0, 8);
    return words.map(function(w) { return w[0].toUpperCase(); }).join('');
  }

  async function loadCalendario() {
    const skeleton = document.getElementById('calendario-skeleton');
    const content = document.getElementById('calendario-content');
    const select = document.getElementById('filter-ministerio');

    const ahora = new Date();
    year = ahora.getFullYear();
    month = ahora.getMonth() + 1;
    const ministerioSlug = select ? select.value : '';

    try {
      const params = new URLSearchParams({ year: year.toString(), month: month.toString() });
      if (ministerioSlug) params.append('ministerio', ministerioSlug);
      events = await api.get('/eventos/calendario/?' + params.toString());
    } catch (e) {
      events = [];
      console.error('Error loading calendar:', e);
    }

    if (skeleton) skeleton.classList.add('hidden');
    if (content) content.classList.remove('hidden');
    renderCalendario();
  }

  async function loadMinisterios() {
    try {
      const response = await api.get('/ministerios/');
      ministerios = response.results || [];
      const select = document.getElementById('filter-ministerio');
      if (select) {
        ministerios.forEach(function(m) {
          var opt = document.createElement('option');
          opt.value = m.slug;
          opt.textContent = m.nombre;
          select.appendChild(opt);
        });
      }
    } catch (e) {
      ministerios = [];
      console.error('Error loading ministerios:', e);
    }
  }

  function renderCalendario() {
    const label = document.getElementById('month-label');
    if (label) label.textContent = MESES_LIST[month - 1] + ' ' + year;

    const grid = document.getElementById('calendar-grid');
    if (!grid) return;

    const firstDay = new Date(year, month - 1, 1).getDay(); // 0=Dom, 1=Lun, ...
    const offset = firstDay === 0 ? 6 : firstDay - 1; // Convertir a Lun=0
    const daysInMonth = new Date(year, month, 0).getDate();
    const today = new Date();
    const todayStr = new Date(today.getFullYear(), today.getMonth(), today.getDate()).toISOString().split('T')[0];

    var html = '';

    // Días vacíos antes del 1ro
    for (var i = 0; i < offset; i++) {
      html += '<div class="bg-gray-50/50 min-h-[96px] p-2"></div>';
    }

    for (var d = 1; d <= daysInMonth; d++) {
      var dateStr = year + '-' + String(month).padStart(2, '0') + '-' + String(d).padStart(2, '0');
      var isToday = dateStr === todayStr;
      var isWeekend = (offset + d) % 7 >= 5;

      var dayEvents = [];
      if (events && events.length) {
        dayEvents = events.filter(function(ev) {
          if (!ev.fecha_inicio) return false;
          var evStart = ev.fecha_inicio.substring(0, 10);
          var evEnd = ev.fecha_fin ? ev.fecha_fin.substring(0, 10) : evStart;
          return dateStr >= evStart && dateStr <= evEnd;
        });
      }

      var bgClass = isWeekend ? 'bg-gray-50' : 'bg-white';

      html += '<div class="' + bgClass + ' min-h-[96px] p-1.5 ' + (isToday ? 'ring-2 ring-accent ring-inset rounded-sm' : '') + '">';
      html += '<div class="text-right mb-0.5">';
      html += '<span class="inline-flex items-center justify-center w-7 h-7 text-sm rounded-full ' + (isToday ? 'bg-accent text-white font-bold' : (isWeekend ? 'text-gray-400' : 'text-gray-700')) + '">' + d + '</span>';
      html += '</div>';
      html += '<div class="space-y-0.5">';

      var maxShow = dayEvents.length > 3 ? 2 : dayEvents.length;
      for (var e = 0; e < maxShow; e++) {
        var ev = dayEvents[e];
        var color = getEventColor(ev);
        var abbr = getMinistryAbbr(ev.ministry_nombre || '');
        var dayType = getDayType(ev, dateStr);

        if (dayType === 'middle' || dayType === 'end') {
          html += '<div class="evento-badge multi-day-cont flex items-center truncate text-[10px] px-1.5 py-0.5 rounded-r cursor-pointer hover:opacity-90 transition-opacity" style="background:' + color + '12;border-left:3px solid ' + color + '" data-event-id="' + ev.id + '" title="' + ev.titulo + '">' + (dayType === 'end' ? '<span class="shrink-0 mr-0.5 opacity-60">↳</span>' : '') + '<span class="truncate font-medium" style="color:' + color + '">' + ev.titulo + '</span></div>';
        } else {
          var timeHtml = '';
          if (isAllDay(ev)) {
            timeHtml = '<span class="font-semibold shrink-0 text-[10px] leading-tight" style="color:' + color + '">Todo el día</span>';
          } else if (ev.hora_inicio) {
            timeHtml = '<span class="font-mono font-semibold shrink-0 text-[10px] leading-tight" style="color:' + color + '">' + fmtTime(ev.hora_inicio) + '</span>';
          }

          var sharedDot = '';
          if (ev.tipo === 'compartido' && ev.ministerios_relacionados_nombres && ev.ministerios_relacionados_nombres.length > 0) {
            sharedDot = '<span class="shrink-0 text-[9px] text-gray-400" title="Compartido con ' + ev.ministerios_relacionados_nombres.join(', ') + '">◇</span>';
          }

          html += '<div class="evento-badge group flex items-center gap-1 truncate text-xs px-1.5 py-0.5 rounded-r cursor-pointer hover:shadow-sm transition-all relative" style="background:' + color + '10;border-left:3px solid ' + color + '" data-event-id="' + ev.id + '" title="' + ev.titulo + '">' + timeHtml + '<span class="truncate font-medium text-gray-800">' + ev.titulo + '</span>' + sharedDot + '<span class="ml-auto shrink-0 text-[9px] px-1 py-0.5 rounded font-semibold leading-none" style="background:' + color + ';color:#fff">' + abbr + '</span></div>';
        }
      }

      if (dayEvents.length > 3) {
        html += '<div class="text-xs text-gray-400 pl-1 cursor-pointer hover:text-accent transition-colors" data-day-events="' + dateStr + '">+' + (dayEvents.length - 2) + ' más</div>';
      }

      html += '</div>';
      html += '</div>';
    }

    // Completar última fila
    var totalCells = offset + daysInMonth;
    var remaining = totalCells % 7;
    if (remaining > 0) {
      for (var r = 0; r < 7 - remaining; r++) {
        html += '<div class="bg-gray-50/50 min-h-[96px] p-2"></div>';
      }
    }

    grid.innerHTML = html;

    // Bind event click handlers
    grid.querySelectorAll('.evento-badge').forEach(function(badge) {
      badge.addEventListener('click', function(e) {
        e.stopPropagation();
        var id = parseInt(badge.getAttribute('data-event-id'));
        var ev = events.find(function(ev) { return ev.id === id; });
        if (ev) openEventoModal(ev);
      });
    });

    // Bind "+X más" handlers
    grid.querySelectorAll('[data-day-events]').forEach(function(el) {
      el.addEventListener('click', function(e) {
        e.stopPropagation();
        var dateStr = el.getAttribute('data-day-events');
        var dayEvents = events.filter(function(ev) {
          if (!ev.fecha_inicio) return false;
          var evStart = ev.fecha_inicio.substring(0, 10);
          var evEnd = ev.fecha_fin ? ev.fecha_fin.substring(0, 10) : evStart;
          return dateStr >= evStart && dateStr <= evEnd;
        });
        if (dayEvents.length > 0) {
          showDayEvents(dateStr, dayEvents);
        }
      });
    });

    // Mobile events list
    renderMobileEvents();
  }

  function renderMobileEvents() {
    var mobile = document.getElementById('events-list-mobile');
    if (!mobile || events.length === 0) {
      if (mobile) mobile.innerHTML = '<div class="text-center py-10"><svg class="w-10 h-10 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-width="1.5"/><line x1="16" y1="2" x2="16" y2="6" stroke-width="1.5"/><line x1="8" y1="2" x2="8" y2="6" stroke-width="1.5"/><line x1="3" y1="10" x2="21" y2="10" stroke-width="1.5"/></svg><p class="text-sm text-gray-400">No hay eventos este mes</p></div>';
      return;
    }

    var grouped = {};
    events.forEach(function(ev) {
      var d = ev.fecha_inicio ? ev.fecha_inicio.split('T')[0] : null;
      if (!d) return;
      if (!grouped[d]) grouped[d] = [];
      grouped[d].push(ev);
    });

    var html = '';
    Object.keys(grouped).sort().forEach(function(dateKey) {
      var dateEvents = grouped[dateKey];
      html += '<div class="mb-4">';
      html += '<h3 class="text-sm font-semibold text-gray-500 mb-2 uppercase tracking-wider">' + formatDate(dateKey) + '</h3>';
      dateEvents.forEach(function(ev) {
        var color = getEventColor(ev);
        var abbr = getMinistryAbbr(ev.ministry_nombre || '');
        var isStart = !isMultiDay(ev) || eventDaysInMonth(ev)[0] === dateKey;

        html += '<div class="evento-badge flex items-center gap-3 p-3 bg-white rounded-lg border border-gray-200 mb-2 cursor-pointer hover:border-accent/40 hover:shadow-sm transition-all" data-event-id="' + ev.id + '" style="border-left: 4px solid ' + color + '">';
        html += '<div class="flex-1 min-w-0">';
        html += '<p class="text-sm font-medium text-gray-900 truncate">' + ev.titulo + '</p>';
        var timeInfo = '';
        if (isAllDay(ev)) {
          timeInfo = 'Todo el día';
        } else {
          timeInfo = fmtTime(ev.hora_inicio) + (ev.hora_fin ? ' - ' + fmtTime(ev.hora_fin) : '');
        }
        if (isMultiDay(ev) && isStart) {
          timeInfo += ' &middot; Hasta ' + (ev.fecha_fin ? new Date(ev.fecha_fin).toLocaleDateString('es-PY', { day: 'numeric', month: 'short' }) : '');
        }
        html += '<p class="text-xs text-gray-500 mt-0.5">' + timeInfo + (ev.ubicacion ? ' &middot; ' + ev.ubicacion : '') + '</p>';
        html += '</div>';
        html += '<div class="flex flex-col items-end gap-1 shrink-0">';
        html += '<span class="text-[10px] px-1.5 py-0.5 rounded font-semibold leading-none" style="background:' + color + ';color:#fff">' + abbr + '</span>';
        if (ev.tipo === 'compartido' && ev.ministerios_relacionados_nombres && ev.ministerios_relacionados_nombres.length > 0) {
          html += '<span class="text-[9px] text-gray-400">◇ compartido</span>';
        }
        html += '</div>';
        html += '</div>';
      });
      html += '</div>';
    });

    mobile.innerHTML = html;

    mobile.querySelectorAll('.evento-badge').forEach(function(el) {
      el.addEventListener('click', function() {
        var id = parseInt(el.getAttribute('data-event-id'));
        var ev = events.find(function(ev) { return ev.id === id; });
        if (ev) openEventoModal(ev);
      });
    });
  }

  function showDayEvents(dateStr, dayEvents) {
    var content = document.getElementById('evento-modal-content');

    var html = '<h3 class="text-lg font-semibold text-gray-900 mb-1">' + formatDate(dateStr) + '</h3>';
    html += '<p class="text-sm text-gray-500 mb-4">' + dayEvents.length + ' evento' + (dayEvents.length !== 1 ? 's' : '') + '</p>';
    html += '<div class="space-y-3 max-h-96 overflow-y-auto">';

    dayEvents.forEach(function(ev) {
      var color = getEventColor(ev);
      var abbr = getMinistryAbbr(ev.ministry_nombre || '');

      html += '<div class="p-3 rounded-lg border border-gray-100 hover:border-accent/20 transition-colors" style="border-left: 4px solid ' + color + '">';
      html += '<div class="flex items-center gap-2 mb-1">';
      html += '<span class="text-[10px] px-1.5 py-0.5 rounded font-semibold leading-none" style="background:' + color + ';color:#fff">' + abbr + '</span>';
      if (ev.tipo === 'compartido' && ev.ministerios_relacionados_nombres && ev.ministerios_relacionados_nombres.length > 0) {
        html += '<span class="text-[10px] text-gray-400">◇ compartido</span>';
      }
      html += '</div>';
      html += '<p class="font-medium text-gray-900">' + ev.titulo + '</p>';
      if (isAllDay(ev)) {
        html += '<p class="text-sm text-gray-500 mt-1">Todo el día';
        if (isMultiDay(ev)) html += ' &middot; Hasta ' + formatDateRange(ev.fecha_inicio, ev.fecha_fin);
        html += '</p>';
      } else {
        html += '<p class="text-sm text-gray-500 mt-1">' + fmtTime(ev.hora_inicio) + (ev.hora_fin ? ' &mdash; ' + fmtTime(ev.hora_fin) : '');
        if (isMultiDay(ev)) html += ' &middot; Hasta ' + formatDateRange(ev.fecha_inicio, ev.fecha_fin);
        html += '</p>';
      }
      if (ev.ubicacion) html += '<p class="text-sm text-gray-500">📍 ' + ev.ubicacion + '</p>';
      if (ev.descripcion) html += '<p class="text-sm text-gray-600 mt-2">' + ev.descripcion + '</p>';
      html += '<p class="text-xs text-gray-400 mt-2">' + (ev.ministry_nombre || '') + ' &middot; Creado por ' + (ev.creado_por_nombre || '—') + '</p>';
      html += '</div>';
    });

    html += '</div>';

    content.innerHTML = html;
    document.getElementById('evento-modal').classList.remove('hidden');
    document.getElementById('evento-modal').classList.add('flex');
  }

  function formatDateRange(start, end) {
    var s = new Date(start);
    var e = new Date(end);
    var opts = { day: 'numeric', month: 'short' };
    return s.toLocaleDateString('es-PY', opts) + ' &mdash; ' + e.toLocaleDateString('es-PY', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function openEventoModal(ev) {
    var content = document.getElementById('evento-modal-content');
    var color = getEventColor(ev);
    var abbr = getMinistryAbbr(ev.ministry_nombre || '');

    var html = '';
    html += '<div class="flex items-center gap-2 mb-3">';
    html += '<div class="w-3 h-3 rounded-full shrink-0" style="background-color:' + color + '"></div>';
    html += '<span class="text-[10px] px-1.5 py-0.5 rounded font-semibold leading-none" style="background:' + color + ';color:#fff">' + abbr + '</span>';
    if (ev.tipo === 'compartido' && ev.ministerios_relacionados_nombres && ev.ministerios_relacionados_nombres.length > 0) {
      html += '<span class="text-xs text-gray-400">◇ compartido</span>';
    }
    html += '</div>';
    html += '<h3 class="text-xl font-semibold text-gray-900">' + ev.titulo + '</h3>';
    html += '<p class="text-sm text-gray-500 mt-1">' + (ev.ministry_nombre || '') + '</p>';
    html += '<div class="mt-4 space-y-3">';
    html += '<div class="flex items-center gap-2 text-sm"><span class="text-gray-400 shrink-0 w-5 text-center">🕐</span><div><span class="text-gray-700">' + formatDate(ev.fecha_inicio) + '</span>';
    if (isAllDay(ev)) {
      html += ' <span class="text-gray-500">&middot; Todo el día</span>';
    } else {
      html += ' <span class="text-gray-500">&middot; ' + fmtTime(ev.hora_inicio) + (ev.hora_fin ? ' - ' + fmtTime(ev.hora_fin) : '') + '</span>';
    }
    if (isMultiDay(ev)) {
      html += '<br><span class="text-gray-500 text-xs">Hasta el ' + formatDateRange(ev.fecha_inicio, ev.fecha_fin) + '</span>';
    }
    html += '</div></div>';
    if (ev.ubicacion) html += '<div class="flex items-center gap-2 text-sm"><span class="text-gray-400 shrink-0 w-5 text-center">📍</span><span class="text-gray-700">' + ev.ubicacion + '</span></div>';
    if (ev.tipo === 'compartido' && ev.ministerios_relacionados_nombres && ev.ministerios_relacionados_nombres.length > 0) {
      html += '<div class="flex items-center gap-2 text-sm"><span class="text-gray-400 shrink-0 w-5 text-center">👥</span><span class="text-gray-700">Compartido con: ' + ev.ministerios_relacionados_nombres.join(', ') + '</span></div>';
    }
    if (ev.descripcion) html += '<div class="mt-3 pt-3 border-t border-gray-100"><p class="text-sm text-gray-600">' + ev.descripcion + '</p></div>';
    html += '<p class="text-xs text-gray-400 mt-4">Creado por ' + (ev.creado_por_nombre || '—') + ' &middot; ' + formatDate(ev.created_at || ev.fecha_inicio) + '</p>';
    html += '</div>';

    content.innerHTML = html;
    document.getElementById('evento-modal').classList.remove('hidden');
    document.getElementById('evento-modal').classList.add('flex');
  }

  function closeModal() {
    document.getElementById('evento-modal').classList.add('hidden');
    document.getElementById('evento-modal').classList.remove('flex');
  }

  async function navigateMonth(delta) {
    month += delta;
    if (month > 12) { month = 1; year++; }
    if (month < 1) { month = 12; year--; }
    await loadCalendario();
  }

  async function init() {
    if (unsub) { unsub(); unsub = null; }

    unsub = authStore.subscribe(function(state) {
      if (!state.isLoading) {
        if (!state.isAuthenticated) {
          window.location.href = '/login';
          return;
        }
      }
    });

    await authStore.checkAuth();
    if (!authStore.getState().isAuthenticated) return;

    await loadMinisterios();
    await loadCalendario();

    document.getElementById('btn-prev-month').addEventListener('click', function() { navigateMonth(-1); });
    document.getElementById('btn-next-month').addEventListener('click', function() { navigateMonth(1); });
    document.getElementById('btn-today').addEventListener('click', async function() {
      var ahora = new Date();
      year = ahora.getFullYear();
      month = ahora.getMonth() + 1;
      await loadCalendario();
    });
    document.getElementById('filter-ministerio').addEventListener('change', async function() {
      await loadCalendario();
    });

    var closeBtn = document.getElementById('evento-modal-close');
    var backdrop = document.getElementById('evento-modal-backdrop');
    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeModal();
    });
  }

  document.addEventListener('astro:page-load', function() {
    if (document.getElementById('calendario-page')) init();
  });

  document.addEventListener('astro:before-swap', function() {
    if (unsub) { unsub(); unsub = null; }
  });
</script>
