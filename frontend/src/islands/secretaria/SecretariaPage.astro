---
const TABS = ['estadisticas', 'directorio', 'actas', 'solicitudes', 'visitas', 'comunicados', 'historial', 'whatsapp'];
const TAB_LABELS: Record<string, string> = {
  estadisticas: 'Estadísticas',
  directorio: 'Directorio',
  actas: 'Actas',
  solicitudes: 'Solicitudes',
  visitas: 'Visitas',
  comunicados: 'Comunicados',
  historial: 'Historial',
  whatsapp: 'WhatsApp',
};
---

<div id="sec-page">
  <!-- Loading skeleton -->
  <div id="sec-skeleton" class="space-y-4 animate-pulse">
    <div class="h-10 bg-gray-200 rounded w-1/2"></div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {[1,2,3,4].map(() => <div class="h-28 bg-gray-100 rounded-lg"></div>)}
    </div>
    <div class="h-64 bg-gray-100 rounded-lg"></div>
  </div>

  <!-- Main content -->
  <div id="sec-content" class="hidden">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Secretaría</h1>
        <p class="text-sm text-gray-500 mt-0.5">Gestión administrativa de la iglesia</p>
      </div>
    </div>

    <!-- Tabs -->
    <div id="sec-tabs" class="flex gap-0 overflow-x-auto border-b border-gray-200 mb-6 -mx-2 px-2">
      {TABS.map((tab, i) => (
        <button
          type="button"
          data-tab={tab}
          class={`sec-tab-btn inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 transition-colors whitespace-nowrap ${i === 0 ? 'border-accent text-accent' : 'border-transparent text-gray-500 hover:text-gray-700'}`}
        >
          {TAB_LABELS[tab]}
        </button>
      ))}
    </div>

    <!-- Content area -->
    <div id="sec-content-area"></div>
  </div>
</div>

<script>
  import { secretariaStore } from '../../stores/secretaria';
  import { showError as toastError, showSuccess as toastSuccess } from '../../utils/toast';

  var activeTab = 'estadisticas';
  var contentArea: HTMLElement | null = null;
  var waQrPollInterval: number | null = null;
  var searchDebounceTimeout: number | null = null;

  function fmt(d: string) {
    if (!d) return '—';
    return new Date(d).toLocaleDateString('es-PY');
  }

  function estadoBadge(estado: string) {
    const map: Record<string, string> = {
      borrador: 'bg-yellow-100 text-yellow-800',
      aprobada: 'bg-green-100 text-green-800',
      archivada: 'bg-gray-100 text-gray-700',
      pendiente: 'bg-yellow-100 text-yellow-800',
      en_proceso: 'bg-blue-100 text-blue-800',
      rechazada: 'bg-red-100 text-red-800',
      sin_seguimiento: 'bg-gray-100 text-gray-700',
      contactado: 'bg-blue-100 text-blue-800',
      integrado: 'bg-green-100 text-green-800',
      no_regreso: 'bg-red-100 text-red-800',
    };
    return map[estado] || 'bg-gray-100 text-gray-700';
  }

  function setupTabs() {
    var tabsEl = document.getElementById('sec-tabs');
    if (!tabsEl) return;
    tabsEl.addEventListener('click', function(e: Event) {
      var btn = (e.target as HTMLElement).closest('[data-tab]') as HTMLElement;
      if (!btn) return;
      var tab = btn.dataset.tab!;
      if (tab === activeTab) return;
      activeTab = tab;
      document.querySelectorAll('.sec-tab-btn').forEach(function(b: Element) {
        var el = b as HTMLElement;
        el.className = el.className
          .replace('border-accent text-accent', '')
          .replace('border-transparent text-gray-500 hover:text-gray-700', '');
        if (el.dataset.tab === tab) {
          el.className += ' border-accent text-accent';
        } else {
          el.className += ' border-transparent text-gray-500 hover:text-gray-700';
        }
      });
      loadTab(tab);
    });
  }

  async function loadTab(tab: string) {
    if (!contentArea) return;
    contentArea.innerHTML = '<div class="animate-pulse space-y-3"><div class="h-10 bg-gray-100 rounded"></div><div class="h-64 bg-gray-100 rounded"></div></div>';
    try {
      switch (tab) {
        case 'estadisticas':
          await secretariaStore.fetchEstadisticas();
          contentArea.innerHTML = renderEstadisticasTab(secretariaStore.getState().estadisticas);
          break;
        case 'directorio':
          contentArea.innerHTML = renderDirectorioTab();
          break;
        case 'actas':
          await secretariaStore.fetchActas();
          contentArea.innerHTML = renderActasTab(secretariaStore.getState().actas);
          bindActasForm();
          break;
        case 'solicitudes':
          await secretariaStore.fetchSolicitudes();
          contentArea.innerHTML = renderSolicitudesTab(secretariaStore.getState().solicitudes);
          bindSolicitudesForm();
          break;
        case 'visitas':
          await secretariaStore.fetchVisitas();
          contentArea.innerHTML = renderVisitasTab(secretariaStore.getState().visitas);
          bindVisitasForm();
          break;
        case 'comunicados':
          await secretariaStore.fetchComunicados({});
          contentArea.innerHTML = renderComunicadosTab(secretariaStore.getState().comunicados);
          bindComunicadosForm();
          break;
        case 'historial':
          contentArea.innerHTML = renderHistorialTab([]);
          bindHistorialForm();
          break;
        case 'whatsapp':
          await Promise.all([
            secretariaStore.fetchWaStatus(),
            secretariaStore.fetchWaConfig(),
            secretariaStore.fetchWaMensajes(),
            secretariaStore.fetchWaHistorial(),
          ]);
          contentArea.innerHTML = renderWhatsAppTab(secretariaStore.getState());
          bindWhatsAppForm();
          startQrPoll();
          break;
      }
    } catch (e: any) {
      toastError(e.message || 'Error al cargar');
    }
  }

  // ─── ESTADÍSTICAS ──────────────────────────────────────────────────────────

  function renderEstadisticasTab(est: any) {
    if (!est) return '<p class="text-gray-500">Sin datos.</p>';
    var cards = [
      { label: 'Miembros Activos', value: est.total_activos, color: 'text-blue-600 bg-blue-50' },
      { label: 'Visitantes sin Seguimiento', value: est.visitantes_sin_seguimiento, color: 'text-orange-600 bg-orange-50' },
      { label: 'Solicitudes Pendientes', value: est.solicitudes_pendientes, color: 'text-yellow-600 bg-yellow-50' },
      { label: 'Actas este Mes', value: est.actas_mes, color: 'text-green-600 bg-green-50' },
      { label: 'Miembros Inactivos', value: est.total_inactivos, color: 'text-gray-600 bg-gray-50' },
      { label: 'Nuevos (30 días)', value: est.nuevos_ultimo_mes, color: 'text-purple-600 bg-purple-50' },
      { label: 'Actas Borrador', value: est.actas_pendientes, color: 'text-yellow-600 bg-yellow-50' },
      { label: 'Comunicados Publicados', value: est.comunicados_publicados, color: 'text-teal-600 bg-teal-50' },
    ];
    var h = '<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">';
    cards.forEach(function(c) {
      h += '<div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm">';
      h += '<p class="text-sm text-gray-500 mb-1">' + c.label + '</p>';
      h += '<p class="text-3xl font-bold ' + c.color.split(' ')[0] + '">' + c.value + '</p>';
      h += '</div>';
    });
    h += '</div>';

    if (est.por_ministerio && est.por_ministerio.length) {
      h += '<div class="bg-white border border-gray-100 rounded-xl p-6 shadow-sm mb-6">';
      h += '<h3 class="font-semibold text-gray-700 mb-4">Miembros por Ministerio</h3>';
      h += '<div class="space-y-2">';
      est.por_ministerio.forEach(function(m: any) {
        var pct = est.total_activos ? Math.round((m.miembros_activos / est.total_activos) * 100) : 0;
        h += '<div class="flex items-center gap-3">';
        h += '<span class="text-sm text-gray-600 w-40 truncate">' + m.nombre + '</span>';
        h += '<div class="flex-1 bg-gray-100 rounded-full h-2"><div class="bg-accent h-2 rounded-full" style="width:' + pct + '%"></div></div>';
        h += '<span class="text-sm font-medium text-gray-700 w-8 text-right">' + m.miembros_activos + '</span>';
        h += '</div>';
      });
      h += '</div></div>';
    }

    if (est.por_clase && est.por_clase.length) {
      h += '<div class="bg-white border border-gray-100 rounded-xl p-6 shadow-sm mb-6">';
      h += '<h3 class="font-semibold text-gray-700 mb-4">Miembros por Clase</h3>';
      h += '<div class="space-y-2">';
      var maxClase = Math.max(...est.por_clase.map((c: any) => c.cantidad));
      est.por_clase.forEach(function(c: any) {
        var pct = maxClase ? Math.round((c.cantidad / maxClase) * 100) : 0;
        h += '<div class="flex items-center gap-3">';
        h += '<span class="text-sm text-gray-600 w-40 truncate capitalize">' + (c.clase || 'Sin clasificar') + '</span>';
        h += '<div class="flex-1 bg-gray-100 rounded-full h-2"><div class="bg-blue-500 h-2 rounded-full" style="width:' + pct + '%"></div></div>';
        h += '<span class="text-sm font-medium text-gray-700 w-8 text-right">' + c.cantidad + '</span>';
        h += '</div>';
      });
      h += '</div></div>';
    }
    return h;
  }

  // ─── DIRECTORIO ────────────────────────────────────────────────────────────

  function renderDirectorioTab() {
    return `
      <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-6">
        <div class="flex flex-col sm:flex-row gap-3 justify-between mb-6">
          <h3 class="font-semibold text-gray-800 text-lg">Directorio de Miembros</h3>
          <div class="flex gap-2">
            <a href="/api/v1/secretaria/directorio/exportar_excel/" target="_blank"
               class="inline-flex items-center gap-1.5 px-3 py-2 text-sm bg-green-600 text-white rounded-lg hover:bg-green-700">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
              Excel
            </a>
            <a href="/api/v1/secretaria/directorio/exportar_pdf/" target="_blank"
               class="inline-flex items-center gap-1.5 px-3 py-2 text-sm bg-red-600 text-white rounded-lg hover:bg-red-700">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              PDF
            </a>
          </div>
        </div>
        <p class="text-gray-500 text-sm">Usa los botones para descargar el directorio completo en Excel o PDF.</p>
        <p class="text-gray-400 text-xs mt-2">Filtros disponibles via URL: <code>?ministerio=slug&activo=true&clase=jovenes</code></p>
      </div>`;
  }

  // ─── ACTAS ─────────────────────────────────────────────────────────────────

  function renderActasTab(actas: any[]) {
    var h = '<div class="space-y-4">';
    h += '<div class="flex items-center justify-between">';
    h += '<h3 class="font-semibold text-gray-800 text-lg">Actas de Reunión</h3>';
    h += '<button id="acta-add-btn" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm bg-primary text-white rounded-lg hover:bg-primary/90">+ Nueva Acta</button>';
    h += '</div>';

    h += '<div id="acta-form" class="hidden bg-white border border-gray-200 rounded-xl p-5 shadow-sm space-y-3">';
    h += '<h4 class="font-medium text-gray-700">Nueva Acta</h4>';
    h += '<div class="grid grid-cols-1 md:grid-cols-2 gap-3">';
    h += '<input id="af-titulo" placeholder="Título del acta" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<select id="af-tipo" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<option value="">Tipo de reunión...</option>';
    h += '<option value="junta_directiva">Junta Directiva</option>';
    h += '<option value="concilio">Concilio</option>';
    h += '<option value="comite">Comité</option>';
    h += '<option value="otra">Otra</option>';
    h += '</select>';
    h += '<input id="af-fecha" type="date" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<input id="af-lugar" placeholder="Lugar" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<input id="af-presidente" placeholder="Presidida por" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '</div>';
    h += '<textarea id="af-observaciones" placeholder="Observaciones (opcional)" rows="2" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent"></textarea>';
    h += '<div class="flex gap-2">';
    h += '<button id="acta-save-btn" class="px-4 py-2 text-sm bg-primary text-white rounded-lg hover:bg-primary/90">Guardar</button>';
    h += '<button id="acta-cancel-btn" class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-lg">Cancelar</button>';
    h += '</div></div>';

    h += '<div class="bg-white border border-gray-100 rounded-xl p-4 shadow-sm">';
    h += '<div class="grid grid-cols-1 md:grid-cols-4 gap-3">';
    h += '<input id="acta-search" placeholder="Buscar actas..." class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<input id="acta-fecha-desde" type="date" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<input id="acta-fecha-hasta" type="date" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<button id="acta-filter-btn" class="px-4 py-2 text-sm bg-accent text-white rounded-lg hover:bg-accent/90">Filtrar</button>';
    h += '</div></div>';

    if (!actas.length) {
      h += '<div class="text-center py-12 text-gray-400"><p class="text-lg">Sin actas registradas</p></div>';
    } else {
      h += '<div class="space-y-3">';
      actas.forEach(function(a: any) {
        h += '<div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">';
        h += '<div class="flex items-start justify-between gap-3">';
        h += '<div class="flex-1 min-w-0">';
        h += '<div class="flex items-center gap-2 flex-wrap mb-1">';
        h += '<h4 class="font-semibold text-gray-800">' + a.titulo + '</h4>';
        h += '<span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium ' + estadoBadge(a.estado) + '">' + a.estado_display + '</span>';
        h += '</div>';
        h += '<p class="text-sm text-gray-500">' + a.tipo_display + ' · ' + fmt(a.fecha_reunion) + (a.lugar ? ' · ' + a.lugar : '') + '</p>';
        if (a.presidida_por) h += '<p class="text-xs text-gray-400 mt-1">Presidida por: ' + a.presidida_por + '</p>';
        h += '</div>';
        h += '<div class="flex gap-1 flex-shrink-0">';
        if (a.estado === 'borrador') {
          h += '<button class="acta-aprobar-btn px-2.5 py-1.5 text-xs bg-green-600 text-white rounded-lg hover:bg-green-700" data-id="' + a.id + '">Aprobar</button>';
        }
        h += '<a href="/api/v1/secretaria/actas/' + a.id + '/generar_pdf/" target="_blank" class="px-2.5 py-1.5 text-xs bg-red-600 text-white rounded-lg hover:bg-red-700">PDF</a>';
        h += '<button class="acta-del-btn px-2.5 py-1.5 text-xs text-red-500 hover:bg-red-50 rounded-lg" data-id="' + a.id + '">Eliminar</button>';
        h += '</div></div></div>';
      });
      h += '</div>';
    }
    h += '</div>';
    return h;
  }

  function bindActasForm() {
    var addBtn = document.getElementById('acta-add-btn');
    var form = document.getElementById('acta-form');
    var saveBtn = document.getElementById('acta-save-btn');
    var cancelBtn = document.getElementById('acta-cancel-btn');
    var searchInput = document.getElementById('acta-search') as HTMLInputElement;
    var filterBtn = document.getElementById('acta-filter-btn');

    if (addBtn) addBtn.onclick = () => form?.classList.toggle('hidden');
    if (cancelBtn) cancelBtn.onclick = () => form?.classList.add('hidden');

    if (searchInput) {
      searchInput.oninput = function() {
        if (searchDebounceTimeout) clearTimeout(searchDebounceTimeout);
        searchDebounceTimeout = setTimeout(function() {
          if (filterBtn) (filterBtn as HTMLElement).click();
        }, 300) as unknown as number;
      };
    }

    if (filterBtn) {
      filterBtn.onclick = async function() {
        var search = (document.getElementById('acta-search') as HTMLInputElement)?.value.trim();
        var fechaDesde = (document.getElementById('acta-fecha-desde') as HTMLInputElement)?.value;
        var fechaHasta = (document.getElementById('acta-fecha-hasta') as HTMLInputElement)?.value;
        try {
          await secretariaStore.fetchActas({ search, fecha_desde: fechaDesde, fecha_hasta: fechaHasta });
          contentArea!.innerHTML = renderActasTab(secretariaStore.getState().actas);
          bindActasForm();
        } catch (e: any) { toastError(e.message); }
      };
    }

    if (saveBtn) saveBtn.onclick = async function() {
      var titulo = (document.getElementById('af-titulo') as HTMLInputElement)?.value.trim();
      var tipo = (document.getElementById('af-tipo') as HTMLSelectElement)?.value;
      var fecha = (document.getElementById('af-fecha') as HTMLInputElement)?.value;
      if (!titulo || !tipo || !fecha) { toastError('Título, tipo y fecha son requeridos.'); return; }
      try {
        await secretariaStore.createActa({ titulo, tipo, fecha_reunion: fecha,
          lugar: (document.getElementById('af-lugar') as HTMLInputElement)?.value,
          presidida_por: (document.getElementById('af-presidente') as HTMLInputElement)?.value,
          observaciones: (document.getElementById('af-observaciones') as HTMLTextAreaElement)?.value,
        });
        toastSuccess('Acta creada');
        loadTab('actas');
      } catch(e: any) { toastError(e.message); }
    };

    document.querySelectorAll('.acta-aprobar-btn').forEach(function(btn) {
      (btn as HTMLElement).onclick = async function() {
        var id = parseInt((btn as HTMLElement).dataset.id!);
        try { await secretariaStore.aprobarActa(id); toastSuccess('Acta aprobada'); loadTab('actas'); }
        catch(e: any) { toastError(e.message); }
      };
    });

    document.querySelectorAll('.acta-del-btn').forEach(function(btn) {
      (btn as HTMLElement).onclick = async function() {
        if (!confirm('¿Eliminar esta acta?')) return;
        var id = parseInt((btn as HTMLElement).dataset.id!);
        try { await secretariaStore.deleteActa(id); toastSuccess('Acta eliminada'); loadTab('actas'); }
        catch(e: any) { toastError(e.message); }
      };
    });
  }

  // ─── SOLICITUDES ───────────────────────────────────────────────────────────

  function renderSolicitudesTab(solicitudes: any[]) {
    var h = '<div class="space-y-4">';
    h += '<div class="flex items-center justify-between">';
    h += '<h3 class="font-semibold text-gray-800 text-lg">Solicitudes y Trámites</h3>';
    h += '<button id="sol-add-btn" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm bg-primary text-white rounded-lg hover:bg-primary/90">+ Nueva Solicitud</button>';
    h += '</div>';

    h += '<div id="sol-form" class="hidden bg-white border border-gray-200 rounded-xl p-5 shadow-sm space-y-3">';
    h += '<h4 class="font-medium text-gray-700">Nueva Solicitud</h4>';
    h += '<div class="grid grid-cols-1 md:grid-cols-2 gap-3">';
    h += '<input id="sf-nombre" placeholder="Nombre del solicitante" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<select id="sf-tipo" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md">';
    h += '<option value="">Tipo de solicitud...</option>';
    [['membresia','Solicitud de Membresía'],['carta_recomendacion','Carta de Recomendación'],
     ['carta_membresia','Carta de Membresía'],['transferencia','Transferencia'],
     ['bautismo','Bautismo'],['matrimonio','Matrimonio'],['retiro','Retiro Voluntario'],['otra','Otra']
    ].forEach(function(o) { h += '<option value="' + o[0] + '">' + o[1] + '</option>'; });
    h += '</select>';
    h += '<select id="sf-prioridad" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md">';
    h += '<option value="media">Prioridad Media</option><option value="alta">Alta</option><option value="baja">Baja</option>';
    h += '</select>';
    h += '</div>';
    h += '<textarea id="sf-desc" placeholder="Descripción" rows="2" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent"></textarea>';
    h += '<div class="flex gap-2">';
    h += '<button id="sol-save-btn" class="px-4 py-2 text-sm bg-primary text-white rounded-lg">Guardar</button>';
    h += '<button id="sol-cancel-btn" class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-lg">Cancelar</button>';
    h += '</div></div>';

    h += '<div class="bg-white border border-gray-100 rounded-xl p-4 shadow-sm">';
    h += '<div class="grid grid-cols-1 md:grid-cols-5 gap-3">';
    h += '<input id="sol-search" placeholder="Buscar solicitudes..." class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<input id="sol-fecha-desde" type="date" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<input id="sol-fecha-hasta" type="date" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<button id="sol-filter-btn" class="px-4 py-2 text-sm bg-accent text-white rounded-lg hover:bg-accent/90">Filtrar</button>';
    h += '<button id="sol-export-btn" class="px-4 py-2 text-sm bg-green-600 text-white rounded-lg hover:bg-green-700">Exportar PDF</button>';
    h += '</div></div>';

    if (!solicitudes.length) {
      h += '<div class="text-center py-12 text-gray-400">Sin solicitudes registradas</div>';
    } else {
