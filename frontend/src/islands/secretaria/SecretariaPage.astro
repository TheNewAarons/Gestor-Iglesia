    };

    if (addBtn) addBtn.onclick = function() { resetForm(); form?.classList.toggle('hidden'); };
    if (cancelBtn) cancelBtn.onclick = () => { form?.classList.add('hidden'); resetForm(); };

    if (destSelect) {
      destSelect.onchange = function() {
        if (destSelect.value === 'ministerio') {
          ministeriosContainer?.classList.remove('hidden');
        } else {
          ministeriosContainer?.classList.add('hidden');
          selectedMinisterios = [];
          if (ministeriosInput) ministeriosInput.value = '';
        }
      };
    }

    if (ministeriosInput) {
      ministeriosInput.oninput = async function() {
        var query = ministeriosInput.value.trim();
        var list = document.getElementById('cf-ministerios-list');
        if (!query || !list) return;
        try {
          var data = await api.get<any>('/ministerios/?search=' + encodeURIComponent(query));
          var items = data.results || data;
          list.innerHTML = '';
          items.slice(0, 10).forEach(function(m: any) {
            var isSelected = selectedMinisterios.includes(m.id);
            var label = document.createElement('label');
            label.className = 'flex items-center gap-2 p-2 hover:bg-gray-100 rounded cursor-pointer';
            label.innerHTML = '<input type="checkbox" class="w-4 h-4 text-accent" ' + (isSelected ? 'checked' : '') + ' data-id="' + m.id + '"><span class="text-sm text-gray-700">' + m.nombre + '</span>';
            var checkbox = label.querySelector('input[type="checkbox"]') as HTMLInputElement;
            checkbox.onchange = function() {
              if (checkbox.checked) {
                if (!selectedMinisterios.includes(m.id)) selectedMinisterios.push(m.id);
              } else {
                selectedMinisterios = selectedMinisterios.filter(function(x) { return x !== m.id; });
              }
            };
            list.appendChild(label);
          });
        } catch(e: any) { /* ignore */ }
      };
    }

    if (searchInput) {
      searchInput.oninput = function() {
        if (searchDebounceTimeout) clearTimeout(searchDebounceTimeout);
        searchDebounceTimeout = setTimeout(function() {
          if (filterBtn) (filterBtn as HTMLElement).click();
        }, 300) as unknown as number;
      };
    }

    if (filterBtn) {
      filterBtn.onclick = async function() {
        var search = (document.getElementById('com-search') as HTMLInputElement)?.value.trim();
        var fechaDesde = (document.getElementById('com-fecha-desde') as HTMLInputElement)?.value;
        var fechaHasta = (document.getElementById('com-fecha-hasta') as HTMLInputElement)?.value;
        try {
          await secretariaStore.fetchComunicados({ search, fecha_desde: fechaDesde, fecha_hasta: fechaHasta });
          contentArea!.innerHTML = renderComunicadosTab(secretariaStore.getState().comunicados);
          bindComunicadosForm();
        } catch (e: any) { toastError(e.message); }
      };
    }

    if (saveBtn) saveBtn.onclick = async function() {
      var id = (document.getElementById('cf-id') as HTMLInputElement)?.value;
      var titulo = (document.getElementById('cf-titulo') as HTMLInputElement)?.value.trim();
      var contenido = (document.getElementById('cf-contenido') as HTMLTextAreaElement)?.value.trim();
      if (!titulo || !contenido) { toastError('Título y contenido requeridos.'); return; }
      try {
        var data: any = {
          titulo, contenido,
          destinatarios: (document.getElementById('cf-dest') as HTMLSelectElement)?.value,
        };
        if (data.destinatarios === 'ministerio' && selectedMinisterios.length) {
          data.ministerios_destino = selectedMinisterios;
        }
        if (id) {
          await secretariaStore.updateComunicado(parseInt(id), data);
        } else {
          await secretariaStore.createComunicado(data);
        }
        toastSuccess(id ? 'Comunicado actualizado' : 'Comunicado guardado');
        loadTab('comunicados');
      } catch(e: any) { toastError(e.message); }
    };

    document.querySelectorAll('.com-edit-btn').forEach(function(btn) {
      (btn as HTMLElement).onclick = function() {
        var id = parseInt((btn as HTMLElement).dataset.id!);
        var com = secretariaStore.getState().comunicados.find(function(c) { return c.id === id; });
        if (!com) return;
        resetForm();
        (document.getElementById('cf-id') as HTMLInputElement).value = String(id);
        (document.getElementById('cf-titulo') as HTMLInputElement).value = com.titulo;
        (document.getElementById('cf-contenido') as HTMLTextAreaElement).value = com.contenido;
        (document.getElementById('cf-dest') as HTMLSelectElement).value = com.destinatarios;
        (document.getElementById('cf-title') as HTMLElement).textContent = 'Editar Comunicado';
        (document.getElementById('com-save-btn') as HTMLElement).textContent = 'Actualizar';
        if (com.destinatarios === 'ministerio') {
          selectedMinisterios = com.ministerios_destino || [];
          ministeriosContainer?.classList.remove('hidden');
        }
        form?.classList.remove('hidden');
      };
    });

    document.querySelectorAll('.com-pub-btn').forEach(function(btn) {
      (btn as HTMLElement).onclick = async function() {
        var id = parseInt((btn as HTMLElement).dataset.id!);
        try { await secretariaStore.publicarComunicado(id); toastSuccess('Comunicado publicado'); loadTab('comunicados'); }
        catch(e: any) { toastError(e.message); }
      };
    });

    document.querySelectorAll('.com-leido-btn').forEach(function(btn) {
      (btn as HTMLElement).onclick = async function() {
        var id = parseInt((btn as HTMLElement).dataset.id!);
        try { await secretariaStore.marcarLeido(id); toastSuccess('Marcado como leído'); }
        catch(e: any) { toastError(e.message); }
      };
    });

    document.querySelectorAll('.com-del-btn').forEach(function(btn) {
      (btn as HTMLElement).onclick = async function() {
        if (!confirm('¿Eliminar este comunicado?')) return;
        var id = parseInt((btn as HTMLElement).dataset.id!);
        try { await secretariaStore.deleteComunicado(id); toastSuccess('Comunicado eliminado'); loadTab('comunicados'); }
        catch(e: any) { toastError(e.message); }
      };
    });
  }

  // ─── HISTORIAL ─────────────────────────────────────────────────────────────

  function renderHistorialTab(historial: any[]) {
    var h = '<div class="space-y-4">';
    h += '<div class="flex items-center justify-between mb-3">';
    h += '<h3 class="font-semibold text-gray-800 text-lg">Historial de Estado de Miembros</h3>';
    h += '<button id="hist-add-btn" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm bg-primary text-white rounded-lg">+ Nuevo Evento</button>';
    h += '</div>';

    h += '<div id="hist-form" class="hidden bg-white border border-gray-200 rounded-xl p-5 shadow-sm space-y-3">';
    h += '<h4 class="font-medium text-gray-700">Registrar Evento</h4>';
    h += '<div class="grid grid-cols-1 md:grid-cols-2 gap-3">';
    h += '<input id="hf-miembro" type="number" placeholder="ID del miembro" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<select id="hf-evento" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<option value="">Tipo de evento...</option>';
    [['ingreso','Ingreso'],['transferencia_entrada','Transferencia Entrada'],['transferencia_salida','Transferencia Salida'],['bautismo','Bautismo'],['disciplina','Proceso Disciplinario'],['restauracion','Restauración'],['retiro_voluntario','Retiro Voluntario'],['fallecimiento','Fallecimiento'],['otra','Otra Anotación']].forEach(function(o) { h += '<option value="' + o[0] + '">' + o[1] + '</option>'; });
    h += '</select>';
    h += '<input id="hf-fecha" type="date" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '</div>';
    h += '<textarea id="hf-desc" placeholder="Descripción (opcional)" rows="2" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent"></textarea>';
    h += '<div class="grid grid-cols-1 md:grid-cols-2 gap-3">';
    h += '<input id="hf-iglesia-origen" placeholder="Iglesia origen (opcional)" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<input id="hf-iglesia-destino" placeholder="Iglesia destino (opcional)" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '</div>';
    h += '<div class="flex gap-2">';
    h += '<button id="hist-save-btn" class="px-4 py-2 text-sm bg-primary text-white rounded-lg hover:bg-primary/90">Guardar</button>';
    h += '<button id="hist-cancel-btn" class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-lg">Cancelar</button>';
    h += '</div></div>';

    h += '<div class="bg-white border border-gray-200 rounded-xl p-5">';
    h += '<div class="flex gap-3 mb-4">';
    h += '<input id="hist-search" placeholder="Buscar miembro por ID o nombre..." class="flex-1 px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<button id="hist-search-btn" class="px-4 py-2 text-sm bg-primary text-white rounded-lg">Buscar</button>';
    h += '</div>';
    h += '<div id="hist-result">';
    if (!historial.length) {
      h += '<p class="text-gray-400 text-sm text-center py-8">Ingresa un ID de miembro para ver su historial.</p>';
    } else {
      h += renderHistorialList(historial);
    }
    h += '</div></div></div>';
    return h;
  }

  function renderHistorialList(historial: any[]) {
    if (!historial.length) return '<p class="text-gray-400 text-sm text-center py-4">Sin historial para este miembro.</p>';
    var h = '<div class="relative">';
    h += '<div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200"></div>';
    h += '<div class="space-y-4 pl-10">';
    historial.forEach(function(item: any) {
      h += '<div class="relative">';
      h += '<div class="absolute -left-6 top-1 w-3 h-3 rounded-full bg-accent border-2 border-white"></div>';
      h += '<div class="bg-gray-50 rounded-lg p-4">';
      h += '<div class="flex items-center justify-between mb-1">';
      h += '<span class="font-medium text-gray-800 text-sm">' + item.evento_display + '</span>';
      h += '<span class="text-xs text-gray-400">' + fmt(item.fecha_evento) + '</span>';
      h += '</div>';
      if (item.descripcion) h += '<p class="text-sm text-gray-600">' + item.descripcion + '</p>';
      if (item.iglesia_origen) h += '<p class="text-xs text-gray-400">De: ' + item.iglesia_origen + '</p>';
      if (item.iglesia_destino) h += '<p class="text-xs text-gray-400">A: ' + item.iglesia_destino + '</p>';
      h += '<p class="text-xs text-gray-400 mt-1">Documentado por: ' + (item.documentado_por_nombre || '—') + '</p>';
      h += '</div></div>';
    });
    h += '</div></div>';
    return h;
  }

  function bindHistorialForm() {
    var addBtn = document.getElementById('hist-add-btn');
    var form = document.getElementById('hist-form');
    var saveBtn = document.getElementById('hist-save-btn');
    var cancelBtn = document.getElementById('hist-cancel-btn');

    if (addBtn) addBtn.onclick = () => form?.classList.toggle('hidden');
    if (cancelBtn) cancelBtn.onclick = () => form?.classList.add('hidden');

    if (saveBtn) saveBtn.onclick = async function() {
      var miembroId = parseInt((document.getElementById('hf-miembro') as HTMLInputElement)?.value);
      var evento = (document.getElementById('hf-evento') as HTMLSelectElement)?.value;
      var fecha = (document.getElementById('hf-fecha') as HTMLInputElement)?.value;
      if (!miembroId || !evento || !fecha) { toastError('ID miembro, evento y fecha son requeridos.'); return; }
      try {
        await secretariaStore.createHistorial({
          miembro: miembroId, evento, fecha_evento: fecha,
          descripcion: (document.getElementById('hf-desc') as HTMLTextAreaElement)?.value,
          iglesia_origen: (document.getElementById('hf-iglesia-origen') as HTMLInputElement)?.value,
          iglesia_destino: (document.getElementById('hf-iglesia-destino') as HTMLInputElement)?.value,
        });
        toastSuccess('Evento registrado'); loadTab('historial');
      } catch(e: any) { toastError(e.message); }
    };

    var searchBtn = document.getElementById('hist-search-btn');
    if (!searchBtn) return;
    searchBtn.onclick = async function() {
      var val = (document.getElementById('hist-search') as HTMLInputElement)?.value.trim();
      if (!val) return;
      var resultEl = document.getElementById('hist-result');
      if (resultEl) resultEl.innerHTML = '<div class="animate-pulse h-20 bg-gray-100 rounded"></div>';
      try {
        await secretariaStore.fetchHistorial(parseInt(val) || undefined);
        var hist = secretariaStore.getState().historial;
        if (resultEl) resultEl.innerHTML = renderHistorialList(hist);
      } catch(e: any) { toastError(e.message); }
    };
  }

  // ─── WHATSAPP ──────────────────────────────────────────────────────────────

  function renderWhatsAppTab(st: any) {
    var status = st.waStatus;
    var statusLabel: Record<string, string> = {
      connected: 'Conectado',
      qr_pending: 'Esperando QR',
      disconnected: 'Desconectado',
      unavailable: 'Servicio no disponible',
    };
    var statusColor: Record<string, string> = {
      connected: 'bg-green-100 text-green-800',
      qr_pending: 'bg-yellow-100 text-yellow-800',
      disconnected: 'bg-red-100 text-red-800',
      unavailable: 'bg-gray-100 text-gray-600',
    };
    var cfg = st.waConfig || {};

    var h = '<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">';

    // Panel izquierdo — conexión
    h += '<div class="space-y-4">';
    h += '<div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm">';
    h += '<h3 class="font-semibold text-gray-800 mb-4">Estado de Conexión</h3>';
    h += '<div class="flex items-center gap-3 mb-4">';
    h += '<span class="inline-flex px-3 py-1 rounded-full text-sm font-medium ' + (statusColor[status] || statusColor.disconnected) + '">' + (statusLabel[status] || status) + '</span>';
    h += '<button id="wa-refresh-btn" class="text-xs text-gray-400 hover:text-gray-600 underline">Actualizar</button>';
    h += '</div>';

    if (status === 'qr_pending') {
      h += '<div class="flex flex-col items-center py-4">';
      h += '<p class="text-sm text-gray-600 mb-3">Escanea el código QR con WhatsApp en tu teléfono</p>';
      if (st.waQr) {
        h += '<img id="wa-qr-img" src="' + st.waQr + '" class="w-48 h-48 border border-gray-200 rounded-lg" alt="QR Code">';
      } else {
        h += '<div id="wa-qr-img" class="w-48 h-48 bg-gray-100 rounded-lg flex items-center justify-center"><p class="text-xs text-gray-400">Cargando QR...</p></div>';
      }
      h += '</div>';
    }

    if (status === 'connected') {
      h += '<button id="wa-logout-btn" class="w-full py-2 text-sm text-red-600 border border-red-200 rounded-lg hover:bg-red-50">Desconectar sesión</button>';
    } else if (status === 'disconnected') {
      h += '<button id="wa-connect-btn" class="w-full py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700">Conectar</button>';
    } else if (status === 'unavailable') {
      h += '<p class="text-sm text-gray-500 bg-gray-50 rounded-lg p-3">Inicia el microservicio WhatsApp:<br><code class="text-xs bg-gray-100 px-2 py-0.5 rounded">cd whatsapp-service && npm start</code></p>';
    }
    h += '</div>';

    // Configuración
    h += '<div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm">';
    h += '<h3 class="font-semibold text-gray-800 mb-4">Configuración</h3>';
    h += '<div class="space-y-3">';
    h += '<div>';
    h += '<label class="block text-xs font-medium text-gray-600 mb-1">Group JID (ID del grupo WhatsApp)</label>';
    h += '<input id="wa-jid" value="' + (cfg.grupo_jid || '') + '" placeholder="ej: 120363xxxxxxxxx@g.us" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '<p class="text-xs text-gray-400 mt-1">El JID del grupo se obtiene enviando un mensaje al grupo con el bot conectado.</p>';
    h += '</div>';
    h += '<div>';
    h += '<label class="block text-xs font-medium text-gray-600 mb-1">Hora de envío (domingos)</label>';
    h += '<input id="wa-hora" type="time" value="' + (cfg.hora_envio || '09:00') + '" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent">';
    h += '</div>';
    h += '<div class="flex items-center gap-3">';
    h += '<input id="wa-activo" type="checkbox"' + (cfg.activo ? ' checked' : '') + ' class="w-4 h-4 text-accent">';
    h += '<label for="wa-activo" class="text-sm text-gray-700">Activar envío automático los domingos</label>';
    h += '</div>';
    h += '<button id="wa-save-config-btn" class="w-full py-2 text-sm bg-primary text-white rounded-lg hover:bg-primary/90">Guardar Configuración</button>';
    h += '</div></div>';

    h += '<button id="wa-test-btn" class="w-full py-2.5 text-sm bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium">Enviar Mensaje de Prueba Ahora</button>';
    h += '</div>';

    // Panel derecho — mensajes y historial
    h += '<div class="space-y-4">';
    h += '<div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm">';
    h += '<div class="flex items-center justify-between mb-4">';
    h += '<h3 class="font-semibold text-gray-800">Mensajes Rotatorios (5 variantes)</h3>';
    h += '<span class="text-xs text-gray-400">Siguiente: #' + (((cfg.rotacion_index || 0) % 5) + 1) + '</span>';
    h += '</div>';
    h += '<div class="space-y-3">';
    var mensajes: any[] = st.waMensajes || [];
    for (var n = 1; n <= 5; n++) {
      var msg = mensajes.find(function(m: any) { return m.numero === n; });
      var esSiguiente = ((cfg.rotacion_index || 0) % 5) + 1 === n;
      h += '<div class="border ' + (esSiguiente ? 'border-accent' : 'border-gray-200') + ' rounded-lg p-3">';
      h += '<div class="flex items-center gap-2 mb-2">';
      h += '<span class="text-xs font-semibold text-gray-500">MENSAJE #' + n + '</span>';
      if (esSiguiente) h += '<span class="text-xs bg-accent text-white px-1.5 py-0.5 rounded">Próximo</span>';
      h += '</div>';
      h += '<textarea class="wa-msg-texto w-full text-sm border border-gray-200 rounded px-2 py-1.5 resize-none focus:outline-none focus:ring-1 focus:ring-accent" rows="3" data-num="' + n + '" data-id="' + (msg ? msg.id : '') + '" placeholder="Texto del mensaje dominical...">' + (msg ? msg.texto : '') + '</textarea>';
      h += '<div class="mt-2 space-y-2">';
      // Imagen actual + input para subir nueva
      h += '<div class="flex items-center gap-2">';
      if (msg && msg.imagen) {
        h += '<img src="' + msg.imagen + '" class="w-10 h-10 rounded object-cover border flex-shrink-0">';
        h += '<span class="text-xs text-gray-400">Imagen actual</span>';
        h += '<button class="wa-msg-quitar-img text-xs text-red-500 hover:text-red-700 ml-auto" data-num="' + n + '" data-id="' + msg.id + '">Quitar</button>';
      } else {
        h += '<div class="w-10 h-10 rounded border border-dashed border-gray-300 flex items-center justify-center flex-shrink-0"><svg class="w-4 h-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>';
        h += '<span class="text-xs text-gray-400">Sin imagen</span>';
      }
      h += '</div>';
      h += '<div class="flex items-center justify-between gap-2">';
      h += '<label class="flex-1 cursor-pointer">';
      h += '<span class="text-xs text-gray-500">Imagen (opcional, se envía con el mensaje):</span>';
      h += '<input type="file" accept="image/*" class="wa-msg-img mt-1 block w-full text-xs text-gray-500 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:text-xs file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200" data-num="' + n + '">';
      h += '</label>';
      h += '<button class="wa-msg-save-btn flex-shrink-0 text-xs bg-primary text-white px-2.5 py-1.5 rounded" data-num="' + n + '" data-id="' + (msg ? msg.id : '') + '">Guardar</button>';
      h += '</div></div></div>';
    }
    h += '</div></div>';

    // Historial de envíos
    h += '<div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm">';
    h += '<h3 class="font-semibold text-gray-800 mb-3">Últimos Envíos</h3>';
    var logs: any[] = st.waHistorial || [];
    if (!logs.length) {
      h += '<p class="text-sm text-gray-400 text-center py-4">Sin envíos registrados.</p>';
    } else {
      h += '<div class="space-y-2">';
      logs.slice(0, 10).forEach(function(log: any) {
        h += '<div class="flex items-start justify-between gap-2 py-2 border-b border-gray-50 last:border-0">';
        h += '<div class="flex-1 min-w-0">';
        h += '<p class="text-xs font-medium text-gray-700">' + (log.mensaje_numero ? 'Mensaje #' + log.mensaje_numero : 'Mensaje eliminado') + '</p>';
        h += '<p class="text-xs text-gray-400 truncate">' + log.texto_enviado.slice(0, 60) + '...</p>';
        if (log.error_detalle) h += '<p class="text-xs text-red-400 truncate">' + log.error_detalle + '</p>';
        h += '</div>';
        h += '<div class="flex-shrink-0 text-right">';
        h += '<span class="inline-flex px-1.5 py-0.5 text-xs rounded ' + (log.estado === 'exitoso' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700') + '">' + log.estado_display + '</span>';
        h += '<p class="text-xs text-gray-400 mt-0.5">' + fmt(log.enviado_en) + '</p>';
        h += '</div></div>';
      });
      h += '</div>';
    }
    h += '</div>';
    h += '</div>';
    h += '</div>';
    return h;
  }

  function startQrPoll() {
    if (waQrPollInterval) clearInterval(waQrPollInterval);
    waQrPollInterval = setInterval(async function() {
      var status = secretariaStore.getState().waStatus;
      if (status !== 'qr_pending') { clearInterval(waQrPollInterval!); waQrPollInterval = null; return; }
      await secretariaStore.fetchWaQr();
      var qr = secretariaStore.getState().waQr;
      var img = document.getElementById('wa-qr-img') as HTMLImageElement;
      if (img && qr) img.src = qr;
      // Si ya se conectó, recargar tab
      if (secretariaStore.getState().waStatus === 'connected') {
        clearInterval(waQrPollInterval!); waQrPollInterval = null;
        loadTab('whatsapp');
      }
    }, 3000) as unknown as number;
  }

  function bindWhatsAppForm() {
    var refreshBtn = document.getElementById('wa-refresh-btn');
    if (refreshBtn) refreshBtn.onclick = () => loadTab('whatsapp');

    var logoutBtn = document.getElementById('wa-logout-btn');
    if (logoutBtn) logoutBtn.onclick = async function() {
      if (!confirm('¿Desconectar la sesión de WhatsApp?')) return;
      try { await secretariaStore.waLogout(); toastSuccess('Sesión cerrada'); loadTab('whatsapp'); }
      catch(e: any) { toastError(e.message); }
    };

    var connectBtn = document.getElementById('wa-connect-btn');
    if (connectBtn) connectBtn.onclick = async function() {
      connectBtn.textContent = 'Cargando QR...';
      (connectBtn as HTMLButtonElement).disabled = true;
      try {
        await secretariaStore.fetchWaQr();
        toastSuccess('QR listo, escanea en WhatsApp');
        loadTab('whatsapp');
      } catch(e: any) {
        toastError(e.message);
        connectBtn.textContent = 'Conectar';
        (connectBtn as HTMLButtonElement).disabled = false;
      }
    };

    var saveConfigBtn = document.getElementById('wa-save-config-btn');
    if (saveConfigBtn) saveConfigBtn.onclick = async function() {
      try {
        await secretariaStore.updateWaConfig({
          grupo_jid: (document.getElementById('wa-jid') as HTMLInputElement)?.value.trim(),
          hora_envio: (document.getElementById('wa-hora') as HTMLInputElement)?.value,
          activo: (document.getElementById('wa-activo') as HTMLInputElement)?.checked,
        });
        toastSuccess('Configuración guardada');
      } catch(e: any) { toastError(e.message); }
    };

    var testBtn = document.getElementById('wa-test-btn');
    if (testBtn) testBtn.onclick = async function() {
      testBtn.textContent = 'Enviando...';
      (testBtn as HTMLButtonElement).disabled = true;
      try {
        await secretariaStore.waSendTest();
        toastSuccess('Mensaje enviado al grupo');
        loadTab('whatsapp');
      } catch(e: any) {
        toastError(e.message);
        testBtn.textContent = 'Enviar Mensaje de Prueba Ahora';
        (testBtn as HTMLButtonElement).disabled = false;
      }
    };

    document.querySelectorAll('.wa-msg-quitar-img').forEach(function(btn) {
      (btn as HTMLElement).onclick = async function() {
        var id = parseInt((btn as HTMLElement).dataset.id!);
        if (!id) return;
        try {
          await secretariaStore.limpiarImagenMensaje(id);
          toastSuccess('Imagen quitada');
          loadTab('whatsapp');
        } catch(e: any) { toastError(e.message); }
      };
    });

    document.querySelectorAll('.wa-msg-save-btn').forEach(function(btn) {
      (btn as HTMLElement).onclick = async function() {
        var num = parseInt((btn as HTMLElement).dataset.num!);
        var id = parseInt((btn as HTMLElement).dataset.id!);
        var textarea = document.querySelector('.wa-msg-texto[data-num="' + num + '"]') as HTMLTextAreaElement;
        var texto = textarea?.value.trim();
        if (!texto) { toastError('El mensaje no puede estar vacío.'); return; }
        try {
          var fd = new FormData();
          fd.append('texto', texto);
          if (!id) { fd.append('numero', String(num)); fd.append('activo', 'true'); }
          var fileInput = document.querySelector('.wa-msg-img[data-num="' + num + '"]') as HTMLInputElement;
          if (fileInput?.files?.length) {
            fd.append('imagen', fileInput.files[0]);
          }
          if (id) {
            await secretariaStore.updateWaMensaje(id, fd);
          } else {
            await secretariaStore.createWaMensaje(fd);
          }
          toastSuccess('Mensaje #' + num + ' guardado');
          loadTab('whatsapp');
        } catch(e: any) { toastError(e.message); }
      };
    });
  }

  // ─── INIT ──────────────────────────────────────────────────────────────────

  async function init() {
    contentArea = document.getElementById('sec-content-area');
    setupTabs();
    await loadTab('estadisticas');
    document.getElementById('sec-skeleton')?.classList.add('hidden');
    document.getElementById('sec-content')?.classList.remove('hidden');
  }

  document.addEventListener('astro:page-load', function() {
    if (document.getElementById('sec-page')) init();
  });
</script>
