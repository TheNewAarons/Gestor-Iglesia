  async function sendEvento(data, forzar) {
    var API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000/api/v1';
    var finalData = forzar ? { ...data, forzar: true } : data;
    var url, method;

    if (editingEventId) {
      url = API_BASE + '/eventos/' + editingEventId + '/';
      method = 'PUT';
      if (ministryData && ministryData.id) finalData.ministry = ministryData.id;
    } else {
      url = API_BASE + '/ministerios/' + slug + '/eventos/';
      method = 'POST';
    }

    var response = await fetch(url, {
      method: method,
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify(finalData)
    });
    if (!response.ok) {
      var body = await response.json().catch(function() { return {}; });
      console.log('[sendEvento] Error ' + response.status, body);

      // Formato manual: {error: {tipo, mensaje, conflictos}}
      var manualError = body.error || null;
      var isConflict = false;
      if (manualError && manualError.tipo === 'conflicto_horario') isConflict = true;
      if (body.errors && typeof body.errors === 'object') {
        var keys = Object.keys(body.errors);
        for (var i = 0; i < keys.length; i++) {
          var val = body.errors[keys[i]];
          if (typeof val === 'object' && !Array.isArray(val) && val.tipo === 'conflicto_horario') {
            manualError = val;
            isConflict = true;
          }
        }
      }
      console.log('[sendEvento] isConflict=' + isConflict + ' forzar=' + forzar, manualError);

      if (isConflict && !forzar) {
        return await new Promise(function(resolve) {
          var conflictos = manualError.conflictos || [];
          var mensaje = manualError.mensaje || 'La ubicación ya está ocupada en ese horario.';
          
          var msgEl = document.getElementById('conflict-message');
          var listEl = document.getElementById('conflict-list');
          var modal = document.getElementById('conflict-modal');
          
          if (!modal || !msgEl || !listEl) {
            console.error('[sendEvento] Elementos del modal no encontrados:', {modal: !!modal, msgEl: !!msgEl, listEl: !!listEl});
            alert(mensaje + '\n\n' + conflictos.map(function(c) { return '- ' + c.titulo; }).join('\n'));
            resolve(false);
            return;
          }

          msgEl.textContent = mensaje;

          var listHtml = '';
          conflictos.forEach(function(c) {
            var timeInfo = c.hora_inicio ? c.hora_inicio : '';
            timeInfo += c.hora_fin ? ' - ' + c.hora_fin : '';
            listHtml += '<div class="flex items-center gap-2 p-2 rounded border border-amber-100 bg-amber-50"><span class="w-2 h-2 rounded-full bg-amber-400 shrink-0"></span><div><p class="text-sm font-medium text-gray-900">' + c.titulo + '</p>' + (timeInfo ? '<p class="text-xs text-gray-500">' + timeInfo + '</p>' : '') + '</div></div>';
          });
          listEl.innerHTML = listHtml;

          modal.classList.remove('hidden');
          modal.classList.add('flex');

          function closeAndResolve(result) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            resolve(result);
          }

          document.getElementById('conflict-force').onclick = async function() {
            closeAndResolve(await sendEvento(data, true));
          };
          document.getElementById('conflict-cancel').onclick = function() { closeAndResolve(false); };
          document.getElementById('conflict-modal-backdrop').onclick = function() { closeAndResolve(false); };
        });
      }

      // Build display message from all available error info
      var msg = '';
      // Custom handler: {code, message, errors: {campo: [mensajes]}}
      if (body.errors && typeof body.errors === 'object' && !Array.isArray(body.errors)) {
        msg = Object.keys(body.errors).map(function(key) {
          var val = body.errors[key];
          if (typeof val === 'string') return key + ': ' + val;
          if (typeof val === 'object' && !Array.isArray(val)) return key + ': ' + (val.mensaje || val.detail || val.message || JSON.stringify(val));
          if (Array.isArray(val)) return key + ': ' + val.join(', ');
          return key + ': ' + String(val);
        }).join('\n');
      }
      // Raw DRF format: {campo: [mensajes]} (from ministry view's eventos POST)
      if (!msg && typeof body === 'object' && !body.code && !body.message) {
        msg = Object.keys(body).map(function(key) {
          var val = body[key];
          return key + ': ' + (Array.isArray(val) ? val.join(', ') : String(val));
        }).join('\n');
      }
      if (!msg) msg = body.message || (manualError && manualError.mensaje) || body.detail || 'Error al ' + (editingEventId ? 'editar' : 'crear') + ' el evento';
      throw new Error(msg);
    }
    return true;
  }

  function canEditEvent(ev) {
    var user = authStore.getState().user;
    if (!user) return false;
    if (user.rol === 'admin' || user.rol === 'pastora') return true;
    if (user.rol === 'lider_ministerio' && user.ministerios_lidera) {
      var evIds = [ev.ministry];
      if (ev.ministerios_relacionados) evIds = evIds.concat(ev.ministerios_relacionados);
      var lideraIds = user.ministerios_lidera.map(function(m) { return m.id; });
      return evIds.some(function(id) { return lideraIds.indexOf(id) !== -1; });
    }
    return false;
  }

  async function openEditForm(ev) {
    editingEventId = ev.id;
    var form = document.getElementById('events-form');
    var saveBtn = document.getElementById('events-save');
    if (!form) return;

    document.getElementById('ef-titulo').value = ev.titulo || '';
    document.getElementById('ef-desc').value = ev.descripcion || '';
    document.getElementById('ef-ubicacion').value = ev.ubicacion || '';
    document.getElementById('ef-tipo').value = ev.tipo || 'propio';
    document.getElementById('ef-hora').value = ev.hora_inicio || '';

    if (ev.fecha_inicio) {
      var d = new Date(ev.fecha_inicio);
      var dateStr = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
      document.getElementById('ef-fecha').value = dateStr;
      if (!ev.hora_inicio) {
        document.getElementById('ef-hora').value = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
      }
    }

    if (ev.fecha_fin) {
      var df = new Date(ev.fecha_fin);
      document.getElementById('ef-fecha-fin').value = df.getFullYear() + '-' + String(df.getMonth() + 1).padStart(2, '0') + '-' + String(df.getDate()).padStart(2, '0');
    }
    if (ev.hora_fin) {
      document.getElementById('ef-hora-fin').value = ev.hora_fin;
    }

    if (ev.tipo === 'compartido') {
      var sharedDiv = document.getElementById('ef-shared-ministries');
      if (sharedDiv) sharedDiv.classList.remove('hidden');
      if (!ministriesLoaded) await loadMinistryCheckboxes();
      var checks = document.querySelectorAll('.ef-min-check');
      var relatedIds = (ev.ministerios_relacionados || []).slice();
      if (ev.ministry) relatedIds.push(ev.ministry);
      checks.forEach(function(cb) {
        var id = parseInt(cb.value);
        cb.checked = relatedIds.indexOf(id) !== -1;
      });
    }

    form.classList.remove('hidden');
    if (saveBtn) saveBtn.textContent = 'Actualizar';
    hideError();
  }

  async function deleteEvento(ev) {
    if (!confirm('¿Eliminar el evento "' + ev.titulo + '"?\nEsta acción no se puede deshacer.')) return;
    var API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000/api/v1';
    try {
      var response = await fetch(API_BASE + '/eventos/' + ev.id + '/', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
      });
      if (!response.ok) {
        var body = await response.json().catch(function() { return {}; });
        throw new Error(body.detail || 'Error al eliminar el evento');
      }
      await loadTab('eventos');
    } catch (e) {
      alert(e.message);
    }
  }

  function bindEventsActions() {
    var grid = document.querySelector('#mp-content-area .grid.gap-3');
    if (!grid) return;
    grid.addEventListener('click', function(e) {
      var editBtn = e.target.closest('[data-edit-event]');
      var deleteBtn = e.target.closest('[data-delete-event]');
      if (editBtn) {
        var id = parseInt(editBtn.getAttribute('data-edit-event'));
        var st = ministeriosStore.getState();
        var ev = (st.eventos || []).find(function(ev) { return ev.id === id; });
        if (ev) openEditForm(ev);
      }
      if (deleteBtn) {
        var delId = parseInt(deleteBtn.getAttribute('data-delete-event'));
        var st2 = ministeriosStore.getState();
        var ev2 = (st2.eventos || []).find(function(ev) { return ev.id === delId; });
        if (ev2) deleteEvento(ev2);
      }
    });
  }

  var ministriesLoaded = false;
  var editingEventId = null;

  function bindEventsForm() {
    var addBtn = document.getElementById('events-add-btn');
    var form = document.getElementById('events-form');
    var saveBtn = document.getElementById('events-save');
    var cancelBtn = document.getElementById('events-cancel');
    var tipoSelect = document.getElementById('ef-tipo');
    var sharedDiv = document.getElementById('ef-shared-ministries');
    if (!addBtn || !form) return;

    addBtn.onclick = function() { editingEventId = null; resetEventsForm(); var sb = document.getElementById('events-save'); if (sb) sb.textContent = 'Guardar'; form.classList.toggle('hidden'); hideError(); };
    if (cancelBtn) cancelBtn.addEventListener('click', function() { editingEventId = null; resetEventsForm(); var sb = document.getElementById('events-save'); if (sb) sb.textContent = 'Guardar'; form.classList.add('hidden'); hideError(); });

    if (tipoSelect && sharedDiv) {
      tipoSelect.addEventListener('change', async function() {
        if (tipoSelect.value === 'compartido') {
          sharedDiv.classList.remove('hidden');
          if (!ministriesLoaded) await loadMinistryCheckboxes();
        } else {
          sharedDiv.classList.add('hidden');
        }
      });
    }

    if (saveBtn) saveBtn.addEventListener('click', async function() {
      var fechaVal = document.getElementById('ef-fecha').value;
      var horaVal = document.getElementById('ef-hora').value;
      var fechaFinVal = document.getElementById('ef-fecha-fin').value;
      var horaFinVal = document.getElementById('ef-hora-fin').value;
      var tituloVal = document.getElementById('ef-titulo').value.trim();
      var tipoVal = document.getElementById('ef-tipo').value;

      if (!tituloVal || !fechaVal) {
        showError('Título y Fecha son obligatorios');
        return;
      }

      var data = {
        titulo: tituloVal,
        descripcion: document.getElementById('ef-desc').value.trim(),
        fecha_inicio: fechaVal + 'T' + (horaVal || '00:00') + ':00',
        hora_inicio: horaVal || null,
        fecha_fin: fechaFinVal ? (fechaFinVal + 'T' + (horaFinVal || '00:00') + ':00') : null,
        hora_fin: horaFinVal || null,
        ubicacion: document.getElementById('ef-ubicacion').value.trim(),
        tipo: tipoVal,
      };

      if (tipoVal === 'compartido') {
        var selected = [];
        var checks = document.querySelectorAll('#ef-ministries-list input[type="checkbox"]:checked');
        checks.forEach(function(cb) { selected.push(parseInt(cb.value)); });
        if (selected.length === 0) {
          showError('Selecciona al menos un ministerio para compartir');
          return;
        }
        data.ministerios_relacionados = selected;
      }

      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando...';
      hideError();

      try {
        var result = await sendEvento(data, false);
        if (result === false) return;
        editingEventId = null;
        form.classList.add('hidden');
        resetEventsForm();
        saveBtn.textContent = 'Guardar';
        await loadTab('eventos');
      } catch (e) {
        showError(e.message);
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = editingEventId ? 'Actualizar' : 'Guardar';
      }
    });
  }

  async function loadMinistryCheckboxes() {
    var listEl = document.getElementById('ef-ministries-list');
    if (!listEl) return;
    try {
      var response = await api.get('/ministerios/');
      var ministerios = response.results || [];
      var html = '';
      ministerios.forEach(function(m) {
        if (m.slug === slug) return;
        html += '<label class="flex items-center gap-2 px-2 py-1 rounded hover:bg-white cursor-pointer text-sm"><input type="checkbox" value="' + m.id + '" class="ef-min-check w-4 h-4 rounded border-gray-300 text-accent focus:ring-accent" /><span class="text-gray-700">' + m.nombre + '</span></label>';
      });
      listEl.innerHTML = html;
      ministriesLoaded = true;
    } catch (e) {
      console.error('Error loading ministries:', e);
    }
  }

  function showError(msg) {
    var el = document.getElementById('events-form-error');
    if (el) { el.textContent = msg; el.classList.remove('hidden'); }
    else { console.error('[showError] elemento no encontrado, msg:', msg); alert(msg); }
  }
  function hideError() {
    var el = document.getElementById('events-form-error');
    if (el) { el.textContent = ''; el.classList.add('hidden'); }
  }
  function resetEventsForm() {
    var fields = ['ef-titulo', 'ef-desc', 'ef-fecha', 'ef-hora', 'ef-fecha-fin', 'ef-hora-fin', 'ef-ubicacion'];
    fields.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.value = '';
    });
    var tipoEl = document.getElementById('ef-tipo');
    if (tipoEl) tipoEl.value = 'propio';
    var sharedDiv = document.getElementById('ef-shared-ministries');
    if (sharedDiv) sharedDiv.classList.add('hidden');
    var checks = document.querySelectorAll('.ef-min-check');
    checks.forEach(function(cb) { cb.checked = false; });
  }

  function renderAttendanceTab(asistencias) {
    var h = '<div class="space-y-4"><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-gray-200"><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Nombre</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Fecha</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Presente</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Clase</th></tr></thead><tbody>';
    for (var i = 0; i < asistencias.length; i++) {
      var a = asistencias[i];
      h += '<tr class="border-b border-gray-100"><td class="px-4 py-2">' + (a.miembro_nombre || a.nombre_visita || '(visita)') + '</td><td class="px-4 py-2">' + a.fecha + '</td><td class="px-4 py-2"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ' + (a.presente ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800') + '">' + (a.presente ? 'Sí' : 'No') + '</span></td><td class="px-4 py-2 capitalize">' + (a.clase || '-') + '</td></tr>';
    }
    h += '</tbody></table></div></div>';
    return h;
  }

  function renderLessonsTab(lecciones) {
    var h = '<div class="space-y-4">';
    for (var i = 0; i < lecciones.length; i++) {
      var lec = lecciones[i];
      h += '<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6"><h4 class="font-medium text-gray-900">' + lec.titulo + '</h4><p class="text-sm text-gray-500 mt-1">' + lec.descripcion + '</p></div>';
    }
    h += '</div>';
    return h;
  }

  function renderSongsTab(canciones) {
    var h = '<div class="space-y-4"><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-gray-200"><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Título</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Artista</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Categoría</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Tono</th></tr></thead><tbody>';
    for (var i = 0; i < canciones.length; i++) {
      var c = canciones[i];
      h += '<tr class="border-b border-gray-100"><td class="px-4 py-2">' + c.titulo + '</td><td class="px-4 py-2">' + (c.artista || '-') + '</td><td class="px-4 py-2 capitalize">' + c.categoria + '</td><td class="px-4 py-2">' + (c.tono || '-') + '</td></tr>';
    }
    h += '</tbody></table></div></div>';
    return h;
  }

  function renderProgramsTab(programas) {
    var h = '<div class="space-y-4">';
    for (var i = 0; i < programas.length; i++) {
      var p = programas[i];
      h += '<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6"><div class="flex justify-between items-start"><h4 class="font-medium text-gray-900">Programa - ' + formatDate(p.fecha) + '</h4><span class="text-sm text-gray-500">' + (p.alabanzas?.length || 0) + ' canciones</span></div></div>';
    }
    h += '</div>';
    return h;
  }

  function renderResourcesTab(recursos) {
    var h = '<div class="space-y-4">';
    for (var i = 0; i < recursos.length; i++) {
      var r = recursos[i];
      h += '<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6"><div class="flex justify-between items-start"><div><h4 class="font-medium text-gray-900">' + r.titulo + '</h4><p class="text-sm text-gray-500 mt-1">' + r.descripcion + '</p></div><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">' + r.tipo + '</span></div></div>';
    }
    h += '</div>';
    return h;
  }

  function renderIdeasTab(ideas) {
    var h = '<div class="space-y-4">';
    for (var i = 0; i < ideas.length; i++) {
      var id = ideas[i];
      h += '<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6"><div class="flex items-center justify-between"><div><h4 class="font-medium text-gray-900">' + id.titulo + '</h4><p class="text-sm text-gray-500">' + id.descripcion + '</p></div><div class="flex items-center gap-3"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ' + (id.completada ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800') + '">' + (id.completada ? 'Completada' : 'Pendiente') + '</span><button data-toggle-idea="' + id.id + '" data-completada="' + (!id.completada) + '" class="text-sm text-accent hover:underline cursor-pointer">' + (id.completada ? 'Reabrir' : 'Completar') + '</button></div></div></div>';
    }
    h += '</div>';
    return h;
  }

  function renderPlansTab(planificaciones) {
    var h = '<div class="space-y-4"><div class="grid gap-3">';
    for (var i = 0; i < planificaciones.length; i++) {
      var p = planificaciones[i];
      var variant = 'bg-amber-100 text-amber-800';
      if (p.estado === 'completada') variant = 'bg-green-100 text-green-800';
      else if (p.estado === 'en_proceso') variant = 'bg-blue-100 text-blue-800';
      h += '<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6"><div class="flex justify-between items-start"><div><h4 class="font-medium text-gray-900">' + p.titulo + '</h4><p class="text-sm text-gray-500 mt-1">' + formatDate(p.fecha_planificada) + '</p></div><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ' + variant + '">' + ((p.estado || '').replace('_', ' ')) + '</span></div></div>';
    }
    h += '</div></div>';
    return h;
  }

  // Initialize
  async function init() {
    var pageEl = document.getElementById('ministry-page');
    slug = (pageEl && pageEl.dataset.slug) || '';

    var skeleton = document.getElementById('mp-skeleton');
    var content = document.getElementById('mp-content');
    contentArea = document.getElementById('mp-content-area');
    var mpName = document.getElementById('mp-name');
    var mpDesc = document.getElementById('mp-desc');

    if (!skeleton || !content || !contentArea || !mpName || !mpDesc) return;

    activeTab = 'dashboard';
    ministryData = null;
    dashboardData = null;

    setupTabs();

    await new Promise(function(r) { setTimeout(r, 0); });

    await authStore.checkAuth();
    var authState = authStore.getState();
    if (!authState.isAuthenticated) {
      window.location.href = '/login';
      return;
    }

    var results = await Promise.all([
      api.get('/ministerios/' + slug + '/'),
      api.get('/ministerios/' + slug + '/dashboard/'),
    ]);

    ministryData = results[0];
    dashboardData = results[1];

    mpName.textContent = results[0].nombre || slug.toUpperCase();
    mpDesc.textContent = results[0].descripcion || '';

    var mpLogo = document.getElementById('mp-logo');
    var mpIcon = document.getElementById('mp-icon');
    var mpHeroLogo = document.getElementById('mp-hero-logo');
    if (results[0].logo && mpLogo && mpIcon) {
      mpLogo.src = results[0].logo;
      mpLogo.alt = results[0].nombre;
      mpLogo.classList.remove('hidden');
      mpIcon.classList.add('hidden');
      if (mpHeroLogo) {
        mpHeroLogo.src = results[0].logo;
        mpHeroLogo.alt = results[0].nombre;
        mpHeroLogo.classList.remove('hidden');
      }
    }

    skeleton.classList.add('hidden');
    content.classList.remove('hidden');

    contentArea.innerHTML = renderDashboard();
  }

  document.addEventListener('astro:page-load', function() {
    if (document.getElementById('ministry-page')) init();
  });
</script>
