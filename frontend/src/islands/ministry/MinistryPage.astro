  function bindOfferingForm() {
    var addBtn = document.getElementById('offering-add-btn');
    var form = document.getElementById('offering-form');
    var saveBtn = document.getElementById('offering-save');
    var cancelBtn = document.getElementById('offering-cancel');
    if (!addBtn || !form) return;

    var mSlug = ministryData && ministryData.slug || slug;
    var isMNI = mSlug === 'mni';
    var isDNI = mSlug === 'dni';
    var editingId = null;

    function resetOfferingForm() {
      editingId = null;
      document.getElementById('of-fecha').value = '';
      document.getElementById('of-monto').value = '';
      var catEl = document.getElementById('of-categoria');
      if (catEl) catEl.value = '';
      var claseEl = document.getElementById('of-clase');
      if (claseEl) claseEl.value = '';
      document.getElementById('of-obs').value = '';
      saveBtn.textContent = 'Guardar';
    }

    addBtn.onclick = function() {
      var isHidden = form.classList.contains('hidden');
      form.classList.toggle('hidden');
      if (!isHidden) resetOfferingForm();
    };

    if (cancelBtn) cancelBtn.addEventListener('click', function() {
      form.classList.add('hidden');
      resetOfferingForm();
    });

    // Event delegation for edit, delete
    var offeringContainer = form.closest('.space-y-4');
    if (offeringContainer) {
      offeringContainer.addEventListener('click', function(e) {
        var editBtn = e.target.closest('[data-of-edit]');
        if (editBtn) {
          var id = parseInt(editBtn.getAttribute('data-of-edit'));
          var ofrenda = ministeriosStore.getState().ofrendas.find(function(o) { return o.id === id; });
          if (ofrenda) {
            editingId = ofrenda.id;
            document.getElementById('of-fecha').value = ofrenda.fecha || '';
            document.getElementById('of-monto').value = ofrenda.monto || '';
            var catEl = document.getElementById('of-categoria');
            if (catEl) catEl.value = ofrenda.categoria || '';
            var claseEl = document.getElementById('of-clase');
            if (claseEl) claseEl.value = ofrenda.clase || '';
            document.getElementById('of-obs').value = ofrenda.observaciones || '';
            saveBtn.textContent = 'Actualizar';
            form.classList.remove('hidden');
          }
        }
        var delBtn = e.target.closest('[data-of-delete]');
        if (delBtn) {
          var id = parseInt(delBtn.getAttribute('data-of-delete'));
          if (confirm('¿Eliminar esta ofrenda?')) {
            ministeriosStore.deleteOfrenda(slug, id).then(function() {
              toastSuccess('Ofrenda eliminada');
              loadTab('ofrendas');
            }).catch(function(err) { toastError(err.message); });
          }
        }
      });
    }

    if (saveBtn) saveBtn.addEventListener('click', async function() {
      var fecha = document.getElementById('of-fecha').value;
      var monto = parseFloat(document.getElementById('of-monto').value);
      if (!fecha || isNaN(monto)) { toastError('Fecha y Monto son obligatorios'); return; }

      var data = {
        fecha: fecha,
        monto: monto,
        observaciones: document.getElementById('of-obs').value,
      };
      if (isMNI) {
        var catEl = document.getElementById('of-categoria');
        if (catEl) data.categoria = catEl.value;
      }
      if (isDNI) {
        var claseEl = document.getElementById('of-clase');
        if (claseEl) data.clase = claseEl.value;
      }

      try {
        if (editingId) {
          await ministeriosStore.updateOfrenda(slug, editingId, data);
          toastSuccess('Ofrenda actualizada exitosamente');
        } else {
          await ministeriosStore.addOfrenda(slug, data);
          toastSuccess('Ofrenda agregada exitosamente');
        }
        form.classList.add('hidden');
        resetOfferingForm();
        loadTab('ofrendas');
      } catch (err: any) { toastError(err.message); }
    });
  }

