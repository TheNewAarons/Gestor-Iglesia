  function bindPlanificacionForm() {
    var addBtn = document.getElementById('plan-add-btn');
    var form = document.getElementById('plan-form');
    var saveBtn = document.getElementById('plan-save');
    var cancelBtn = document.getElementById('plan-cancel');
    if (!addBtn || !form) return;
    var editingId = null;

    addBtn.onclick = function() {
      editingId = null;
      document.getElementById('pf-titulo').value = '';
      document.getElementById('pf-fecha').value = '';
      document.getElementById('pf-hora').value = '';
      document.getElementById('pf-ubicacion').value = '';
      document.getElementById('pf-desc').value = '';
      document.getElementById('pf-presupuesto').value = '0';
      document.getElementById('pf-estado').value = 'planificada';
      saveBtn.textContent = 'Guardar';
      form.classList.toggle('hidden');
    };

    if (cancelBtn) cancelBtn.addEventListener('click', function() { form.classList.add('hidden'); });

    var container = form.closest('.space-y-4');
    if (container) {
      container.addEventListener('click', function(e) {
        var editBtn = e.target.closest('[data-plan-edit]');
        if (editBtn) {
          var id = parseInt(editBtn.getAttribute('data-plan-edit'));
          var plan = ministeriosStore.getState().planificaciones.find(function(p) { return p.id === id; });
          if (plan) {
            editingId = id;
            document.getElementById('pf-titulo').value = plan.titulo || '';
            document.getElementById('pf-fecha').value = plan.fecha_planificada || '';
            document.getElementById('pf-hora').value = plan.hora ? plan.hora.substring(0, 5) : '';
            document.getElementById('pf-ubicacion').value = plan.ubicacion || '';
            document.getElementById('pf-desc').value = plan.descripcion || '';
            document.getElementById('pf-presupuesto').value = plan.presupuesto || 0;
            document.getElementById('pf-estado').value = plan.estado || 'planificada';
            saveBtn.textContent = 'Actualizar';
            form.classList.remove('hidden');
          }
        }
        var delBtn = e.target.closest('[data-plan-delete]');
        if (delBtn) {
          var pid = parseInt(delBtn.getAttribute('data-plan-delete'));
          var pname = delBtn.getAttribute('data-plan-name');
          if (confirm('¿Eliminar planificación "' + pname + '"?')) {
            ministeriosStore.deletePlanificacion(slug, pid).then(function() {
              toastSuccess('Planificación eliminada');
              loadTab('planificacion');
            }).catch(function(err) { toastError(err.message); });
          }
        }
      });
    }

    if (saveBtn) saveBtn.addEventListener('click', async function() {
      var titulo = document.getElementById('pf-titulo').value;
      var fecha = document.getElementById('pf-fecha').value;
      if (!titulo || !fecha) { toastError('Título y Fecha son obligatorios'); return; }
      var data = {
        titulo: titulo,
        fecha_planificada: fecha,
        hora: document.getElementById('pf-hora').value || null,
        ubicacion: document.getElementById('pf-ubicacion').value,
        descripcion: document.getElementById('pf-desc').value,
        presupuesto: parseFloat(document.getElementById('pf-presupuesto').value) || 0,
        estado: document.getElementById('pf-estado').value,
      };
      try {
        if (editingId) {
          await ministeriosStore.updatePlanificacion(slug, editingId, data);
          toastSuccess('Planificación actualizada');
        } else {
          await ministeriosStore.addPlanificacion(slug, data);
          toastSuccess('Planificación creada');
        }
        form.classList.add('hidden');
        loadTab('planificacion');
      } catch (err) { toastError(err.message); }
    });
  }

  function bindNotasForm() {
    var form = document.getElementById('nota-form');
    var saveBtn = document.getElementById('nota-save-btn');
    var cancelBtn = document.getElementById('nota-cancel-btn');
    var toggleBtn = document.getElementById('nota-toggle-form-btn');

    if (!form || !saveBtn || !cancelBtn || !toggleBtn) return;

    toggleBtn.addEventListener('click', function() {
      resetNotaForm();
      form.classList.remove('hidden');
      loadEventOptions();
    });

    cancelBtn.addEventListener('click', function() {
      resetNotaForm();
      form.classList.add('hidden');
    });

    var colorBtns = document.querySelectorAll('#nota-color-picker button');
    colorBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        colorBtns.forEach(function(b) { b.style.borderColor = 'transparent'; });
        btn.style.borderColor = '#6366f1';
        form.dataset.selectedColor = btn.dataset.color;
      });
    });
    form.dataset.selectedColor = '#fef3c7';

    saveBtn.addEventListener('click', async function() {
      var titulo = document.getElementById('nota-titulo');
      var contenido = document.getElementById('nota-contenido');
      var evento = document.getElementById('nota-evento');
      if (!titulo) return;

      var tituloVal = titulo.value.trim();
      if (!tituloVal) { toastError('El título es obligatorio'); return; }

      var evVal = (evento && evento.value) ? parseInt(evento.value) : null;
      var data = {
        titulo: tituloVal,
        contenido: (contenido && contenido.value || '').trim(),
        color: form.dataset.selectedColor || '#fef3c7',
        evento: evVal || null,
      };

      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando...';

      try {
        if (editingNotaId) {
          await ministeriosStore.updateNota(slug, editingNotaId, data);
          toastSuccess('Nota actualizada');
          editingNotaId = null;
        } else {
          await ministeriosStore.addNota(slug, data);
          toastSuccess('Nota creada');
        }
        resetNotaForm();
        form.classList.add('hidden');
        await loadTab('planificacion');
      } catch (e) {
        toastError(e.message);
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = editingNotaId ? 'Actualizar' : 'Guardar';
      }
    });

    document.querySelectorAll('[data-edit-nota]').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        var id = parseInt(btn.dataset.editNota);
        var st = ministeriosStore.getState();
        var nota = st.notas.find(function(n) { return n.id === id; });
        if (!nota) return;

        editingNotaId = id;
        var titulo = document.getElementById('nota-titulo');
        var contenido = document.getElementById('nota-contenido');
        var evento = document.getElementById('nota-evento');
        var formTitle = document.getElementById('nota-form-title');
        if (titulo) titulo.value = nota.titulo;
        if (contenido) contenido.value = nota.contenido || '';
        if (formTitle) formTitle.textContent = 'Editar nota';
        saveBtn.textContent = 'Actualizar';
        form.classList.remove('hidden');

        var colorBtnsInner = document.querySelectorAll('#nota-color-picker button');
        var noteColor = nota.color || '#fef3c7';
        form.dataset.selectedColor = noteColor;
        colorBtnsInner.forEach(function(b) {
          b.style.borderColor = b.dataset.color === noteColor ? '#6366f1' : 'transparent';
        });

        await loadEventOptions();
        if (evento) evento.value = nota.evento ? String(nota.evento) : '';

        form.scrollIntoView({ behavior: 'smooth' });
      });
    });

    document.querySelectorAll('[data-delete-nota]').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        var id = parseInt(btn.dataset.deleteNota);
        if (!confirm('¿Eliminar esta nota?')) return;
        try {
          await ministeriosStore.deleteNota(slug, id);
          toastSuccess('Nota eliminada');
          await loadTab('planificacion');
        } catch (e) {
          toastError(e.message);
        }
      });
    });
  }

  // Initialize
  async function init() {
    var pageEl = document.getElementById('ministry-page');
    slug = (pageEl && pageEl.dataset.slug) || '';

    var skeleton = document.getElementById('mp-skeleton');
    var content = document.getElementById('mp-content');
    contentArea = document.getElementById('mp-content-area');
    var mpName = document.getElementById('mp-name');
    var mpDesc = document.getElementById('mp-desc');

    if (!skeleton || !content || !contentArea || !mpName || !mpDesc) return;

    activeTab = 'dashboard';
    ministryData = null;
    dashboardData = null;

    setupTabs();

    await new Promise(function(r) { setTimeout(r, 0); });

    await authStore.checkAuth();
    var authState = authStore.getState();
    if (!authState.isAuthenticated) {
      window.location.href = '/login';
      return;
    }

    var results = await Promise.all([
      api.get('/ministerios/' + slug + '/'),
      api.get('/ministerios/' + slug + '/dashboard/'),
    ]);

    ministryData = results[0];
    dashboardData = results[1];

    mpName.textContent = results[0].nombre || slug.toUpperCase();
    mpDesc.textContent = results[0].descripcion || '';

    var mpLogo = document.getElementById('mp-logo');
    var mpIcon = document.getElementById('mp-icon');
    var mpHeroLogo = document.getElementById('mp-hero-logo');
    if (results[0].logo && mpLogo && mpIcon) {
      mpLogo.src = results[0].logo;
      mpLogo.alt = results[0].nombre;
      mpLogo.classList.remove('hidden');
      mpIcon.classList.add('hidden');
      if (mpHeroLogo) {
        mpHeroLogo.src = results[0].logo;
        mpHeroLogo.alt = results[0].nombre;
        mpHeroLogo.classList.remove('hidden');
      }
    }

    skeleton.classList.add('hidden');
    content.classList.remove('hidden');

    contentArea.innerHTML = renderDashboard();
  }

  document.addEventListener('astro:page-load', function() {
    if (document.getElementById('ministry-page')) init();
  });
</script>
