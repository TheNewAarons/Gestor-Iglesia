  function bindProgramsActions() {
    setTimeout(function() {
      var generarBtn = document.getElementById('prog-generar-btn');
      var fechaDiv = document.getElementById('prog-generar-fecha');
      var confirmBtn = document.getElementById('prog-gen-confirm');
      if (!generarBtn) return;
