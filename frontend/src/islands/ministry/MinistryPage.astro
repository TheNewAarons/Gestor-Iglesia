---
import { MINISTRY_COLORS } from '../../utils/colors';

interface Props {
  slug: string;
  tabs: string[];
}

const { slug, tabs } = Astro.props;

const colors = MINISTRY_COLORS[slug] || MINISTRY_COLORS.mni;

const TAB_LABELS: Record<string, string> = {
  dashboard: 'Dashboard',
  miembros: 'Miembros',
  caja: 'Caja',
  inventario: 'Inventario',
  ofrendas: 'Ofrendas',
  eventos: 'Eventos',
  asistencia: 'Asistencia',
  lecciones: 'Lecciones',
  canciones: 'Canciones',
  programas: 'Programas',
  recursos: 'Recursos',
  ideas: 'Ideas',
  planificacion: 'Planificación',
  notas: 'Notas',
  enfoques: 'Enfoques',
  programa: 'Programa',
  cumpleanos: 'Cumpleaños',
  biblias: 'Biblias',
};
---

<div id="ministry-page" data-slug={slug}>
  <!-- Loading skeleton -->
  <div id="mp-skeleton" class="space-y-4 animate-pulse">
    <div class="h-40 bg-gray-200 rounded-lg" />
    <div class="h-10 bg-gray-200 rounded w-1/3" />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {[1, 2, 3].map((i) => <div class="h-32 bg-gray-100 rounded-lg" />)}
    </div>
  </div>

  <!-- Page content (hidden initially) -->
  <div id="mp-content" class="hidden">
    <!-- Hero -->
    <div
      id="mp-hero"
      class="relative rounded-xl overflow-hidden mb-6 min-h-[180px] flex items-end"
      style={`background: ${colors.gradient}`}
    >
      <!-- Decorative elements -->
      <div class="absolute top-0 right-0 w-40 h-40 rounded-full border-2 border-white/20 -translate-y-1/2 translate-x-1/4"></div>
      <div class="absolute top-4 right-20 w-12 h-12 rounded-full border border-white/25"></div>
      <div class="absolute top-12 right-8 w-6 h-6 rounded-full border border-white/30"></div>
      <!-- Diagonal texture overlay -->
      <div class="absolute inset-0 opacity-15" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 8px, rgba(255,255,255,0.2) 8px, rgba(255,255,255,0.2) 10px)"></div>
      <!-- Logo watermark -->
      <img id="mp-hero-logo" class="absolute right-4 bottom-10 w-24 h-24 object-contain opacity-25 hidden" src="" alt="" />
      <!-- Content -->
      <div class="relative z-10 p-6 flex items-center gap-4 w-full">
        <div class="w-14 h-14 rounded-xl bg-white/25 backdrop-blur flex items-center justify-center overflow-hidden">
          <img id="mp-logo" class="w-full h-full object-contain hidden" src="" alt="" />
          <svg id="mp-icon" class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l8 4v4H4V6l8-4z"/><path d="M4 10h16v10a2 2 0 01-2 2H6a2 2 0 01-2-2V10z"/><line x1="12" y1="6" x2="12" y2="10"/>
          </svg>
        </div>
        <div class="text-white">
          <h1 id="mp-name" class="text-2xl font-bold drop-shadow-md">{slug.toUpperCase()}</h1>
          <p id="mp-desc" class="text-sm text-white/90"></p>
        </div>
      </div>

    </div>

    <!-- Tabs -->
    <div id="mp-tabs" class="flex gap-0 overflow-x-auto border-b border-gray-200 mb-6 -mx-2 px-2">
      {tabs.map((tab) => (
        <button
          type="button"
          data-tab={tab}
          class="mp-tab-btn inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 transition-colors whitespace-nowrap
            ${tab === 'dashboard' ? 'border-accent text-accent' : 'border-transparent text-gray-500 hover:text-gray-700'}"
        >
          {TAB_LABELS[tab] || tab}
        </button>
      ))}
    </div>

    <!-- Content area -->
    <div id="mp-content-area"></div>
  </div>
</div>

<script>
  import { api } from '../../utils/api';
  import { ministeriosStore } from '../../stores/ministerios';
  import { authStore } from '../../stores/auth';
  import { usuariosStore } from '../../stores/usuarios';
  import { showError as toastError, showSuccess as toastSuccess } from '../../utils/toast';

  var slug = '';
  var activeTab = 'dashboard';
  var ministryData = null;
  var dashboardData = null;
  var contentArea = null;

  function formatCurrency(v) {
    return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', minimumFractionDigits: 0 }).format(v);
  }

  function formatDate(d) { return new Date(d).toLocaleDateString('es-PY'); }

  function setupTabs() {
    var tabsEl = document.getElementById('mp-tabs');
    if (!tabsEl) return;
    tabsEl.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-tab]');
      if (!btn) return;
      var tab = btn.dataset.tab;
      if (tab === activeTab) return;
      activeTab = tab;
      document.querySelectorAll('.mp-tab-btn').forEach(function(b) {
        b.className = b.className.replace(/border-accent text-accent/g, '').replace(/border-transparent text-gray-500 hover:text-gray-700/g, '');
        if (b.dataset.tab === tab) {
          b.className += ' border-accent text-accent';
        } else {
          b.className += ' border-transparent text-gray-500 hover:text-gray-700';
        }
      });
      loadTab(tab);
    });
  }

  async function loadTab(tab) {
    try {
      var st;
      switch (tab) {
        case 'dashboard':
          contentArea.innerHTML = renderDashboard();
          break;
        case 'miembros':
          await ministeriosStore.fetchMiembros(slug);
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderMembersTab(st.miembros || []);
          bindMembersForm();
          break;
        case 'caja':
          await ministeriosStore.fetchCaja(slug);
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderFinanceTab(st.caja);
          bindFinanceForm();
          break;
        case 'inventario':
          await ministeriosStore.fetchInventario(slug);
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderInventoryTab(st.inventario || []);
          bindInventoryForm();
          break;
        case 'ofrendas':
          await ministeriosStore.fetchOfrendas(slug);
          var mSlug = ministryData && ministryData.slug || slug;
          if (mSlug === 'dni') {
            await ministeriosStore.fetchOfrendasPorClase(slug);
          }
          if (mSlug === 'mni') {
            await ministeriosStore.fetchOfrendasTotales(slug);
          }
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderOfferingTab(st.ofrendas || [], st.ofrendas_por_clase || [], st.ofrendas_totales || []);
          bindOfferingForm();
          break;
        case 'eventos':
          await ministeriosStore.fetchEventos(slug);
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderEventsTab(st.eventos || []);
          bindEventsForm();
          bindEventsActions();
          break;
        case 'asistencia':
          await ministeriosStore.fetchAsistencia(slug);
          await ministeriosStore.fetchAsistenciaResumen(slug);
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderAttendanceTab(st.asistencia || [], st.asistencia_resumen || []);
          bindAttendanceForm();
          break;
        case 'lecciones':
          await ministeriosStore.fetchLecciones();
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderLessonsTab(st.lecciones || []);
          break;
        case 'canciones':
          await ministeriosStore.fetchCanciones();
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderSongsTab(st.canciones || []);
          bindSongsForm();
          break;
        case 'programas':
          await ministeriosStore.fetchProgramas(slug);
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderProgramsTab(st.programas || []);
          bindProgramsActions();
          break;
        case 'recursos':
          await ministeriosStore.fetchRecursos(slug);
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderResourcesTab(st.recursos || []);
          break;
        case 'ideas':
          await ministeriosStore.fetchIdeas(slug);
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderIdeasTab(st.ideas || []);
          bindIdeasToggle();
          break;
        case 'planificacion':
          await ministeriosStore.fetchPlanificaciones(slug);
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderPlanificacionTab(st.planificaciones || []);
          bindPlanificacionForm();
          break;
        case 'notas':
          await ministeriosStore.fetchNotas(slug);
          st = ministeriosStore.getState();
          contentArea.innerHTML = renderNotasTab(st.notas || []);
          bindNotasForm();
          break;
        case 'enfoques':
          await ministeriosStore.fetchEnfoques(slug);
          contentArea.innerHTML = renderEnfoquesTab();
          break;
        case 'programa':
          await ministeriosStore.fetchProgramasDomingo(slug);
          contentArea.innerHTML = renderProgramaTab();
          bindProgramaForm();
          break;
        case 'cumpleanos':
          await ministeriosStore.fetchCumpleanos(slug);
          contentArea.innerHTML = renderCumpleanosTab();
          break;
        case 'biblias':
          await ministeriosStore.fetchBibliasPorClase(slug);
          contentArea.innerHTML = renderBibliasTab();
          break;
      }
    } catch (e) {
      toastError((e as any).message || 'Error al cargar los datos');
    }
  }

  function renderDashboard() {
    var h = '';
    h += '<div class="space-y-4"><div class="grid grid-cols-2 md:grid-cols-4 gap-4">';
    h += '<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5"><div class="flex items-start justify-between"><div><p class="text-sm text-gray-500 mb-1">Miembros</p><p class="text-2xl font-bold text-primary">' + (dashboardData?.miembros_count ?? 0) + '</p></div><div class="p-2.5 rounded-lg bg-primary/5 text-primary/70"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div></div></div>';
    h += '<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5"><div class="flex items-start justify-between"><div><p class="text-sm text-gray-500 mb-1">Saldo Caja</p><p class="text-2xl font-bold text-green-700">' + formatCurrency(dashboardData?.saldo_caja ?? 0) + '</p></div><div class="p-2.5 rounded-lg bg-green-50 text-green-600"><span class="text-lg">₲</span></div></div></div>';
    h += '<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5"><div class="flex items-start justify-between"><div><p class="text-sm text-gray-500 mb-1">Ofrendas Mes</p><p class="text-2xl font-bold text-amber-700">' + formatCurrency(dashboardData?.ofertas_mes ?? 0) + '</p></div><div class="p-2.5 rounded-lg bg-amber-50 text-amber-600"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div></div></div>';
    h += '<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5"><div class="flex items-start justify-between"><div><p class="text-sm text-gray-500 mb-1">Eventos</p><p class="text-2xl font-bold text-accent">' + (dashboardData?.eventos_proximos?.length ?? 0) + '</p></div><div class="p-2.5 rounded-lg bg-accent/5 text-accent/70"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div></div></div>';
    h += '</div></div>';
    return h;
  }

  // Members tab
  function renderMembersTab(miembros) {
    var h = '';
    var authState = authStore.getState();
    var isAdminOrPastora = authState.user && (authState.user.rol === 'admin' || authState.user.rol === 'pastora');
    h += '<div class="space-y-4"><div class="flex justify-between items-center"><h3 class="font-semibold text-gray-900">Miembros (' + miembros.length + ')</h3><div class="flex gap-2">';
    if (isAdminOrPastora) {
      h += '<button id="members-vincular-btn" class="inline-flex items-center justify-center gap-2 font-medium transition-colors text-gray-600 hover:bg-gray-100 px-3 py-1.5 text-xs rounded-sm cursor-pointer border border-gray-300">Vincular Usuario</button>';
    }
    h += '<button id="members-add-btn" class="inline-flex items-center justify-center gap-2 font-medium transition-colors bg-primary text-white hover:bg-primary-600 shadow-sm px-3 py-1.5 text-xs rounded-sm cursor-pointer">+ Agregar</button></div></div>';
    h += '<div id="members-form" class="hidden"><div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6"><div class="grid grid-cols-1 md:grid-cols-2 gap-4">';
    h += '<div class="flex flex-col gap-1.5"><label class="text-sm font-medium text-gray-700">Primer Nombre</label><input id="mf-nombre" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent bg-white" /></div>';
    h += '<div class="flex flex-col gap-1.5"><label class="text-sm font-medium text-gray-700">Primer Apellido</label><input id="mf-apellido" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent bg-white" /></div>';
    h += '<div class="flex flex-col gap-1.5"><label class="text-sm font-medium text-gray-700">Teléfono</label><input id="mf-telefono" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent bg-white" /></div>';
    h += '<div class="flex flex-col gap-1.5"><label class="text-sm font-medium text-gray-700">Email</label><input id="mf-email" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent bg-white" /></div>';
    h += '<div class="flex flex-col gap-1.5"><label class="text-sm font-medium text-gray-700">Clase</label><select id="mf-clase" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent bg-white"><option value="">Sin clase</option><option value="parvulos">Párvulos (1-5)</option><option value="principiantes">Principiantes (6-10)</option><option value="primarios">Primarios (11-15)</option><option value="jovenes">Jóvenes (16-35)</option><option value="adultos">Adultos (35+)</option></select></div>';
    h += '<div class="flex flex-col gap-1.5"><label class="text-sm font-medium text-gray-700">Rol</label><select id="mf-rol" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent bg-white"><option value="miembro">Miembro</option><option value="lider">Líder</option><option value="sublider">Sublíder</option><option value="tesorero">Tesorero</option><option value="secretario">Secretario</option></select></div>';
    h += '</div><div class="flex gap-2 mt-4"><button id="members-save" class="inline-flex items-center justify-center gap-2 font-medium transition-colors bg-primary text-white hover:bg-primary-600 shadow-sm px-4 py-2 text-sm rounded-md cursor-pointer">Guardar</button><button id="members-cancel" class="inline-flex items-center justify-center gap-2 font-medium transition-colors text-gray-600 hover:bg-gray-100 px-4 py-2 text-sm rounded-md cursor-pointer">Cancelar</button></div></div></div>';
    h += '<div id="members-vincular-form" class="hidden"><div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6"><div class="space-y-4">';
    h += '<p class="text-sm font-medium text-gray-700">Usuarios disponibles</p>';
    h += '<div id="mv-results" class="max-h-48 overflow-y-auto rounded-md border border-gray-200"></div>';
    h += '<div id="mv-selected" class="hidden"><div class="flex items-center gap-3 p-3 bg-accent/5 rounded-md border border-accent/20"><div class="flex-1"><p id="mv-sel-name" class="font-medium text-gray-900"></p><p id="mv-sel-info" class="text-sm text-gray-500"></p></div><button id="mv-clear" class="text-gray-400 hover:text-gray-600">&times;</button></div></div>';
    h += '<div class="grid grid-cols-1 gap-4"><div class="flex flex-col gap-1.5"><label class="text-sm font-medium text-gray-700">Rol en el ministerio</label><select id="mv-rol" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent bg-white"><option value="miembro">Miembro</option><option value="lider">Líder</option><option value="sublider">Sublíder</option><option value="tesorero">Tesorero</option><option value="secretario">Secretario</option></select></div></div>';
    h += '<div class="flex gap-2"><button id="mv-save" class="inline-flex items-center justify-center gap-2 font-medium transition-colors bg-primary text-white hover:bg-primary-600 shadow-sm px-4 py-2 text-sm rounded-md cursor-pointer">Vincular</button><button id="mv-cancel" class="inline-flex items-center justify-center gap-2 font-medium transition-colors text-gray-600 hover:bg-gray-100 px-4 py-2 text-sm rounded-md cursor-pointer">Cancelar</button></div></div></div></div>';
    h += '<div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-gray-200"><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Nombre</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Rol</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Clase</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Teléfono</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Usuario</th><th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Acciones</th></tr></thead><tbody>';
    for (var i = 0; i < miembros.length; i++) {
      var m = miembros[i];
      var userBadge = m.usuario ? '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-accent/10 text-accent"><svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>' + (m.usuario_nombre || '#') + '</span>' : '<span class="text-xs text-gray-400">&mdash;</span>';
      var systemRoleBadge = m.usuario_rol ? '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600 ml-1">' + m.usuario_rol + '</span>' : '';
      h += '<tr class="border-b border-gray-100"><td class="px-4 py-2">' + m.nombre_completo + '</td><td class="px-4 py-2"><span class="capitalize">' + m.rol_en_ministerio + '</span>' + systemRoleBadge + '</td><td class="px-4 py-2 capitalize">' + ((m.clase || '-').replace('_', ' ')) + '</td><td class="px-4 py-2">' + (m.telefono || '-') + '</td><td class="px-4 py-2">' + userBadge + '</td><td class="px-4 py-2"><button data-edit="' + m.id + '" class="text-gray-400 hover:text-primary text-xs cursor-pointer" title="Editar">&#9998;</button><button data-delete="' + m.id + '" data-name="' + m.nombre_completo + '" class="text-gray-400 hover:text-red-500 text-xs ml-2 cursor-pointer" title="Eliminar">&#10005;</button></td></tr>';
    }
    if (miembros.length === 0) h += '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">Sin miembros</td></tr>';
    h += '</tbody></table></div></div>';
    return h;
  }

  function bindMembersForm() {
    var editingMemberId = null;
    var addBtn = document.getElementById('members-add-btn');
    var form = document.getElementById('members-form');
    var saveBtn = document.getElementById('members-save');
    var cancelBtn = document.getElementById('members-cancel');
    if (!addBtn || !form) return;

    addBtn.onclick = function() {
      editingMemberId = null;
      document.getElementById('mf-nombre').value = '';
      document.getElementById('mf-apellido').value = '';
      document.getElementById('mf-telefono').value = '';
      document.getElementById('mf-email').value = '';
      document.getElementById('mf-clase').value = '';
      document.getElementById('mf-rol').value = 'miembro';
      form.classList.toggle('hidden');
    };
    if (cancelBtn) cancelBtn.addEventListener('click', function() {
      editingMemberId = null;
      form.classList.add('hidden');
    });
    if (saveBtn) saveBtn.addEventListener('click', async function() {
      var data = {
        primer_nombre: document.getElementById('mf-nombre').value,
        primer_apellido: document.getElementById('mf-apellido').value,
        telefono: document.getElementById('mf-telefono').value,
        email: document.getElementById('mf-email').value,
        clase: document.getElementById('mf-clase').value,
        rol_en_ministerio: document.getElementById('mf-rol').value,
      };
      if (!data.primer_nombre) { toastError('El campo Nombre es obligatorio'); return; }
      if (!data.primer_apellido) { toastError('El campo Apellido es obligatorio'); return; }
      try {
        if (editingMemberId) {
          await ministeriosStore.updateMiembro(editingMemberId, data);
          toastSuccess('Miembro actualizado exitosamente');
        } else {
          await ministeriosStore.addMiembro(slug, data);
          toastSuccess('Miembro creado exitosamente');
        }
        editingMemberId = null;
        loadTab('miembros');
      } catch (err: any) { toastError(err.message); }
    });

    var reportBtn = document.getElementById('of-reporte-btn');
    var reportCsvBtn = document.getElementById('of-reporte-csv');
    var reportResult = document.getElementById('of-reporte-result');
    if (reportBtn) {
      var catLabelsRpt = { ofrenda_general: 'Ofrenda General', caja_alabastro: 'Caja de Alabastro', accion_gracias: 'Acción de Gracias', dip: 'DIP', oracion_ayuno: 'Oración y Ayuno', fem: 'FEM', otros: 'Otros' };
      reportBtn.addEventListener('click', async function() {
        var inicio = document.getElementById('of-reporte-inicio').value;
        var fin = document.getElementById('of-reporte-fin').value;
        if (!inicio || !fin) { toastError('Seleccioná ambas fechas'); return; }
        try {
          var data = await ministeriosStore.fetchReporteOfrendas(slug, inicio, fin);
          var h = '<div class="bg-gray-50 rounded p-4"><h5 class="font-medium text-gray-900 mb-2">Resultados: ' + inicio + ' a ' + fin + '</h5>';
          h += '<div class="grid grid-cols-2 md:grid-cols-3 gap-3">';
          var cats = data.por_categoria || [];
          for (var ri = 0; ri < cats.length; ri++) {
            var c = cats[ri];
            var cl = catLabelsRpt[c.categoria] || c.categoria;
            h += '<div class="text-center p-3 bg-white rounded border"><p class="text-lg font-bold text-gray-800">' + formatCurrency(c.total) + '</p><p class="text-xs text-gray-500">' + cl + ' (' + c.count + ')</p></div>';
          }
          h += '</div>';
          h += '<div class="mt-2 text-right"><p class="text-sm font-semibold text-gray-700">Total general: ' + formatCurrency(data.total_general) + '</p></div></div>';
          reportResult.innerHTML = h;
          reportCsvBtn.classList.remove('hidden');
