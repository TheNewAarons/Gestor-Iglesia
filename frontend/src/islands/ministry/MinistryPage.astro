  var editingNotaId = null;

  async function loadEventOptions() {
    try {
      var eventos = await api.get('/ministerios/' + slug + '/eventos/');
      var select = document.getElementById('nota-evento');
      if (!select) return;
      for (var i = 0; i < eventos.length; i++) {
        var opt = document.createElement('option');
        opt.value = String(eventos[i].id);
        opt.textContent = eventos[i].titulo + ' (' + formatDate((eventos[i].fecha_inicio || '').substring(0, 10)) + ')';
        select.appendChild(opt);
      }
      return eventos;
    } catch (e) {
      // silently fail
    }
  }

  function resetNotaForm() {
    editingNotaId = null;
    var f = document.getElementById('nota-form');
    if (!f) return;
    var titulo = document.getElementById('nota-titulo');
    var contenido = document.getElementById('nota-contenido');
    var evento = document.getElementById('nota-evento');
    var formTitle = document.getElementById('nota-form-title');
    var saveBtn = document.getElementById('nota-save-btn');
    if (titulo) titulo.value = '';
    if (contenido) contenido.value = '';
    if (evento) evento.value = '';
    if (formTitle) formTitle.textContent = 'Nueva nota';
    if (saveBtn) saveBtn.textContent = 'Guardar';
    f.dataset.selectedColor = '#fef3c7';
    var colorBtns = document.querySelectorAll('#nota-color-picker button');
    colorBtns.forEach(function(b, idx) {
      b.style.borderColor = idx === 0 ? '#6366f1' : 'transparent';
    });
