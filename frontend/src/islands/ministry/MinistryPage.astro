  function openImageModal(src, caption) {
    var modal = document.getElementById('image-modal');
    var img = document.getElementById('image-modal-img');
    var cap = document.getElementById('image-modal-caption');
    if (modal && img) {
      img.src = src;
      if (cap) cap.textContent = caption || '';
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function closeImageModal() {
    var modal = document.getElementById('image-modal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  window.openImageModal = openImageModal;
  window.closeImageModal = closeImageModal;

  function bindInventoryForm() {
    var addBtn = document.getElementById('inv-add-btn');
    var form = document.getElementById('inv-form');
    var saveBtn = document.getElementById('inv-save');
    var cancelBtn = document.getElementById('inv-cancel');
    if (!addBtn || !form) return;

    var editingItemId = null;

    function resetInventarioForm() {
      editingItemId = null;
      document.getElementById('if-nombre').value = '';
      document.getElementById('if-cat').value = 'muebles';
      document.getElementById('if-cantidad').value = '1';
      document.getElementById('if-estado').value = 'bueno';
      document.getElementById('if-imagen').value = '';
      var curImg = document.getElementById('if-current-img');
      if (curImg) curImg.innerHTML = '';
      saveBtn.textContent = 'Guardar';
    }

    addBtn.onclick = function() {
      var isHidden = form.classList.contains('hidden');
      form.classList.toggle('hidden');
      if (!isHidden) resetInventarioForm();
    };

    if (cancelBtn) cancelBtn.addEventListener('click', function() {
      form.classList.add('hidden');
      resetInventarioForm();
    });

    // Edit handler via event delegation
    var invTable = form.closest('.space-y-4');
    if (invTable) {
      invTable.addEventListener('click', function(e) {
        var editBtn = e.target.closest('[data-inv-edit]');
        if (editBtn) {
          var id = parseInt(editBtn.getAttribute('data-inv-edit'));
          var item = ministeriosStore.state.inventario.find(function(it) { return it.id === id; });
          if (item) {
            editingItemId = item.id;
            document.getElementById('if-nombre').value = item.nombre || '';
            document.getElementById('if-cat').value = item.categoria || 'muebles';
            document.getElementById('if-cantidad').value = item.cantidad || 1;
            document.getElementById('if-estado').value = item.estado || 'bueno';
            document.getElementById('if-imagen').value = '';
            var curImg = document.getElementById('if-current-img');
            if (curImg) {
              curImg.innerHTML = item.imagen ? '<div class="flex items-center gap-2 text-xs text-gray-500 mt-1"><span>Actual:</span><img src="' + item.imagen + '" class="w-12 h-12 rounded object-cover" /></div>' : '';
            }
            saveBtn.textContent = 'Actualizar';
            form.classList.remove('hidden');
          }
        }
        var delBtn = e.target.closest('[data-inv-delete]');
        if (delBtn) {
          var id = parseInt(delBtn.getAttribute('data-inv-delete'));
          var item = ministeriosStore.state.inventario.find(function(it) { return it.id === id; });
          if (item && confirm('¿Eliminar "' + item.nombre + '"?')) {
            ministeriosStore.deleteInventarioItem(slug, id).then(function() {
              toastSuccess('Item eliminado');
              loadTab('inventario');
            }).catch(function(err) { toastError(err.message); });
          }
        }
      });
    }

    if (saveBtn) saveBtn.addEventListener('click', async function() {
      var nombre = document.getElementById('if-nombre').value;
      if (!nombre) { toastError('El campo Nombre es obligatorio'); return; }
      var imagenInput = document.getElementById('if-imagen');
      var file = imagenInput && imagenInput.files && imagenInput.files.length > 0 ? imagenInput.files[0] : null;

      try {
        if (editingItemId) {
          if (file) {
            var formData = new FormData();
            formData.append('nombre', nombre);
            formData.append('categoria', document.getElementById('if-cat').value);
            formData.append('cantidad', document.getElementById('if-cantidad').value);
            formData.append('estado', document.getElementById('if-estado').value);
            formData.append('imagen', file);
            await ministeriosStore.updateInventarioItem(slug, editingItemId, formData);
          } else {
            await ministeriosStore.updateInventarioItem(slug, editingItemId, {
              nombre: nombre,
              categoria: document.getElementById('if-cat').value,
              cantidad: parseInt(document.getElementById('if-cantidad').value),
              estado: document.getElementById('if-estado').value,
            });
          }
          toastSuccess('Item actualizado exitosamente');
        } else {
          if (file) {
            var formData = new FormData();
            formData.append('nombre', nombre);
            formData.append('categoria', document.getElementById('if-cat').value);
            formData.append('cantidad', document.getElementById('if-cantidad').value);
            formData.append('estado', document.getElementById('if-estado').value);
            formData.append('imagen', file);
            await ministeriosStore.addInventarioItem(slug, formData);
          } else {
            await ministeriosStore.addInventarioItem(slug, {
              nombre: nombre,
              categoria: document.getElementById('if-cat').value,
              cantidad: parseInt(document.getElementById('if-cantidad').value),
              estado: document.getElementById('if-estado').value,
            });
          }
          toastSuccess('Item agregado exitosamente');
        }
        form.classList.add('hidden');
        resetInventarioForm();
        loadTab('inventario');
      } catch (err: any) { toastError(err.message); }
    });
  }

