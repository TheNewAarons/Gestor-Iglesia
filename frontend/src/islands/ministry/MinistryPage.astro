  async function registrarAttendance() {
    var fechaInput = document.getElementById('asist-fecha');
    var fecha = fechaInput ? fechaInput.value : '';
    if (!fecha) { toastError('Selecciona una fecha'); return; }
    var registros = [];
    var presentCheckboxes = document.querySelectorAll('.asist-presente');
    var bibliaCheckboxes = document.querySelectorAll('.asist-biblia');
    var bibliaMap = {};
    bibliaCheckboxes.forEach(function(cb) { bibliaMap[parseInt(cb.dataset.miembro)] = cb.checked; });
    presentCheckboxes.forEach(function(cb) {
      registros.push({
        miembro: parseInt(cb.dataset.miembro),
        presente: cb.checked,
        tiene_biblia: bibliaMap[parseInt(cb.dataset.miembro)] || false,
        fecha: fecha
      });
    });
    for (var j = 0; j < asistVisitas.length; j++) {
      registros.push({
        es_visita: true,
        nombre_visita: asistVisitas[j].nombre,
        clase: asistVisitas[j].clase,
        presente: true,
        tiene_biblia: false,
        fecha: fecha
      });
    }
    var statusEl = document.getElementById('asist-status');
    if (statusEl) statusEl.textContent = 'Registrando ' + registros.length + ' asistencias...';
    try {
      for (var k = 0; k < registros.length; k++) {
        await ministeriosStore.addAsistencia(slug, registros[k]);
      }
      asistVisitas = [];
      await loadTab('asistencia');
      toastSuccess('Asistencia registrada');
    } catch (e) {
      toastError(e.message || 'Error al registrar asistencia');
    }
  }

