        if (!fecha) { toastError('Selecciona una fecha'); return; }
        var statusEl = document.getElementById('prog-gen-status');
        if (statusEl) statusEl.textContent = 'Generando programa...';
        try {
          await ministeriosStore.generarPrograma(fecha, slug);
          await loadTab('programas');
          toastSuccess('Programa generado');
        } catch (e) {
          toastError(e.message || 'Error al generar programa');
