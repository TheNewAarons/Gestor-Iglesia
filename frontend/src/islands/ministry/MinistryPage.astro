    var MESES = ['', 'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    var h = '<div class="space-y-6">';

    if (actual) {
      h += '<div class="bg-gradient-to-r from-primary/10 to-primary/5 rounded-xl border border-primary/20 p-6">';
      h += '<div class="flex items-center gap-2 mb-2"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary/20 text-primary">' + (MESES[actual.mes] || actual.mes) + '</span><span class="text-xs text-gray-500">Enfoque del mes actual</span></div>';
      h += '<h3 class="text-xl font-bold text-gray-900 mb-2">' + actual.titulo + '</h3>';
      h += '<p class="text-gray-600">' + (actual.descripcion || '') + '</p>';
      h += '</div>';
    }

    h += '<div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">';
    h += '<table class="w-full text-sm"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Mes</th><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Enfoque</th><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Descripcion</th></tr></thead><tbody>';

    for (var i = 0; i < enfoques.length; i++) {
      var ef = enfoques[i];
      var isCurrent = ef.mes === mesActual;
      var rowClass = isCurrent ? 'bg-primary/5 font-medium' : '';
      h += '<tr class="border-b border-gray-100 hover:bg-gray-50 ' + rowClass + '">';
      h += '<td class="px-4 py-3"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ' + (isCurrent ? 'bg-primary text-white' : 'bg-gray-100 text-gray-700') + '">' + (MESES[ef.mes] || ef.mes) + '</span></td>';
      h += '<td class="px-4 py-3">' + ef.titulo + '</td>';
      h += '<td class="px-4 py-3 text-gray-500">' + (ef.descripcion || '—') + '</td>';
      h += '</tr>';
    }

    h += '</tbody></table></div></div>';
    return h;
  }

  function renderProgramaTab() {
    var st = ministeriosStore.getState();
    var programas = st.programas_domingo || [];
    var h = '<div class="space-y-4">';

    h += '<div class="flex justify-end mb-4">';
    h += '<button id="prog-toggle-form-btn" class="inline-flex items-center justify-center gap-2 font-medium transition-colors bg-primary text-white hover:bg-primary-600 shadow-sm px-3 py-1.5 text-xs rounded-sm cursor-pointer">';
    h += '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>';
    h += 'Nuevo programa</button>';
    h += '</div>';

    h += '<div id="prog-form" class="hidden bg-white rounded-lg shadow-sm border border-gray-100 p-6 mb-4">';
    h += '<h4 class="font-medium text-gray-900 mb-4" id="prog-form-title">Nuevo programa</h4>';
    h += '<div class="space-y-3">';
    h += '<div><label class="block text-sm font-medium text-gray-700 mb-1">Titulo *</label><input id="prog-titulo" type="text" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="Titulo del programa"></div>';
    h += '<div><label class="block text-sm font-medium text-gray-700 mb-1">Fecha *</label><input id="prog-fecha" type="date" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm"></div>';
    h += '<div class="border-t border-gray-200 py-3"><p class="text-sm font-medium text-gray-900 mb-3">Secciones del programa</p>';
    var seccionesLabels = { inicio: 'Inicio', especiales: 'Especiales', reflexion: 'Reflexion', ofrenda: 'Ofrenda', cierre: 'Cierre' };
    var seccionesKeys = ['inicio', 'especiales', 'reflexion', 'ofrenda', 'cierre'];
    for (var si = 0; si < seccionesKeys.length; si++) {
      var sk = seccionesKeys[si];
      h += '<div class="mb-2"><label class="block text-xs font-medium text-gray-600 mb-1">' + seccionesLabels[sk] + '</label><textarea id="prog-seccion-' + sk + '" rows="2" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="Descripcion..."></textarea></div>';
    }
    h += '</div>';
    h += '<div class="flex gap-2 pt-2">';
    h += '<button id="prog-save-btn" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white hover:opacity-90 cursor-pointer">Guardar</button>';
    h += '<button id="prog-cancel-btn" class="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 cursor-pointer">Cancelar</button>';
    h += '</div></div></div>';

    h += '<div id="programas-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">';
    if (!programas || programas.length === 0) {
      h += '<p class="text-gray-500 text-center py-8 col-span-full">No hay programas creados aun.</p>';
    }
    for (var pi = 0; pi < programas.length; pi++) {
      var p = programas[pi];
      var sec = p.secciones || {};
      var secList = '';
      for (var ski = 0; ski < seccionesKeys.length; ski++) {
        var key = seccionesKeys[ski];
        var labelKey = seccionesLabels[key] || key;
        secList += '<p class="text-xs text-gray-500"><strong>' + labelKey + ':</strong> ' + (sec[key] || '') + '</p>';
      }
      h += '<div class="prog-card bg-white rounded-lg shadow-sm border border-gray-100 p-5 flex flex-col gap-2">';
      h += '<div class="flex justify-between items-start">';
      h += '<div><h4 class="font-semibold text-gray-900 text-sm">' + p.titulo + '</h4><span class="text-xs text-gray-400">' + formatDate(p.fecha) + '</span></div>';
      h += '<div class="flex gap-1">';
      h += '<button data-edit-prog="' + p.id + '" class="text-gray-400 hover:text-gray-600 cursor-pointer p-1" title="Editar"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>';
      h += '<button data-delete-prog="' + p.id + '" class="text-gray-400 hover:text-red-500 cursor-pointer p-1" title="Eliminar"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>';
      h += '</div></div>';
      h += '<div class="space-y-0.5 mt-2">' + secList + '</div>';
      if (p.creado_por_nombre) {
        h += '<div class="text-xs text-gray-400 mt-auto pt-2">Creado por: ' + p.creado_por_nombre + '</div>';
      }
      h += '</div>';
    }
    h += '</div></div>';
    return h;
  }

  var editingProgId = null;

  function bindProgramaForm() {
    var form = document.getElementById('prog-form');
    var toggleBtn = document.getElementById('prog-toggle-form-btn');
    var saveBtn = document.getElementById('prog-save-btn');
    var cancelBtn = document.getElementById('prog-cancel-btn');
    var titleInput = document.getElementById('prog-titulo');
    var dateInput = document.getElementById('prog-fecha');
    var title = document.getElementById('prog-form-title');

    if (!form || !toggleBtn) return;

    toggleBtn.onclick = function() {
      editingProgId = null;
      title.textContent = 'Nuevo programa';
      if (titleInput) titleInput.value = '';
      if (dateInput) dateInput.value = '';
      ['inicio', 'especiales', 'reflexion', 'ofrenda', 'cierre'].forEach(function(k) {
        var el = document.getElementById('prog-seccion-' + k);
        if (el) el.value = '';
      });
      form.classList.remove('hidden');
      form.scrollIntoView({ behavior: 'smooth' });
    };

    cancelBtn.onclick = function() {
      form.classList.add('hidden');
      editingProgId = null;
    };

    saveBtn.onclick = async function() {
      var titulo = titleInput ? titleInput.value.trim() : '';
      var fecha = dateInput ? dateInput.value : '';
      if (!titulo || !fecha) {
        toastError('Titulo y fecha son requeridos');
        return;
      }
      var secciones = {};
      ['inicio', 'especiales', 'reflexion', 'ofrenda', 'cierre'].forEach(function(k) {
        var el = document.getElementById('prog-seccion-' + k);
        if (el) secciones[k] = el.value;
      });
      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando...';
      try {
        if (editingProgId) {
          await ministeriosStore.updateProgramaDomingo(slug, editingProgId, { titulo: titulo, fecha: fecha, secciones: secciones });
        } else {
          await ministeriosStore.addProgramaDomingo(slug, { titulo: titulo, fecha: fecha, secciones: secciones });
        }
        editingProgId = null;
        if (titleInput) titleInput.value = '';
        if (dateInput) dateInput.value = '';
        form.classList.add('hidden');
        await loadTab('programa');
      } catch (e) {
        toastError(e.message);
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = editingProgId ? 'Actualizar' : 'Guardar';
      }
    };

    document.querySelectorAll('[data-edit-prog]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var id = parseInt(btn.dataset.editProg);
        var st = ministeriosStore.getState();
        var prog = st.programas_domingo.find(function(p) { return p.id === id; });
        if (!prog) return;
        editingProgId = id;
        if (title) title.textContent = 'Editar programa';
        if (titleInput) titleInput.value = prog.titulo;
        if (dateInput) dateInput.value = prog.fecha;
        ['inicio', 'especiales', 'reflexion', 'ofrenda', 'cierre'].forEach(function(k) {
          var el = document.getElementById('prog-seccion-' + k);
          if (el) el.value = (prog.secciones && prog.secciones[k]) || '';
        });
        form.classList.remove('hidden');
        form.scrollIntoView({ behavior: 'smooth' });
      });
    });

    document.querySelectorAll('[data-delete-prog]').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        if (!confirm('Eliminar este programa?')) return;
        var id = parseInt(btn.dataset.deleteProg);
        try {
          await ministeriosStore.deleteProgramaDomingo(slug, id);
          await loadTab('programa');
        } catch (e) {
          toastError(e.message);
        }
      });
    });
  }

